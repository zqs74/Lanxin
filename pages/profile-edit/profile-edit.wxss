/* profile-edit.wxss - 昇梦体育 主题适配 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 20rpx 30rpx 120rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-top: 20rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  transition: all 0.3s ease;
}

.back-btn:hover {
  transform: translateX(-4rpx);
}

.back-icon {
  font-size: 36rpx;
  color: var(--gold);
  font-weight: bold;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.nav-placeholder {
  width: 72rpx;
}

.form-container {
  flex: 1;
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
  display: inline-block;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%);
  border-radius: 3rpx;
}

.avatar-section {
  padding: 32rpx;
}

.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(212,175,55,0.3);
  transition: all 0.3s ease;
}

.avatar-emoji {
  font-size: 72rpx;
}

.avatar:hover {
  transform: scale(1.05);
  box-shadow: 0 12rpx 32rpx rgba(212,175,55,0.4);
}

.upload-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 32rpx;
}

.upload-text {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
}

.form-card {
  padding: 8rpx;
}

.form-item {
  padding: 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.form-item:hover {
  background: rgba(212,175,55,0.03);
}

.form-item + .form-item {
  border-top: 1rpx solid var(--border-superlight);
}

.label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.label-icon {
  font-size: 28rpx;
}

.input {
  width: 100%;
  padding: 32rpx 28rpx;
  background: var(--bg-input-form);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid var(--border-input);
  border-radius: 20rpx;
  font-size: 32rpx;
  color: var(--text-content);
  transition: all 0.3s ease;
  box-sizing: border-box;
  line-height: 1.5;
  min-height: 96rpx;
}

.input:focus {
  border-color: var(--border-input-focus);
  background: var(--bg-input-form-focus);
  box-shadow: 0 0 0 4rpx rgba(212,175,55,0.15);
}

.input-placeholder {
  color: var(--text-placeholder);
}

.picker-wrapper {
  width: 100%;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  background: var(--bg-input-form);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid var(--border-input);
  border-radius: 20rpx;
  transition: all 0.3s ease;
  min-height: 96rpx;
}

.picker-content:hover {
  border-color: var(--border-input-focus);
  background: var(--bg-input-form-focus);
}

.picker-text {
  font-size: 32rpx;
  color: var(--text-content);
}

.picker-arrow {
  font-size: 36rpx;
  color: var(--gold);
  font-weight: 300;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 32rpx 28rpx;
  background: var(--bg-input-form);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid var(--border-input);
  border-radius: 20rpx;
  font-size: 32rpx;
  color: var(--text-content);
  transition: all 0.3s ease;
  box-sizing: border-box;
  line-height: 1.6;
}

.textarea:focus {
  border-color: var(--border-input-focus);
  background: var(--bg-input-form-focus);
  box-shadow: 0 0 0 4rpx rgba(212,175,55,0.15);
}

.textarea-placeholder {
  color: var(--text-placeholder);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  font-weight: 500;
}

.save-section {
  margin-top: 40rpx;
}

.save-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 32rpx;
}
