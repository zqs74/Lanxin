/* profile-edit.wxss - 现代化UI设计 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: var(--spacing-md) var(--spacing-md) 120rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* 顶部导航栏 */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
  padding-top: var(--spacing-md);
  animation: fadeIn 0.6s ease-out;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.1) 100%);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.back-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%);
  transform: rotate(45deg);
  animation: shine 3s infinite;
}

.back-btn:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(68, 206, 255, 0.2);
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.15) 0%, rgba(89, 168, 255, 0.15) 100%);
}

.back-btn:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.2) 0%, rgba(89, 168, 255, 0.2) 100%);
}

.back-icon {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: bold;
  position: relative;
  z-index: 1;
}

.nav-title {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--text-primary);
  position: relative;
  display: inline-block;
}

.nav-title::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 2rpx;
  animation: slideIn 0.8s ease-out 0.3s both;
}

.nav-placeholder {
  width: 72rpx;
}

.form-container {
  flex: 1;
}

/* 通用section样式 */
.section {
  margin-bottom: var(--spacing-lg);
  animation: slideUp 0.5s var(--transition-normal);
}

.section:nth-child(2) {
  animation-delay: 0.1s;
}

.section:nth-child(3) {
  animation-delay: 0.2s;
}

.section:nth-child(4) {
  animation-delay: 0.3s;
}

.section-header {
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
  display: inline-block;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 3rpx;
}

/* 头像部分 */
.avatar-section {
  padding: var(--spacing-lg);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--border-radius-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.avatar-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.05) 0%, rgba(89, 168, 255, 0.03) 100%);
  pointer-events: none;
}

.avatar-section::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.avatar-section:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-medium);
}

.avatar-section:hover::after {
  transform: scaleX(1);
}

.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  position: relative;
  z-index: 1;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(68, 206, 255, 0.4);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.avatar::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%);
  transform: rotate(45deg);
  animation: shine 3s infinite;
}

.avatar-emoji {
  font-size: 72rpx;
  position: relative;
  z-index: 1;
}

.avatar:hover {
  transform: scale(1.05);
  box-shadow: 0 12rpx 32rpx rgba(68, 206, 255, 0.5);
}

.upload-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  z-index: 1;
}

.upload-icon {
  font-size: 32rpx;
  color: var(--primary-color);
  transition: all var(--transition-normal);
}

.avatar:hover .upload-icon {
  transform: scale(1.1);
}

.upload-text {
  font-size: var(--font-sm);
  color: var(--primary-color);
  font-weight: 600;
  transition: all var(--transition-normal);
}

.avatar:hover .upload-text {
  transform: translateY(-2rpx);
}

/* 表单卡片 */
.form-card {
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--border-radius-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.form-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.02) 0%, rgba(89, 168, 255, 0.01) 100%);
  pointer-events: none;
}

.form-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.form-card:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-medium);
}

.form-card:hover::after {
  transform: scaleX(1);
}

.form-item {
  padding: 20rpx;
  border-radius: var(--border-radius-md);
  transition: all var(--transition-normal);
  position: relative;
  z-index: 1;
  margin-bottom: 8rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-item:hover {
  background: rgba(68, 206, 255, 0.05);
  transform: translateX(4rpx);
}

.label {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: var(--spacing-sm);
  display: flex;
  align-items: center;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}

.label-icon {
  font-size: var(--font-md);
  color: var(--primary-color);
}

.input {
  width: 100%;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: var(--border-radius-md);
  font-size: var(--font-md);
  color: var(--text-primary);
  transition: all var(--transition-normal);
  box-sizing: border-box;
  line-height: 1.5;
  min-height: 96rpx;
  position: relative;
  overflow: hidden;
}

.input:focus {
  border-color: var(--primary-color);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 6rpx rgba(68, 206, 255, 0.15);
}

.input-placeholder {
  color: var(--text-tertiary);
}

/* 选择器 */
.picker-wrapper {
  width: 100%;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: var(--border-radius-md);
  transition: all var(--transition-normal);
  min-height: 96rpx;
  position: relative;
  overflow: hidden;
}

.picker-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.picker-content:hover {
  border-color: var(--primary-color);
  background: rgba(255, 255, 255, 1);
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.15);
}

.picker-content:hover::before {
  transform: scaleX(1);
}

.picker-text {
  font-size: var(--font-md);
  color: var(--text-primary);
  position: relative;
  z-index: 1;
}

.picker-arrow {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: 300;
  transition: all var(--transition-normal);
  position: relative;
  z-index: 1;
}

.picker-content:hover .picker-arrow {
  transform: translateX(4rpx);
}

/* 多行文本 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: var(--border-radius-md);
  font-size: var(--font-md);
  color: var(--text-primary);
  transition: all var(--transition-normal);
  box-sizing: border-box;
  line-height: 1.6;
  position: relative;
  overflow: hidden;
}

.textarea:focus {
  border-color: var(--primary-color);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 6rpx rgba(68, 206, 255, 0.15);
}

.textarea-placeholder {
  color: var(--text-tertiary);
}

.char-count {
  text-align: right;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-top: 8rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* 保存按钮 */
.save-section {
  margin-top: var(--spacing-xl);
  animation: slideUp 0.5s var(--transition-normal) 0.4s both;
}

.save-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
}

.save-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%);
  transform: rotate(45deg);
  animation: shine 3s infinite;
}

.btn-icon {
  font-size: 32rpx;
  position: relative;
  z-index: 1;
}

/* 动画效果 */
@keyframes slideIn {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(0);
  }
}

@keyframes shine {
  0% {
    transform: translateX(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) rotate(45deg);
  }
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: var(--spacing-sm) var(--spacing-sm) 100rpx;
  }
  
  .avatar {
    width: 140rpx;
    height: 140rpx;
  }
  
  .avatar-emoji {
    font-size: 64rpx;
  }
  
  .input,
  .textarea,
  .picker-content {
    padding: 24rpx 20rpx;
    min-height: 80rpx;
  }
}
