/* profile-edit.wxss - 现代化UI设计 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 20rpx 30rpx 120rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* 顶部导航栏 */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-top: 20rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.1) 100%);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  transition: all 0.3s ease;
}

.back-icon {
  font-size: 36rpx;
  color: #44ceff;
  font-weight: bold;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a1a;
}

.nav-placeholder {
  width: 72rpx;
}

.form-container {
  flex: 1;
}

/* 通用section样式 */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  position: relative;
  display: inline-block;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #44ceff 0%, #59a8ff 100%);
  border-radius: 3rpx;
}

/* 头像部分 */
.avatar-section {
  padding: 32rpx;
}

.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(68, 206, 255, 0.3);
  transition: all 0.3s ease;
}

.avatar-emoji {
  font-size: 72rpx;
}

.avatar:hover {
  transform: scale(1.05);
  box-shadow: 0 12rpx 32rpx rgba(68, 206, 255, 0.4);
}

.upload-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 32rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #44ceff;
  font-weight: 600;
}

/* 表单卡片 */
.form-card {
  padding: 8rpx;
}

.form-item {
  padding: 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.form-item:hover {
  background: rgba(68, 206, 255, 0.03);
}

.form-item + .form-item {
  border-top: 1rpx solid rgba(68, 206, 255, 0.08);
}

.label {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.label-icon {
  font-size: 28rpx;
}

.input {
  width: 100%;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: 20rpx;
  font-size: 32rpx;
  color: #1a1a1a;
  transition: all 0.3s ease;
  box-sizing: border-box;
  line-height: 1.5;
  min-height: 96rpx;
}

.input:focus {
  border-color: #44ceff;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 4rpx rgba(68, 206, 255, 0.15);
}

.input-placeholder {
  color: #aaa;
}

/* 选择器 */
.picker-wrapper {
  width: 100%;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: 20rpx;
  transition: all 0.3s ease;
  min-height: 96rpx;
}

.picker-content:hover {
  border-color: #44ceff;
  background: rgba(255, 255, 255, 1);
}

.picker-text {
  font-size: 32rpx;
  color: #1a1a1a;
}

.picker-arrow {
  font-size: 36rpx;
  color: #44ceff;
  font-weight: 300;
}

/* 多行文本 */
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: 20rpx;
  font-size: 32rpx;
  color: #1a1a1a;
  transition: all 0.3s ease;
  box-sizing: border-box;
  line-height: 1.6;
}

.textarea:focus {
  border-color: #44ceff;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 4rpx rgba(68, 206, 255, 0.15);
}

.textarea-placeholder {
  color: #aaa;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  font-weight: 500;
}

/* 保存按钮 */
.save-section {
  margin-top: 40rpx;
}

.save-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 32rpx;
}
