/* profile-edit.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e0e0e0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.back-button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.back-button text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.save-button {
  padding: 12rpx 30rpx;
  background-color: #44ceff;
  border-radius: 12rpx;
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.4);
}

.save-button:hover {
  background-color: #34bfff;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(68, 206, 255, 0.5);
}

.form-container {
  flex: 1;
  padding: 30rpx 20rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.input {
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #333;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.input:focus {
  border-color: #44ceff;
  box-shadow: 0 0 0 2rpx rgba(68, 206, 255, 0.2);
}

.picker {
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  background-color: #ffffff;
  color: #333;
  font-size: 28rpx;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.picker:hover {
  border-color: #44ceff;
  box-shadow: 0 0 0 2rpx rgba(68, 206, 255, 0.2);
}

.picker-content {
  color: #333;
}

.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  border: 2rpx solid #e0e0e0;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.avatar:hover {
  border-color: #44ceff;
  box-shadow: 0 0 0 2rpx rgba(68, 206, 255, 0.2);
  transform: scale(1.05);
}

.upload-text {
  font-size: 24rpx;
  color: #44ceff;
  cursor: pointer;
  transition: all 0.3s ease;
}

.upload-text:hover {
  transform: translateY(-2rpx);
}
