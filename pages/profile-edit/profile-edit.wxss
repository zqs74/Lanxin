/* profile-edit.wxss */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 48rpx 28rpx 120rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.nav-placeholder {
  width: 72rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 44rpx;
  height: 4rpx;
  background: var(--gold);
  border-radius: 2rpx;
}

.profile-editor-card {
  padding: 26rpx;
  margin-bottom: 34rpx;
}

.avatar-upload {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

/* 微信头像选择器按钮：方形本体，内部只放头像图 */
.avatar-pick-btn {
  width: 112rpx;
  height: 112rpx;
  min-width: 112rpx;
  margin: 0;
  padding: 0;
  border-radius: 26rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e9c766 0%, #d4af37 55%, #b8952c 100%);
  box-shadow: var(--shadow-avatar);
  line-height: 1;
}

.avatar-pick-btn::after {
  border: none;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: var(--shadow-avatar);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-copy {
  flex: 1;
}

.avatar-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.avatar-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.form-card {
  padding: 6rpx;
}

.form-row {
  padding: 22rpx;
}

.form-row + .form-row {
  border-top: 1rpx solid var(--border-lighter);
}

.label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 700;
  margin-bottom: 14rpx;
}

.label.compact {
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  min-height: 82rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--bg-input-form);
  border: 1.5rpx solid var(--border-input);
  border-radius: 18rpx;
  font-size: 28rpx;
  color: var(--text-content);
}

.input-placeholder,
.placeholder-text {
  color: var(--text-placeholder);
}

.picker-wrapper {
  width: 100%;
}

.picker-content {
  min-height: 82rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-input-form);
  border: 1.5rpx solid var(--border-input);
  border-radius: 18rpx;
}

.picker-text {
  font-size: 28rpx;
  color: var(--text-content);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.metric-item {
  padding: 22rpx;
}

.metric-item.full {
  grid-column: span 2;
}

.metric-input {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.compact-input {
  min-height: 76rpx;
  text-align: left;
}

.unit {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 700;
  min-width: 44rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--bg-input-form);
  border: 1.5rpx solid var(--border-input);
  border-radius: 18rpx;
  font-size: 28rpx;
  color: var(--text-content);
  line-height: 1.6;
}

.textarea-placeholder {
  color: var(--text-placeholder);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 8rpx 6rpx 2rpx;
}

.save-section {
  margin-top: 36rpx;
}

.save-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
