<!-- profile-edit.wxml -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>

  <view class="container slide-up">
    <view class="top-nav">
      <view class="page-back-btn" bindtap="goBack">
        <t-icon name="chevron-left" size="42rpx" color="#D4AF37" />
      </view>
      <view class="nav-title">完善个人资料</view>
      <view class="nav-placeholder"></view>
    </view>

    <view class="profile-editor-card card">
      <view class="avatar-upload">
        <button class="avatar-pick-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"></image>
          <t-icon wx:else name="user" size="56rpx" color="#0a0a0a" />
        </button>
        <view class="avatar-copy" bindtap="uploadAvatar">
          <view class="avatar-title">个人头像</view>
          <view class="avatar-subtitle">点左侧用微信头像 · 点这里从相册选</view>
        </view>
        <t-icon name="camera" size="34rpx" color="#D4AF37" bindtap="uploadAvatar" />
      </view>
    </view>

    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="form-card card">
        <view class="form-row">
          <view class="label">
            <t-icon name="user" size="28rpx" color="#D4AF37" />
            <text>姓名</text>
          </view>
          <input placeholder="请输入姓名" class="input" value="{{ profile.name }}" bindinput="onNameChange" bindnickname="onNameChange" placeholder-class="input-placeholder"></input>
        </view>

        <view class="form-row">
          <view class="label">
            <t-icon name="chart-radar" size="28rpx" color="#D4AF37" />
            <text>场上位置</text>
          </view>
          <picker bindchange="onPositionChange" value="{{ positionIndex }}" range="{{ positions }}" class="picker-wrapper">
            <view class="picker-content">
              <text class="picker-text {{ profile.position ? '' : 'placeholder-text' }}">{{ profile.position || '请选择位置' }}</text>
              <t-icon name="chevron-right" size="28rpx" color="#D4AF37" />
            </view>
          </picker>
        </view>

        <view class="form-row">
          <view class="label">
            <t-icon name="calendar" size="28rpx" color="#D4AF37" />
            <text>年龄</text>
          </view>
          <input placeholder="请输入年龄" class="input" value="{{ profile.age }}" bindinput="onAgeChange" type="number" placeholder-class="input-placeholder"></input>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">身体数据</view>
      <view class="metric-grid">
        <view class="metric-item card">
          <view class="label compact">
            <t-icon name="ruler" size="28rpx" color="#D4AF37" />
            <text>身高</text>
          </view>
          <view class="metric-input">
            <input placeholder="0" class="input compact-input" value="{{ profile.height }}" bindinput="onHeightChange" type="number" placeholder-class="input-placeholder"></input>
            <text class="unit">cm</text>
          </view>
        </view>
        <view class="metric-item card">
          <view class="label compact">
            <t-icon name="chart-radar" size="28rpx" color="#D4AF37" />
            <text>体重</text>
          </view>
          <view class="metric-input">
            <input placeholder="0" class="input compact-input" value="{{ profile.weight }}" bindinput="onWeightChange" type="number" placeholder-class="input-placeholder"></input>
            <text class="unit">kg</text>
          </view>
        </view>
        <view class="metric-item card full">
          <view class="label compact">
            <t-icon name="time" size="28rpx" color="#D4AF37" />
            <text>球龄</text>
          </view>
          <view class="metric-input">
            <input placeholder="0" class="input compact-input" value="{{ profile.yearsOfPlay }}" bindinput="onYearsOfPlayChange" type="number" placeholder-class="input-placeholder"></input>
            <text class="unit">年</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">技术特点</view>
      <view class="form-card card">
        <textarea
          placeholder="例如：三分稳定、突破速度快、防守积极"
          class="textarea"
          value="{{ profile.skillFeature }}"
          bindinput="onSkillFeatureChange"
          placeholder-class="textarea-placeholder"
          maxlength="200"
        ></textarea>
        <view class="char-count">{{profile.skillFeature ? profile.skillFeature.length : 0}}/200</view>
      </view>
    </view>

    <view class="save-section">
      <button class="btn btn-primary btn-large save-btn" bindtap="saveProfile">
        <t-icon name="check" size="30rpx" color="#0a0a0a" />
        保存资料
      </button>
    </view>
  </view>
</view>
