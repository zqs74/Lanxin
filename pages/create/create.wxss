/* create.wxss - 昇梦体育 主题适配 */
.page-wrapper { position: relative; min-height: 100vh; }
.container { padding: 48rpx 30rpx 100rpx; min-height: 100vh; position: relative; z-index: 1; }
.top-nav { margin-bottom: 32rpx; }

.nav-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.back-btn { display: flex; align-items: center; justify-content: center; padding: 16rpx; transition: all 0.3s ease; }
.back-btn:hover { transform: translateX(-4rpx); }
.back-icon { width: 48rpx; height: 48rpx; }

.nav-title { font-size: 36rpx; font-weight: 800; color: var(--text-primary); letter-spacing: 2rpx; }
.nav-placeholder { width: 72rpx; }

.page-header { margin-bottom: 40rpx; padding-top: 20rpx; }
.page-title { font-size: 40rpx; font-weight: 800; color: var(--text-primary); margin-bottom: 8rpx; }
.page-subtitle { font-size: 26rpx; color: var(--text-secondary); }

.section { margin-bottom: 32rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); position: relative; }
.section-title::before {
  content: '';
  position: absolute; left: 0; bottom: -8rpx;
  width: 48rpx; height: 6rpx;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%);
  border-radius: 3rpx;
}

.video-info-badge {
  display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 20rpx;
  background: var(--bg-tag);
  border-radius: 30rpx;
  font-size: 22rpx; color: var(--gold); font-weight: 600;
  border: 2rpx solid var(--border-stat);
}
.video-icon { font-size: 24rpx; }

.video-preview { padding: 0; border-radius: 24rpx; overflow: hidden; position: relative; }
.preview-placeholder {
  height: 400rpx;
  background: linear-gradient(135deg, rgba(212,175,55,0.08) 0%, rgba(255,215,0,0.05) 100%);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx;
}
.preview-icon { font-size: 80rpx; opacity: 0.6; }
.preview-text { font-size: 28rpx; color: var(--text-secondary); font-weight: 500; }
.preview-hint { font-size: 24rpx; color: var(--text-tertiary); }

.action-buttons { display: flex; gap: 16rpx; margin-bottom: 40rpx; }
.action-buttons .btn { flex: 1; padding: 24rpx 20rpx; font-size: 28rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.btn-icon { font-size: 28rpx; }

.selected-tag {
  display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white; border-radius: 30rpx; font-size: 22rpx; font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(82,196,26,0.3);
}
.selected-icon { font-size: 20rpx; font-weight: bold; }

.clip-list { padding: 8rpx; border-radius: 24rpx; position: relative; overflow: hidden; }
.clip-list::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(212,175,55,0.02) 0%, rgba(255,215,0,0.01) 100%);
  pointer-events: none;
}

.clip-item {
  display: flex; align-items: center; padding: 20rpx; border-radius: 16rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative; z-index: 1; cursor: pointer;
}
.clip-item:hover { background: rgba(212,175,55,0.05); transform: translateX(4rpx); }
.clip-item.selected { background: var(--bg-tag); border: 2rpx solid rgba(212,175,55,0.3); }
.clip-item + .clip-item { border-top: 1rpx solid var(--border-lighter); }

.clip-checkbox { margin-right: 16rpx; }
.checkbox-inner {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 3rpx solid var(--border-checkbox);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.3s ease; background: var(--bg-checkbox);
}
.checkbox-inner.checked { background: var(--gold-gradient); border-color: var(--gold); box-shadow: 0 4rpx 12rpx rgba(212,175,55,0.4); }
.check-mark { color: #1a1a1a; font-size: 24rpx; font-weight: bold; }

.clip-content { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.clip-time { font-size: 22rpx; color: var(--text-tertiary); font-weight: 500; }
.clip-description { font-size: 28rpx; color: var(--text-primary); font-weight: 500; }
.clip-type-badge { padding: 8rpx 16rpx; background: var(--bg-tag); color: var(--gold); border-radius: 20rpx; font-size: 20rpx; font-weight: 600; border: 2rpx solid var(--border-stat); }

.create-action-section { display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.create-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.create-icon { font-size: 32rpx; }
.create-hint { font-size: 24rpx; color: var(--text-tertiary); text-align: center; }
