/* create.wxss */
.video-preview {
  background-color: white;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.preview-placeholder {
  height: 400rpx;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 32rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-buttons .btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 32rpx;
}

.selected-tag {
  display: inline-block;
  background-color: #1A73E8;
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.clip-list {
  background-color: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.clip-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.clip-item:last-child {
  border-bottom: none;
}

.clip-item checkbox {
  margin-right: 20rpx;
  transform: scale(1.5);
}

.clip-info {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}