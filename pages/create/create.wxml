<!-- create.wxml - 现代化UI设计 -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>
  
  <view class="container slide-up">
    <!-- 顶部导航栏 -->
    <view class="top-nav">
      <view class="nav-header">
        <view class="back-btn" bindtap="goBack">
          <image class="back-icon" src="/images/return.svg" mode="aspectFit"></image>
        </view>
        <view class="nav-title">AI创作</view>
        <view class="nav-placeholder"></view>
      </view>
    </view>

    <!-- 页面标题 -->
    <view class="page-header">
      <view class="page-subtitle">智能剪辑你的精彩瞬间</view>
    </view>

    <!-- 视频预览区域 -->
    <view class="section">
      <view class="section-header">
        <view class="section-title">视频预览</view>
        <view class="video-info-badge">
          <t-icon class="video-icon" name="video-camera" size="24rpx" color="#D4AF37" />
          选择视频
        </view>
      </view>
      
      <view class="video-preview card">
        <view class="preview-placeholder">
          <view class="preview-icon">
            <t-icon name="movie-clapper" size="80rpx" color="#D4AF37" />
          </view>
          <view class="preview-text">点击上传或选择视频</view>
          <view class="preview-hint">支持本地视频和云端视频</view>
        </view>
      </view>
    </view>

    <!-- 功能按钮 -->
    <view class="action-buttons">
      <button class="btn btn-primary" bindtap="uploadLocalVideo">
        <t-icon class="btn-icon" name="save" size="28rpx" color="#0a0a0a" />
        上传本地视频
      </button>
      <button class="btn btn-success" bindtap="useCloudVideo">
        <t-icon class="btn-icon" name="cloud-upload" size="28rpx" color="#0a0a0a" />
        使用云端视频
      </button>
    </view>

    <!-- 精彩片段选择 -->
    <view class="section">
      <view class="section-header">
        <view class="section-title">精彩片段选择</view>
        <view class="selected-tag">
          <t-icon class="selected-icon" name="check" size="20rpx" color="#ffffff" />
          已选择 {{ selectedCount }} 个
        </view>
      </view>
      
      <view class="clip-list card">
        <view wx:for="{{ clips }}" wx:key="id" 
              class="clip-item {{ item.selected ? 'selected' : '' }}" 
              bindtap="toggleClip" data-index="{{ index }}">
          <view class="clip-checkbox">
            <view class="checkbox-inner {{ item.selected ? 'checked' : '' }}">
              <t-icon wx:if="{{ item.selected }}" class="check-mark" name="check" size="24rpx" color="#1a1a1a" />
            </view>
          </view>
          <view class="clip-content">
            <view class="clip-time">{{ item.time }}</view>
            <view class="clip-description">{{ item.description }}</view>
          </view>
          <view class="clip-type-badge">
            {{ item.type }}
          </view>
        </view>
      </view>
    </view>

    <!-- AI生成按钮 -->
    <view class="create-action-section">
      <button class="btn btn-primary btn-large create-btn" bindtap="generateWithAI">
        <t-icon class="create-icon" name="flashlight" size="32rpx" color="#0a0a0a" />
        AI智能生成集锦
      </button>
      <view class="create-hint">AI将自动剪辑最精彩的瞬间</view>
    </view>
  </view>
</view>
