<!-- create.wxml -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>
  
  <view class="container slide-up">
    <view class="top-nav">
      <view class="nav-header">
        <view class="page-back-btn" bindtap="goBack">
          <t-icon name="chevron-left" size="42rpx" color="#D4AF37" />
        </view>
        <view class="nav-title">集锦创作</view>
        <view class="nav-placeholder"></view>
      </view>
    </view>

    <view class="create-summary card">
      <view class="summary-icon gradient-bg">
        <t-icon name="movie-clapper" size="48rpx" color="#0a0a0a" />
      </view>
      <view class="summary-copy">
        <view class="summary-title">整理比赛片段</view>
        <view class="summary-desc">选择视频和关键回合，生成一份更干净的篮球集锦</view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <view class="section-title">视频素材</view>
        <view class="video-info-badge">
          <t-icon class="video-icon" name="video-camera" size="24rpx" color="#D4AF37" />
          选择视频
        </view>
      </view>
      
      <view class="video-preview card">
        <view class="preview-placeholder">
          <view class="preview-icon">
            <t-icon name="movie-clapper" size="80rpx" color="#D4AF37" />
          </view>
          <view class="preview-text">暂无视频素材</view>
          <view class="preview-hint">可从本地相册或云端素材库选择</view>
        </view>
      </view>
    </view>

    <view class="action-buttons">
      <button class="action-btn" bindtap="uploadLocalVideo">
        <t-icon class="btn-icon" name="video-camera" size="28rpx" color="#D4AF37" />
        本地视频
      </button>
      <button class="action-btn" bindtap="useCloudVideo">
        <t-icon class="btn-icon" name="cloud-upload" size="28rpx" color="#D4AF37" />
        云端素材
      </button>
    </view>

    <view class="section">
      <view class="section-header">
        <view class="section-title">关键片段</view>
        <view class="selected-tag">
          <t-icon class="selected-icon" name="check" size="20rpx" color="#D4AF37" />
          已选择 {{ selectedCount }} 个
        </view>
      </view>
      
      <view class="clip-list card">
        <view wx:for="{{ clips }}" wx:key="id" 
              class="clip-item {{ item.selected ? 'selected' : '' }}" 
              bindtap="toggleClip" data-index="{{ index }}">
          <view class="clip-checkbox">
            <view class="checkbox-inner {{ item.selected ? 'checked' : '' }}">
              <t-icon wx:if="{{ item.selected }}" class="check-mark" name="check" size="24rpx" color="#1a1a1a" />
            </view>
          </view>
          <view class="clip-content">
            <view class="clip-time">{{ item.time }}</view>
            <view class="clip-description">{{ item.description }}</view>
          </view>
          <view class="clip-type-badge">
            {{ item.type }}
          </view>
        </view>
      </view>
    </view>

    <view class="create-action-section">
      <button class="create-btn" bindtap="generateWithAI">
        <t-icon class="create-icon" name="flashlight" size="32rpx" color="#D4AF37" />
        生成集锦
      </button>
      <view class="create-hint">将根据已选片段整理成完整集锦</view>
    </view>
  </view>
</view>
