<view class="login-shell">
  <view class="login-brand">篮芯办赛</view>
  <view class="login-title">账号登录</view>
  <view class="login-subtitle">使用管理员发放的账号开始办赛</view>
  <view class="login-card">
    <view class="login-label">账号</view>
    <input class="login-input" value="{{username}}" placeholder="请输入账号" maxlength="64" bindinput="onUsernameInput" disabled="{{submitting}}" />
    <view class="login-label">密码</view>
    <input class="login-input" value="{{password}}" password="{{true}}" placeholder="请输入密码" maxlength="128" bindinput="onPasswordInput" confirm-type="done" bindconfirm="submitLogin" disabled="{{submitting}}" />
    <view class="login-error" wx:if="{{error}}">{{error}}</view>
    <button class="login-button" bindtap="submitLogin" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '登录中' : '登录'}}</button>
    <view class="login-help">账号由管理员统一发放。如需开通或找回密码，请联系管理员。</view>
  </view>
</view>
