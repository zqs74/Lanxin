/* booking-success.wxss - 场地预约成功页 */

.bs-hero {
  text-align: center;
  padding-top: 56rpx;
  padding-bottom: 56rpx;
}

.bs-hero-badge {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bs-hero-check {
  width: 48rpx;
  height: 26rpx;
  border-left: 8rpx solid #ffffff;
  border-bottom: 8rpx solid #ffffff;
  border-radius: 4rpx;
  transform: rotate(-45deg) translateY(-6rpx);
}

.bs-hero-kicker {
  margin-top: 26rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.bs-hero-title {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.bs-hero-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
}

.bs-venue-card {
  padding: 0;
  overflow: hidden;
  display: flex;
  align-items: stretch;
}

.bs-venue-cover {
  flex-shrink: 0;
  width: 220rpx;
  height: 220rpx;
  background: #dfe8f8;
}

.bs-venue-body {
  flex: 1;
  min-width: 0;
  padding: 26rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.bs-venue-tag {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(29, 93, 255, 0.1);
  color: #1d5dff;
  font-size: 20rpx;
  line-height: 1.4;
}

.bs-venue-name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1d2d4a;
  line-height: 1.35;
}

.bs-venue-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6c7da3;
}

.bs-info-list {
  margin-top: 20rpx;
}

.bs-info-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(29, 93, 255, 0.06);
}

.bs-info-row:last-child {
  border-bottom: none;
}

.bs-info-label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 24rpx;
  color: #7d8cae;
}

.bs-info-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2d4a;
  word-break: break-all;
}

.bs-links {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.bs-back-link {
  text-align: center;
  font-size: 24rpx;
  color: #1d5dff;
  text-decoration: underline;
}

.bs-link-divider {
  width: 2rpx;
  height: 24rpx;
  background: rgba(29, 93, 255, 0.2);
}

.bs-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 720rpx;
  height: 1450rpx;
}
