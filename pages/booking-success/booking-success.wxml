<view class="app-shell" wx:if="{{record}}">
  <view class="page-hero bs-hero">
    <view class="bs-hero-badge">
      <view class="bs-hero-check"></view>
    </view>
    <view class="bs-hero-kicker">篮芯办赛</view>
    <view class="bs-hero-title">{{record.statusLabel || '预约已提交'}}</view>
    <view class="bs-hero-sub">{{statusDescription}}</view>
  </view>

  <view class="section-card bs-venue-card" wx:if="{{venue}}">
    <image class="bs-venue-cover" src="{{venue.cover}}" mode="aspectFill"></image>
    <view class="bs-venue-body">
      <view class="bs-venue-tag">预约场馆</view>
      <view class="bs-venue-name">{{venue.name}}</view>
      <view class="bs-venue-meta">{{venue.town}} · {{venue.priceLevel || '价格面议'}}</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">预约信息</view>
    <view class="bs-info-list">
      <view class="bs-info-row">
        <view class="bs-info-label">办赛模式</view>
        <view class="bs-info-value">{{modeLabel}}</view>
      </view>
      <view class="bs-info-row">
        <view class="bs-info-label">办赛日期</view>
        <view class="bs-info-value">{{form.expectedDate || '待定'}}</view>
      </view>
      <view class="bs-info-row">
        <view class="bs-info-label">办赛时段</view>
        <view class="bs-info-value">{{form.timeSlot === 'morning' ? '上午 08:00-12:00' : form.timeSlot === 'afternoon' ? '下午 12:00-18:00' : form.timeSlot === 'evening' ? '晚上 18:00-22:00' : '待定'}}</view>
      </view>
      <view class="bs-info-row">
        <view class="bs-info-label">联系人</view>
        <view class="bs-info-value">{{form.contactName || '—'}}</view>
      </view>
      <view class="bs-info-row">
        <view class="bs-info-label">手机号</view>
        <view class="bs-info-value">{{form.phone || '—'}}</view>
      </view>
      <view class="bs-info-row">
        <view class="bs-info-label">微信号</view>
        <view class="bs-info-value">{{form.wechat || '—'}}</view>
      </view>
      <view class="bs-info-row" wx:if="{{form.remark}}">
        <view class="bs-info-label">备注</view>
        <view class="bs-info-value">{{form.remark}}</view>
      </view>
    </view>
  </view>

  <view class="bs-links">
    <view class="bs-back-link" bindtap="goPlan">查看对应办赛方案</view>
    <view class="bs-link-divider"></view>
    <view class="bs-back-link" bindtap="goHome">返回首页继续办赛</view>
  </view>

  <view class="cta-bar">
    <button class="secondary-btn cta-btn" open-type="share">转发好友</button>
    <button class="primary-btn cta-btn" bindtap="saveImage">{{saving ? '导出中...' : '保存脱敏图片'}}</button>
  </view>

  <painter palette="{{palette}}" widthPixels="{{2000}}" bind:imgOK="onImgOK" bind:imgErr="onImgErr" class="bs-painter" />
</view>

<!-- On-demand WeChat privacy authorization; hidden during normal page use. -->
<view wx:if="{{privacyVisible}}" catchtouchmove="privacyNoop" style="position:fixed;top:0;right:0;bottom:0;left:0;z-index:10000;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;">
  <view class="section-card" style="width:600rpx;margin:0;padding:32rpx;display:flex;flex-direction:column;gap:24rpx;">
    <view class="section-title">请阅读并同意隐私保护指引</view>
    <button class="secondary-btn" style="width:100%;height:auto;min-height:88rpx;white-space:normal;line-height:1.5;padding:16rpx;" bindtap="openPrivacyContract">{{privacyContractName}}</button>
    <button id="bansai-privacy-agree" class="primary-btn" style="width:100%;" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacyAuthorization">同意并继续</button>
    <button class="secondary-btn" style="width:100%;" bindtap="cancelPrivacyAuthorization">取消</button>
  </view>
</view>
