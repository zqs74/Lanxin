<!-- index.wxml - 智能剪辑工作台（右上角头像=个人中心） -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>

  <view class="container slide-up">
    <!-- 顶部导航区：左问候，右头像 -->
    <view class="top-nav">
      <view class="user-greeting">
        <view class="greeting-text">{{ greetingText }}</view>
        <view class="date-text">{{ currentDate }}</view>
      </view>
      <view class="avatar-btn" bindtap="openPanel">
        <image wx:if="{{ profile.avatar }}" class="avatar-img" src="{{ profile.avatar }}" mode="aspectFill" />
        <view wx:else class="avatar-img avatar-placeholder">
          <t-icon name="user" size="40rpx" color="#D4AF37" />
        </view>
        <view class="avatar-dot"></view>
      </view>
    </view>

    <!-- 智能剪辑工作台 -->
    <view class="section">
      <view class="section-title">智能剪辑</view>

      <!-- 上传视频卡 -->
      <view class="upload-card card" bindtap="uploadLocalVideo">
        <view class="camera-icon">
          <t-icon name="pen-ball" size="56rpx" color="#0a0a0a" />
        </view>
        <view class="create-info">
          <view class="create-title">{{ videoName ? '已选择：' + videoName : '上传比赛视频' }}</view>
          <view class="create-subtitle">{{ videoName ? '点击可重新选择视频' : '从相册或拍摄一段比赛视频' }}</view>
        </view>
        <view class="cloud-btn" catchtap="useCloudVideo">
          <t-icon name="cloud-upload" size="30rpx" color="#D4AF37" />
          <text class="cloud-btn-text">云端</text>
        </view>
      </view>

      <!-- 片段选择卡 -->
      <view class="clip-card card">
        <view class="clip-header">
          <view class="section-title mini">选择精彩片段</view>
          <view class="clip-count">{{ selectedCount }}/{{ clips.length }} 已选</view>
        </view>
        <view class="clip-list">
          <view
            wx:for="{{ clips }}"
            wx:key="id"
            class="clip-item {{ item.selected ? 'selected' : '' }}"
            data-index="{{ index }}"
            bindtap="toggleClip"
          >
            <view class="clip-check">
              <t-icon wx:if="{{ item.selected }}" name="check" size="28rpx" color="#ffffff" />
            </view>
            <view class="clip-type">{{ item.type }}</view>
            <view class="clip-body">
              <view class="clip-time">{{ item.time }}</view>
              <view class="clip-desc">{{ item.description }}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 生成按钮 -->
      <button class="btn btn-primary generate-btn" bindtap="generateWithAI" disabled="{{ isGenerating }}">
        {{ isGenerating ? 'AI 生成中...' : 'AI 生成集锦' }}
      </button>

      <!-- 生成结果卡 -->
      <view wx:if="{{ videoGenerated }}" class="result-card card fade-in">
        <view class="result-icon">
          <t-icon name="check-circle" size="64rpx" color="#52c41a" />
        </view>
        <view class="result-title">集锦生成成功！</view>
        <view class="result-meta">共 {{ selectedCount }} 个片段 · 时长 {{ generatedDuration }}</view>
        <view class="result-actions">
          <button class="btn btn-primary btn-small" bindtap="saveVideo">保存</button>
          <button class="btn btn-ghost btn-small" bindtap="shareVideo">分享</button>
          <button class="btn btn-ghost btn-small" bindtap="resetVideo">重新剪辑</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 个人中心弹层 -->
  <view wx:if="{{ panelVisible }}" class="panel-mask" bindtap="closePanel">
    <view class="panel {{ themeClass }}" catchtap="stopPropagation">
      <view class="panel-handle"></view>
      <view class="panel-header">
        <image wx:if="{{ profile.avatar }}" class="panel-avatar" src="{{ profile.avatar }}" mode="aspectFill" />
        <view wx:else class="panel-avatar avatar-placeholder-big">
          <t-icon name="user" size="56rpx" color="#D4AF37" />
        </view>
        <view class="panel-user">
          <view class="panel-name">{{ profile.name }}</view>
          <view class="panel-position">{{ profile.position }} · {{ profile.height }} · {{ profile.weight }}</view>
        </view>
      </view>
      <view class="menu-list">
        <view class="menu-item" bindtap="editProfile">
          <view class="menu-icon gold"><t-icon name="edit-1" size="36rpx" color="#D4AF37" /></view>
          <text class="menu-label">编辑资料</text>
          <t-icon name="chevron-right" size="30rpx" color="var(--text-tertiary)" />
        </view>
        <view class="menu-item" bindtap="switchTheme">
          <view class="menu-icon blue"><t-icon name="view-module" size="36rpx" color="#6495ED" /></view>
          <text class="menu-label">主题切换</text>
          <text class="menu-value">{{ themeLabel }}</text>
        </view>
        <view class="menu-item" bindtap="goChat">
          <view class="menu-icon orange"><t-icon name="robot" size="36rpx" color="#faad14" /></view>
          <text class="menu-label">AI 助手</text>
          <t-icon name="chevron-right" size="30rpx" color="var(--text-tertiary)" />
        </view>
        <view class="menu-item" bindtap="goCreateMatch">
          <view class="menu-icon green"><t-icon name="flag" size="36rpx" color="#52c41a" /></view>
          <text class="menu-label">创建比赛</text>
          <t-icon name="chevron-right" size="30rpx" color="var(--text-tertiary)" />
        </view>
      </view>
      <view class="panel-close" bindtap="closePanel">
        <t-icon name="close" size="34rpx" color="var(--text-tertiary)" />
      </view>
    </view>
  </view>

  <!-- 悬浮AI按钮 -->
  <float-ai-button></float-ai-button>
</view>
