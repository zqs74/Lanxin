<!-- index.wxml - 智能剪辑工作台（右上角头像=个人中心） -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>

  <view class="container slide-up">
    <!-- 顶部导航区：左问候，右头像 -->
    <view class="top-nav">
      <view class="user-greeting">
        <view class="greeting-text">你好！</view>
        <view class="date-text">{{ currentDate }}</view>
      </view>
      <view class="avatar-btn" bindtap="openPanel">
        <image wx:if="{{ profile.avatar }}" class="avatar-img" src="{{ profile.avatar }}" mode="aspectFill" />
        <view wx:else class="avatar-img avatar-placeholder">
          <t-icon name="user" size="40rpx" color="#D4AF37" />
        </view>
        <view class="avatar-dot"></view>
      </view>
    </view>

    <!-- 智能剪辑工作台 -->
    <view class="section">
      <view class="section-title">智能剪辑</view>

      <!-- 上传视频卡 -->
      <view class="upload-card card" bindtap="uploadLocalVideo">
        <view class="camera-icon">
          <t-icon name="pen-ball" size="56rpx" color="#0a0a0a" />
        </view>
        <view class="create-info">
          <view class="create-title">{{ videoName ? '已选择：' + videoName : '上传比赛视频' }}</view>
          <view class="create-subtitle">{{ videoName ? '点击可重新选择视频' : '从相册或拍摄一段比赛视频' }}</view>
        </view>
        <view class="cloud-btn" catchtap="useCloudVideo">
          <t-icon name="cloud-upload" size="30rpx" color="#D4AF37" />
          <text class="cloud-btn-text">云端</text>
        </view>
      </view>

      <!-- 原片预览：单一播放器，识别状态不阻塞播放 -->
      <view wx:if="{{ videoName }}" class="source-video-card card">
        <view class="clip-header">
          <view class="section-title mini">{{ playerMode === 'render' ? '集锦预览' : '原片预览' }}</view>
          <button class="btn btn-ghost btn-small" bindtap="resetVideo">关闭</button>
        </view>
        <video wx:for="{{ playerSources }}" wx:key="key" id="source-video-{{ item.key }}"
          class="source-video" src="{{ item.url }}" data-key="{{ item.key }}"
          controls="{{ true }}" autoplay="{{ false }}" show-fullscreen-btn="{{ true }}"
          show-play-btn="{{ true }}" enable-progress-gesture="{{ true }}" object-fit="contain"
          binderror="onSourceError" bindloadedmetadata="onSourceMetadata" bindtimeupdate="onSourceTimeUpdate"
          bindplay="onSourcePlay" bindpause="onSourcePause" bindended="onSourceEnded" />
        <view class="video-meta">{{ sourceStatus }}{{ sourceDuration ? ' · ' + sourceDuration : '' }}</view>
        <view class="video-meta">{{ playerMode === 'render' ? '正在播放已生成的集锦，保存后可在相册查看' : (previewClipLabel || '原片可独立播放，无需等待分析完成') }}</view>
        <view wx:if="{{ playerLoading }}" class="video-meta">正在获取播放链接…</view>
        <view wx:if="{{ playerError }}" class="video-error">{{ playerError }}</view>
        <button wx:if="{{ playerCanRetry }}" class="btn btn-ghost btn-small" bindtap="retrySource" disabled="{{ playerLoading }}">刷新播放链接（仅重试一次）</button>
        <button wx:if="{{ selectedVideoId && !playerSources.length && !playerLoading && !playerError }}" class="btn btn-ghost btn-small" bindtap="reopenSource">查看原片</button>
        <button wx:if="{{ playerMode === 'render' && !playerLoading }}" class="btn btn-ghost btn-small" bindtap="reopenSource">返回原片</button>
      </view>

      <!-- 云端视频库：仅加载元数据，选择后获取播放链接 -->
      <view wx:if="{{ libraryVisible }}" class="video-library card">
        <view class="clip-header">
          <view class="section-title mini">云端视频</view>
          <button class="btn btn-ghost btn-small" bindtap="closeVideoLibrary">收起</button>
        </view>
        <view wx:for="{{ libraryItems }}" wx:key="id" class="video-library-item {{ selectedVideoId === item.id ? 'active' : '' }}"
          data-id="{{ item.id }}" bindtap="selectCloudVideo">
          <view class="video-library-main">
            <view class="video-date">{{ item.dateLabel }}</view>
            <view class="video-meta">{{ item.durationLabel }} · {{ item.statusLabel }}</view>
          </view>
          <text class="video-preview-label">▶ 播放原片</text>
        </view>
        <view wx:if="{{ !libraryLoading && !libraryError && !libraryItems.length }}" class="video-meta">暂无云端视频，上传后可在这里查看</view>
        <view wx:if="{{ libraryLoading }}" class="video-meta">正在加载视频…</view>
        <view wx:if="{{ libraryError }}" class="video-error">{{ libraryError }}</view>
        <button wx:if="{{ libraryError || libraryMore }}" class="btn btn-ghost btn-small" bindtap="loadVideoLibrary" disabled="{{ libraryLoading }}">{{ libraryError ? '重试加载' : '加载更多' }}</button>
      </view>

      <!-- 片段选择卡 -->
      <view class="clip-card card">
        <view class="clip-header">
          <view class="section-title mini">选择精彩片段</view>
          <view class="clip-count">{{ selectedCount }}/{{ clips.length }} 已选</view>
        </view>
        <view class="clip-list">
          <view
            wx:for="{{ clips }}"
            wx:key="id"
            class="clip-item {{ item.selected ? 'selected' : '' }}"
            data-index="{{ index }}"
            bindtap="toggleClip"
          >
            <view class="clip-check">
              <t-icon wx:if="{{ item.selected }}" name="check" size="28rpx" color="#ffffff" />
            </view>
            <view class="clip-type">{{ item.type }}</view>
            <view class="clip-body">
              <view class="clip-time">{{ item.time }}</view>
              <view class="clip-desc">{{ item.description }}</view>
            </view>
            <view class="clip-preview {{ previewClipId === item.id ? 'active' : '' }}" data-index="{{ index }}" catchtap="previewClip">{{ previewClipId === item.id ? '预览中' : '▶ 预览' }}</view>
          </view>
        </view>
      </view>

      <!-- 生成按钮 -->
      <button class="btn btn-primary generate-btn" bindtap="generateWithAI" disabled="{{ isGenerating }}">
        {{ isGenerating ? 'AI 生成中...' : 'AI 生成集锦' }}
      </button>

      <!-- 生成结果卡 -->
      <view wx:if="{{ videoGenerated }}" class="result-card card fade-in">
        <view class="result-icon">
          <t-icon name="check-circle" size="64rpx" color="#52c41a" />
        </view>
        <view class="result-title">集锦生成成功！</view>
        <view class="result-meta">共 {{ selectedCount }} 个片段 · 时长 {{ generatedDuration }}</view>
        <view class="result-actions">
          <button class="btn btn-primary btn-small" bindtap="playRender">播放集锦</button>
          <button class="btn btn-ghost btn-small" bindtap="saveVideo">保存</button>
          <button class="btn btn-ghost btn-small" bindtap="shareVideo">分享</button>
          <button class="btn btn-ghost btn-small" bindtap="resetVideo">重新剪辑</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 个人中心弹层 -->
  <view wx:if="{{ panelVisible }}" class="panel-mask" bindtap="closePanel">
    <view class="panel {{ themeClass }}" catchtap="stopPropagation">
      <view class="panel-handle"></view>
      <view class="panel-header">
        <image wx:if="{{ profile.avatar }}" class="panel-avatar" src="{{ profile.avatar }}" mode="aspectFill" />
        <view wx:else class="panel-avatar avatar-placeholder-big">
          <t-icon name="user" size="56rpx" color="#D4AF37" />
        </view>
        <view class="panel-user">
          <view class="panel-name">{{ profile.name }}</view>
          <view class="panel-position">{{ profile.position }} · {{ profile.height }} · {{ profile.weight }}</view>
        </view>
      </view>
      <view class="menu-list">
        <view class="menu-item" bindtap="editProfile">
          <view class="menu-icon gold"><t-icon name="edit-1" size="36rpx" color="#D4AF37" /></view>
          <text class="menu-label">编辑资料</text>
          <t-icon name="chevron-right" size="30rpx" color="var(--text-tertiary)" />
        </view>
        <view class="menu-item" bindtap="switchTheme">
          <view class="menu-icon blue"><t-icon name="view-module" size="36rpx" color="#6495ED" /></view>
          <text class="menu-label">主题 / 隐私指引</text>
          <text class="menu-value">{{ themeLabel }}</text>
        </view>
        <view class="menu-item" bindtap="goChat">
          <view class="menu-icon orange"><t-icon name="robot" size="36rpx" color="#faad14" /></view>
          <text class="menu-label">AI 助手</text>
          <t-icon name="chevron-right" size="30rpx" color="var(--text-tertiary)" />
        </view>
        <view class="menu-item" bindtap="goCreateMatch">
          <view class="menu-icon green"><t-icon name="flag" size="36rpx" color="#52c41a" /></view>
          <text class="menu-label">创建比赛</text>
          <t-icon name="chevron-right" size="30rpx" color="var(--text-tertiary)" />
        </view>
      </view>
      <view class="panel-close" bindtap="closePanel">
        <t-icon name="close" size="34rpx" color="var(--text-tertiary)" />
      </view>
    </view>
  </view>

  <!-- 悬浮AI按钮 -->
  <float-ai-button></float-ai-button>
</view>

<!-- On-demand WeChat privacy authorization; absent from the normal page layout. -->
<view wx:if="{{privacyVisible}}" style="position:fixed;top:0;right:0;bottom:0;left:0;z-index:9999;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;">
  <view class="card {{themeClass}}" style="width:600rpx;box-sizing:border-box;padding:32rpx;display:flex;flex-direction:column;gap:20rpx;background:var(--bg-card,#ffffff);color:var(--text-primary,#222222);">
    <view>继续前请阅读并同意隐私保护指引</view>
    <button class="btn btn-ghost" bindtap="openPrivacyContract">{{privacyContractName}}</button>
    <button id="privacy-agree" class="btn btn-primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacyAuthorization">同意并继续</button>
    <button class="btn btn-ghost" bindtap="cancelPrivacyAuthorization">取消</button>
  </view>
</view>
