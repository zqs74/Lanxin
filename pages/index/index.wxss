/* index.wxss - Liquid Glass 奢华黑金风格 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 20rpx 30rpx;
  position: relative;
  z-index: 1;
}

.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.user-greeting {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(212, 175, 55, 0.3);
}

.date-text {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.app-title {
  display: flex;
  align-items: baseline;
}

.title-main {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.title-highlight {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 50%, #F4C430 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% {
    filter: brightness(1);
  }
  50% {
    filter: brightness(1.3);
  }
}

/* 创作入口 - Liquid Glass 效果 */
.create-entry {
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: linear-gradient(
    135deg,
    rgba(212, 175, 55, 0.12) 0%,
    rgba(255, 215, 0, 0.08) 25%,
    rgba(212, 175, 55, 0.06) 50%,
    rgba(255, 215, 0, 0.1) 75%,
    rgba(212, 175, 55, 0.15) 100%
  );
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  border: 1rpx solid rgba(212, 175, 55, 0.25);
  box-shadow:
    0 8rpx 32rpx rgba(212, 175, 55, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05),
    0 0 60rpx rgba(212, 175, 55, 0.05);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.create-entry::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(
    circle,
    rgba(212, 175, 55, 0.15) 0%,
    transparent 70%
  );
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.create-entry:hover {
  transform: translateY(-6rpx);
  box-shadow:
    0 16rpx 48rpx rgba(212, 175, 55, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1),
    0 0 80rpx rgba(212, 175, 55, 0.1);
  border-color: rgba(212, 175, 55, 0.4);
}

.create-entry:hover::before {
  opacity: 1;
}

.camera-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 50%, #F4C430 100%);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  box-shadow:
    0 8rpx 24rpx rgba(212, 175, 55, 0.4),
    0 0 40rpx rgba(212, 175, 55, 0.2);
  position: relative;
  z-index: 1;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.camera-icon:hover {
  transform: scale(1.1) rotate(-5deg);
  box-shadow:
    0 12rpx 36rpx rgba(212, 175, 55, 0.5),
    0 0 60rpx rgba(212, 175, 55, 0.3);
}

.create-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.create-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 10rpx rgba(212, 175, 55, 0.3);
}

.create-subtitle {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.create-arrow {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: bold;
  box-shadow:
    0 6rpx 20rpx rgba(212, 175, 55, 0.35),
    0 0 30rpx rgba(212, 175, 55, 0.15);
  position: relative;
  z-index: 1;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.create-entry:hover .create-arrow {
  transform: translateX(6rpx);
  box-shadow:
    0 8rpx 28rpx rgba(212, 175, 55, 0.45),
    0 0 40rpx rgba(212, 175, 55, 0.25);
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
  position: relative;
  display: inline-block;
  text-shadow: 0 2rpx 10rpx rgba(212, 175, 55, 0.3);
}

.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -10rpx;
  width: 80rpx;
  height: 5rpx;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 50%, transparent 100%);
  border-radius: 3rpx;
}

/* 数据卡片网格 - Liquid Glass 风格 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-bottom: 0;
}

.stat-item {
  padding: 28rpx 14rpx;
  border-radius: 28rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    145deg,
    rgba(35, 35, 35, 0.9) 0%,
    rgba(25, 25, 25, 0.95) 100%
  );
  backdrop-filter: blur(20rpx) saturate(150%);
  -webkit-backdrop-filter: blur(20rpx) saturate(150%);
  border: 1rpx solid rgba(212, 175, 55, 0.18);
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.4),
    0 0 30rpx rgba(212, 175, 55, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.stat-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(212, 175, 55, 0.4) 50%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity 0.4s ease;
}

.stat-item::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: 50%;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(212, 175, 55, 0.15) 0%,
    transparent 70%
  );
  transform: translateX(-50%);
  opacity: 0;
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.stat-item:hover {
  transform: translateY(-8rpx) scale(1.02);
  border-color: rgba(212, 175, 55, 0.4);
  box-shadow:
    0 12rpx 36rpx rgba(212, 175, 55, 0.2),
    0 0 50rpx rgba(212, 175, 55, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.stat-item:hover::before {
  opacity: 1;
}

.stat-item:hover::after {
  bottom: 20rpx;
  opacity: 1;
}

.stat-icon {
  font-size: 42rpx;
  margin-bottom: 4rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(212, 175, 55, 0.3));
  transition: all 0.4s ease;
}

.stat-item:hover .stat-icon {
  transform: scale(1.15) rotate(5deg);
  filter: drop-shadow(0 4rpx 16rpx rgba(212, 175, 55, 0.5));
}

.stat-value {
  font-size: 38rpx;
  font-weight: 900;
  font-family: 'Arial', sans-serif;
  margin-bottom: 4rpx;
  background: linear-gradient(135deg, #ffffff 0%, #D4AF37 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  transition: all 0.4s ease;
  letter-spacing: -1rpx;
}

.stat-item:hover .stat-value {
  background: linear-gradient(135deg, #FFD700 0%, #D4AF37 50%, #F4C430 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  filter: drop-shadow(0 0 20rpx rgba(212, 175, 55, 0.4));
}

.stat-label {
  font-size: 22rpx;
  color: #888;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: all 0.4s ease;
}

.stat-item:hover .stat-label {
  color: #D4AF37;
}

.video-tabs {
  margin-bottom: 24rpx;
}

.no-videos {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: linear-gradient(
    145deg,
    rgba(35, 35, 35, 0.85) 0%,
    rgba(25, 25, 25, 0.9) 100%
  );
  backdrop-filter: blur(20rpx) saturate(140%);
  -webkit-backdrop-filter: blur(20rpx) saturate(140%);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  box-shadow:
    0 4rpx 24rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.02);
}

.no-videos::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(
    circle at 50% 50%,
    rgba(212, 175, 55, 0.06) 0%,
    transparent 70%
  );
  pointer-events: none;
}

.film-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 4rpx 20rpx rgba(212, 175, 55, 0.3));
  animation: floatGlow 3s ease-in-out infinite;
}

@keyframes floatGlow {
  0%, 100% {
    transform: translateY(0) scale(1);
    filter: drop-shadow(0 4rpx 20rpx rgba(212, 175, 55, 0.3));
  }
  50% {
    transform: translateY(-10rpx) scale(1.05);
    filter: drop-shadow(0 8rpx 30rpx rgba(212, 175, 55, 0.5));
  }
}

.no-data-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 600;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  position: relative;
  z-index: 1;
  max-width: 400rpx;
}

/* 快捷功能卡片 - Liquid Glass 风格 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.action-item {
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(
    145deg,
    rgba(35, 35, 35, 0.9) 0%,
    rgba(25, 25, 25, 0.95) 100%
  );
  backdrop-filter: blur(20rpx) saturate(150%);
  -webkit-backdrop-filter: blur(20rpx) saturate(150%);
  border: 1rpx solid rgba(212, 175, 55, 0.18);
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.4),
    0 0 30rpx rgba(212, 175, 55, 0.03),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.action-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(212, 175, 55, 0.4) 50%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity 0.4s ease;
}

.action-item:hover {
  transform: translateY(-8rpx) scale(1.03);
  border-color: rgba(212, 175, 55, 0.4);
  box-shadow:
    0 12rpx 36rpx rgba(212, 175, 55, 0.18),
    0 0 50rpx rgba(212, 175, 55, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.action-item:hover::before {
  opacity: 1;
}

.action-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  box-shadow:
    0 6rpx 20rpx rgba(0, 0, 0, 0.35),
    0 0 30rpx rgba(212, 175, 55, 0.1);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
}

.action-item:hover .action-icon {
  transform: scale(1.12) rotate(-8deg);
  box-shadow:
    0 10rpx 30rpx rgba(0, 0, 0, 0.45),
    0 0 40rpx rgba(212, 175, 55, 0.25);
}

.action-label {
  font-size: 24rpx;
  color: #ccc;
  font-weight: 600;
  text-align: center;
  letter-spacing: 0.5rpx;
  transition: all 0.4s ease;
  position: relative;
  z-index: 1;
}

.action-item:hover .action-label {
  color: #D4AF37;
}
