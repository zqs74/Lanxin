/* index.wxss - 酷炫黑金风格 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 20rpx 30rpx;
  position: relative;
  z-index: 1;
}

.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.user-greeting {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.date-text {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.app-title {
  display: flex;
  align-items: baseline;
}

.title-main {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.title-highlight {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.create-entry {
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.create-entry::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.08) 0%, rgba(255, 215, 0, 0.04) 100%);
  pointer-events: none;
}

.camera-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 100%);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 175, 55, 0.3);
  position: relative;
  z-index: 1;
}

.create-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.create-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.create-subtitle {
  font-size: 26rpx;
  color: #999;
  line-height: 1.4;
}

.create-arrow {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(212, 175, 55, 0.3);
  position: relative;
  z-index: 1;
}

.section {
  margin-bottom: 40rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-bottom: 0;
}

.stat-item {
  padding: 28rpx 12rpx;
  border-radius: 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 800;
  font-family: 'Arial', sans-serif;
  margin-bottom: 4rpx;
  color: #ffffff;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

.video-tabs {
  margin-bottom: 24rpx;
}

.no-videos {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  position: relative;
}

.no-videos::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.03) 0%, rgba(255, 215, 0, 0.02) 100%);
  border-radius: 24rpx;
  pointer-events: none;
}

.film-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
  position: relative;
  z-index: 1;
}

.no-data-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 600;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.hint-text {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.action-item {
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
}

.action-item:hover .action-icon {
  transform: scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.4);
}

.action-label {
  font-size: 24rpx;
  color: #e0e0e0;
  font-weight: 500;
  text-align: center;
}
