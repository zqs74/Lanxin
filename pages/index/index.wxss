/* index.wxss - 昇梦体育 主题适配 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 136rpx 28rpx 24rpx;
  position: relative;
  z-index: 1;
}

.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding-top: 20rpx;
}

.user-greeting {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  letter-spacing: 0;
}

.date-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 0;
}

.app-title {
  display: flex;
  align-items: baseline;
}

.title-main {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 0;
}

.title-highlight {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--gold);
  background: none;
  -webkit-background-clip: text;
  -webkit-text-fill-color: currentColor;
  background-clip: text;
  filter: none;
  letter-spacing: 0;
  animation: none;
}

.create-entry {
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
  position: relative;
  overflow: hidden;
  border-radius: 22rpx;
  background: var(--bg-create-entry);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid var(--border-glass);
  box-shadow: var(--shadow-card);
  transition: transform 0.18s ease, border-color 0.18s ease;
}

.create-entry::before {
  display: none;
}

.create-entry:active {
  transform: scale(0.985);
  border-color: var(--border-card-hover);
}

.camera-icon {
  width: 92rpx;
  height: 92rpx;
  background: var(--gold-gradient);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(212,175,55,0.28);
  position: relative;
  z-index: 1;
  transition: transform 0.18s ease;
}

.create-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.create-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  letter-spacing: 0;
}

.create-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  letter-spacing: 0;
}

.create-arrow {
  width: 56rpx;
  height: 56rpx;
  background: var(--bg-tag);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--gold);
  font-weight: 900;
  box-shadow: none;
  position: relative;
  z-index: 1;
  transition: transform 0.18s ease;
}

.section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 22rpx;
  letter-spacing: 0;
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 44rpx;
  height: 4rpx;
  background: var(--gold);
  border-radius: 2rpx;
  box-shadow: none;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 18rpx;
  margin-bottom: 0;
}

.stat-item {
  padding: 30rpx 14rpx;
  border-radius: 28rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
  background: var(--bg-stat-item);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid var(--border-card);
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  cursor: pointer;
}

.stat-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(212,175,55,0.45) 50%, transparent 100%);
  opacity: 0.78;
}

.stat-item::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: 50%;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212,175,55,0.12) 0%, transparent 70%);
  transform: translateX(-50%);
  opacity: 0.78;
  pointer-events: none;
}

.stat-item:active {
  transform: translateY(2rpx) scale(0.985);
  border-color: var(--border-card-hover);
  box-shadow: var(--shadow-card-hover);
}

.stat-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  filter: drop-shadow(0 3rpx 10rpx rgba(212,175,55,0.35));
  position: relative;
  z-index: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 900;
  font-family: "Arial Black","DIN Alternate","PingFang SC","Microsoft YaHei",sans-serif;
  margin-bottom: 4rpx;
  background: linear-gradient(135deg, var(--text-primary) 0%, var(--gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  color: var(--gold);
  letter-spacing: -1rpx;
  position: relative;
  z-index: 1;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-dim);
  font-weight: 600;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.video-tabs {
  margin-bottom: 28rpx;
}

.no-videos {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 36rpx;
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--bg-no-videos);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-card);
}

.no-videos::before {
  display: none;
}

.film-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
  opacity: 0.44;
  position: relative;
  z-index: 1;
  filter: none;
  animation: none;
}

.no-data-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 700;
  margin-bottom: 14rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.hint-text {
  font-size: 24rpx;
  color: var(--text-placeholder);
  text-align: center;
  line-height: 1.6;
  position: relative;
  z-index: 1;
  max-width: 420rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.action-item {
  padding: 22rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--bg-action-item);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-card);
  transition: transform 0.18s ease, border-color 0.18s ease;
  cursor: pointer;
}

.action-item::before {
  display: none;
}

.action-item:active {
  transform: scale(0.985);
  border-color: var(--border-card-hover);
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: none;
  transition: transform 0.18s ease;
  position: relative;
  z-index: 1;
}

.action-label {
  font-size: 26rpx;
  color: var(--text-label);
  font-weight: 600;
  text-align: left;
  letter-spacing: 0;
  transition: color 0.18s ease;
  position: relative;
  z-index: 1;
}
