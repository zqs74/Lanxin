/* index.wxss - 现代化UI设计 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: var(--spacing-md);
  position: relative;
  z-index: 1;
}

/* 顶部导航区 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-xl);
  padding-top: var(--spacing-md);
  position: relative;
}

.top-nav::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  opacity: 0.3;
}

.user-greeting {
  display: flex;
  flex-direction: column;
  animation: slideUp 0.6s var(--transition-normal);
}

.greeting-text {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
  position: relative;
  display: inline-block;
}

.greeting-text::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 80%;
  height: 3rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, transparent 100%);
  border-radius: 1.5rpx;
}

.date-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 400;
  opacity: 0.9;
}

.app-title {
  display: flex;
  align-items: baseline;
  animation: slideUp 0.6s var(--transition-normal) 0.2s both;
}

.title-main {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
}

.title-highlight {
  font-size: var(--font-xl);
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
  margin-left: 4rpx;
}

.title-highlight::before {
  content: '';
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  width: 20rpx;
  height: 20rpx;
  background: radial-gradient(circle, rgba(68, 206, 255, 0.4) 0%, rgba(68, 206, 255, 0) 70%);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

/* 创作入口区 */
.create-entry {
  padding: var(--spacing-lg);
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-xl);
  position: relative;
  overflow: hidden;
  animation: slideUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s both;
  border-radius: var(--border-radius-xl);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.create-entry::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.05) 100%);
  pointer-events: none;
}

.create-entry::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(68, 206, 255, 0.05) 50%, transparent 60%);
  transform: rotate(45deg);
  animation: shimmer 3s ease-in-out infinite;
}

.create-entry:hover {
  transform: translateY(-8rpx);
  box-shadow: var(--shadow-medium);
}

.create-entry:active {
  transform: scale(0.98) translateY(-4rpx);
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) rotate(45deg);
  }
}

.camera-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: var(--spacing-md);
  box-shadow: 0 8rpx 24rpx rgba(68, 206, 255, 0.3);
  position: relative;
  z-index: 1;
  transition: all var(--transition-normal);
}

.create-entry:hover .camera-icon {
  transform: scale(1.05) rotate(5deg);
  box-shadow: 0 12rpx 32rpx rgba(68, 206, 255, 0.4);
}

.create-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.create-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
  letter-spacing: 0.5rpx;
  position: relative;
  display: inline-block;
}

.create-subtitle {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.4;
  opacity: 0.9;
}

.create-arrow {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-light);
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.3);
  position: relative;
  z-index: 1;
  transition: all var(--transition-normal);
}

.create-entry:hover .create-arrow {
  transform: translateX(10rpx) scale(1.1);
  box-shadow: 0 6rpx 16rpx rgba(68, 206, 255, 0.4);
}

/* 通用section样式 */
.section {
  margin-bottom: var(--spacing-xl);
  animation: slideUp 0.6s var(--transition-normal);
}

.section:nth-child(3) {
  animation-delay: 0.4s;
  animation-fill-mode: both;
}

.section:nth-child(4) {
  animation-delay: 0.5s;
  animation-fill-mode: both;
}

.section:nth-child(5) {
  animation-delay: 0.6s;
  animation-fill-mode: both;
}

/* 生涯数据区 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-bottom: 0;
}

.stat-item {
  padding: 28rpx 12rpx;
  border-radius: var(--border-radius-lg);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
}

.stat-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.stat-item::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(68, 206, 255, 0.05) 50%, transparent 70%);
  transform: rotate(45deg);
  transition: left 0.6s ease;
  left: -100%;
}

.stat-item:hover {
  transform: translateY(-8rpx) scale(1.02);
  box-shadow: var(--shadow-medium);
}

.stat-item:hover::before {
  transform: scaleX(1);
}

.stat-item:hover::after {
  left: 100%;
}

.stat-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  position: relative;
  z-index: 1;
  animation: float 3s ease-in-out infinite;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-value {
  font-size: var(--font-xl);
  font-weight: 800;
  font-family: 'Arial', sans-serif;
  margin-bottom: 4rpx;
  position: relative;
  z-index: 1;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  font-weight: 500;
  position: relative;
  z-index: 1;
  transition: color 0.3s ease;
}

.stat-item:hover .stat-label {
  color: var(--primary-color);
}

/* 创作集锦区 */
.video-tabs {
  margin-bottom: var(--spacing-md);
}

.no-videos {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  position: relative;
  overflow: hidden;
}

.no-videos::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.05) 0%, rgba(89, 168, 255, 0.02) 100%);
  border-radius: var(--border-radius-lg);
  pointer-events: none;
}

.no-videos::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(68, 206, 255, 0.1) 0%, rgba(68, 206, 255, 0) 70%);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  animation: pulse 3s ease-in-out infinite;
}

.film-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.6;
  position: relative;
  z-index: 1;
  animation: float 3s ease-in-out infinite;
}

.no-data-text {
  font-size: var(--font-lg);
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: var(--spacing-xs);
  position: relative;
  z-index: 1;
}

.hint-text {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.5;
  position: relative;
  z-index: 1;
  opacity: 0.8;
}

/* 快捷功能区 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.action-item {
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border-radius: var(--border-radius-lg);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.action-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.action-item::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(68, 206, 255, 0.05) 50%, transparent 70%);
  transform: rotate(45deg);
  transition: left 0.6s ease;
  left: -100%;
}

.action-item:hover {
  transform: translateY(-8rpx) scale(1.02);
  box-shadow: var(--shadow-medium);
}

.action-item:hover::before {
  transform: scaleX(1);
}

.action-item:hover::after {
  left: 100%;
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: white;
  animation: float 3s ease-in-out infinite;
}

.action-icon::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.action-item:hover .action-icon {
  transform: scale(1.1) rotate(10deg);
  box-shadow: 0 12rpx 32rpx rgba(68, 206, 255, 0.4);
}

.action-item:hover .action-icon::after {
  left: 100%;
}

.action-label {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 600;
  text-align: center;
  position: relative;
  z-index: 1;
  transition: color 0.3s ease;
}

.action-item:hover .action-label {
  color: var(--primary-color);
  transform: translateY(-2rpx);
  text-shadow: 0 2rpx 4rpx rgba(68, 206, 255, 0.3);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .stats-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  
  .quick-actions {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .create-entry {
    padding: var(--spacing-md);
  }
  
  .camera-icon {
    width: 80rpx;
    height: 80rpx;
    font-size: 36rpx;
  }
}

/* 加载动画 */
.contentAnimClass {
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
