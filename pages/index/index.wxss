/* index.wxss */
/* 全局样式 */
.container {
  padding: 20rpx;
  background-color: #121212;
  min-height: 100vh;
}

/* 顶部导航区 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 10rpx 0;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 2rpx;
}

.rank-btn {
  padding: 8rpx 20rpx;
  background-color: #333;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  transition: all 0.3s ease;
}

.rank-btn:hover {
  background-color: #444;
  transform: scale(1.05);
}

/* 创作入口区 */
.create-entry {
  background-color: #1E1E1E;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
}

.create-entry:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.4);
}

.camera-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: #7A41FF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(122, 65, 255, 0.4);
  line-height: 80rpx;
  text-align: center;
}

.create-info {
  flex: 1;
}

.create-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.create-subtitle {
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
}

/* 生涯数据区 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.stat-item {
  background-color: #1E1E1E;
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

.stat-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
  font-family: 'Arial', sans-serif;
}

.stat-value.purple {
  color: #7A41FF;
  text-shadow: 0 0 8rpx rgba(122, 65, 255, 0.5);
}

.stat-label {
  font-size: 20rpx;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* 创作集锦区 */
.video-tabs {
  display: flex;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #333;
  padding-bottom: 0;
  position: relative;
}

.video-tabs .tab-item {
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #888;
  position: relative;
  margin-right: 20rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 1;
}

.video-tabs .tab-item:hover {
  color: #aaa;
}

.video-tabs .tab-item.active {
  color: #7A41FF;
  font-weight: bold;
}



/* 内容切换动画 */
.no-videos {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  background-color: #1E1E1E;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
  opacity: 1;
  transform: translateY(0);
}

.no-videos.fade-out {
  opacity: 0;
  transform: translateY(20rpx);
}

.no-videos.fade-in {
  opacity: 1;
  transform: translateY(0);
}

.film-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
  transition: all 0.3s ease;
}

.no-videos:hover .film-icon {
  opacity: 0.6;
  transform: scale(1.1);
}

.no-data-text {
  font-size: 28rpx;
  color: #888;
  letter-spacing: 1rpx;
}

/* 底部TabBar样式 */
.tab-bar {
  background-color: #1E1E1E;
  border-top: 1rpx solid #333;
}