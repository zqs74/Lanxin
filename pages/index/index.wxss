/* index.wxss - 昇梦体育 智能剪辑工作台 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 136rpx 28rpx 24rpx;
  position: relative;
  z-index: 1;
}

/* ===== 顶部导航 ===== */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding-top: 20rpx;
}

.user-greeting {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  letter-spacing: 0;
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 0;
}

/* 头像入口 */
.avatar-btn {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid var(--gold);
  box-shadow: var(--shadow-avatar);
  overflow: visible;
  flex-shrink: 0;
}

.avatar-btn:active {
  transform: scale(0.96);
}

.avatar-img {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--bg-avatar-placeholder);
  box-sizing: border-box;
}

.avatar-placeholder {
  border-radius: 50%;
}

.avatar-dot {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--gold-gradient);
  border: 3rpx solid var(--bg-page-flat);
}

/* ===== 区块通用 ===== */
.section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 22rpx;
  letter-spacing: 0;
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 44rpx;
  height: 4rpx;
  background: var(--gold);
  border-radius: 2rpx;
}

.section-title.mini {
  font-size: 28rpx;
  margin-bottom: 0;
}

/* ===== 上传视频卡 ===== */
.upload-card {
  padding: 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  border-radius: 22rpx;
  background: var(--bg-create-entry);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid var(--border-glass);
  box-shadow: var(--shadow-card);
  transition: transform 0.18s ease, border-color 0.18s ease;
}

.upload-card:active {
  transform: scale(0.985);
  border-color: var(--border-card-hover);
}

.camera-icon {
  width: 92rpx;
  height: 92rpx;
  background: var(--gold-gradient);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(212,175,55,0.28);
  flex-shrink: 0;
}

.create-info {
  flex: 1;
  min-width: 0;
}

.create-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.create-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  letter-spacing: 0;
}

.cloud-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: var(--bg-tag);
  border: 1rpx solid var(--border-stat);
  flex-shrink: 0;
}

.cloud-btn:active {
  transform: scale(0.96);
}

.cloud-btn-text {
  font-size: 20rpx;
  color: var(--gold);
  font-weight: 600;
}

/* ===== 片段选择卡 ===== */
.clip-card {
  padding: 26rpx 26rpx 14rpx;
  margin-bottom: 28rpx;
}

.clip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.clip-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.clip-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.clip-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: var(--bg-card-light);
  border: 2rpx solid var(--border-superlight);
  transition: all 0.18s ease;
}

.clip-item:active {
  transform: scale(0.99);
}

.clip-item.selected {
  border-color: var(--gold);
  background: var(--bg-tag);
  box-shadow: 0 0 16rpx rgba(212,175,55,0.12);
}

.clip-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-checkbox);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--bg-checkbox);
  transition: all 0.18s ease;
}

.clip-item.selected .clip-check {
  background: var(--gold-gradient);
  border-color: var(--gold);
}

.clip-type {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gold);
  background: var(--bg-tag);
  border: 1rpx solid var(--border-stat);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.clip-body {
  flex: 1;
  min-width: 0;
}

.clip-time {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.clip-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 生成按钮 ===== */
.generate-btn {
  width: 100%;
  margin-bottom: 28rpx;
  font-size: 30rpx;
}

.generate-btn[disabled] {
  opacity: 0.7;
  color: #0a0a0a;
}

/* ===== 生成结果卡 ===== */
.result-card {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 22rpx;
  border-color: rgba(82,196,26,0.3);
}

.result-icon {
  margin-bottom: 18rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  letter-spacing: 0;
}

.result-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 30rpx;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

/* ===== 个人中心弹层 ===== */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease-out;
}

.panel {
  width: 100%;
  background: var(--bg-modal);
  border-radius: 36rpx 36rpx 0 0;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: var(--shadow-modal);
  animation: slideUp 0.28s ease-out;
}

.panel-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--border-divider);
  margin: 8rpx auto 28rpx;
}

.panel-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.panel-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid var(--gold);
  box-shadow: var(--shadow-avatar);
  flex-shrink: 0;
}

.avatar-placeholder-big {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-avatar-placeholder);
  box-sizing: border-box;
}

.panel-user {
  flex: 1;
  min-width: 0;
}

.panel-name {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  letter-spacing: 0;
}

.panel-position {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 微信头像 / 昵称快捷区 ===== */
.wx-profile {
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
}

.wx-profile-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 18rpx;
}

.wx-profile-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wx-profile-row + .wx-profile-row {
  margin-top: 18rpx;
}

.wx-profile-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 700;
  width: 76rpx;
  flex-shrink: 0;
}

.wx-avatar-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wx-avatar-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0;
  padding: 0 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  background: var(--bg-card-light);
  border: 1.5rpx solid var(--border-input);
  border-radius: 999rpx;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-avatar-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.wx-avatar-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.wx-album-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--bg-card-light);
  border: 1.5rpx solid var(--border-input);
}

.wx-album-btn:active {
  transform: scale(0.97);
}

.wx-album-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.wx-nickname-input {
  flex: 1;
  min-height: 72rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: var(--bg-input-form);
  border: 1.5rpx solid var(--border-input);
  border-radius: 18rpx;
  font-size: 26rpx;
  color: var(--text-content);
}

.wx-nickname-placeholder {
  color: var(--text-placeholder);
  font-size: 26rpx;
}

.wx-nickname-save {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  border-radius: 18rpx;
  background: var(--gold);
  color: #0a0a0a;
  font-size: 26rpx;
  font-weight: 800;
}

.wx-nickname-save:active {
  transform: scale(0.97);
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: var(--bg-card-light);
  border: 1rpx solid var(--border-superlight);
  transition: transform 0.15s ease, border-color 0.15s ease;
}

.menu-item:active {
  transform: scale(0.985);
  border-color: var(--border-card-hover);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon.gold { background: rgba(212,175,55,0.12); }
.menu-icon.blue { background: rgba(100,149,237,0.12); }
.menu-icon.orange { background: rgba(250,173,20,0.12); }
.menu-icon.green { background: rgba(82,196,26,0.12); }

.menu-label {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.menu-value {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.panel-close {
  position: absolute;
  top: 36rpx;
  right: 32rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-tag);
  display: flex;
  align-items: center;
  justify-content: center;
}
