.home-shell {
  padding-bottom: 220rpx;
}

.home-hero-board {
  position: relative;
  padding: 36rpx 30rpx 28rpx;
  border-radius: 38rpx;
  background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.24) 0, rgba(255, 255, 255, 0) 28%), linear-gradient(135deg, #0f5dff 0%, #4f8eff 62%, #8fc1ff 100%);
  box-shadow: 0 28rpx 64rpx rgba(23, 86, 212, 0.18);
  color: #ffffff;
}

.hero-kicker {
  font-size: 24rpx;
  opacity: 0.86;
}

.hero-slogan {
  margin-top: 16rpx;
  font-size: 46rpx;
  line-height: 1.14;
  font-weight: 700;
  white-space: nowrap;
}

.hero-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-pill {
  min-width: 92rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  font-weight: 700;
}

.home-stage {
  min-height: 42vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transform: translateY(56rpx);
  transition: transform 280ms ease, min-height 280ms ease;
}

.home-stage--selected {
  min-height: auto;
  transform: translateY(0);
}

.home-title {
  margin-top: 34rpx;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #1c2b49;
  text-align: center;
}

.mode-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.mode-entry {
  flex: 1;
  position: relative;
  min-height: 318rpx;
  padding: 34rpx 26rpx 30rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  background: linear-gradient(180deg, #ffffff 0%, #edf4ff 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  transform: translateY(0) scale(1);
  transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
  box-shadow: 0 18rpx 36rpx rgba(20, 54, 122, 0.08);
}

.mode-entry--hover {
  transform: translateY(-4rpx) scale(0.985);
}

.mode-entry--active {
  border-color: rgba(21, 91, 255, 0.2);
  background: linear-gradient(180deg, rgba(21, 91, 255, 0.18) 0%, rgba(21, 91, 255, 0.06) 100%);
  box-shadow: 0 24rpx 46rpx rgba(21, 91, 255, 0.14);
}

.mode-entry-inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.mode-entry-mark {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  min-width: 70rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(21, 91, 255, 0.12);
  color: #155bff;
  font-size: 20rpx;
  font-weight: 700;
}

.mode-entry-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1d2c49;
  text-align: left;
}

.mode-entry-accent {
  margin-top: 26rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #155bff;
  font-weight: 700;
}

.mode-entry-subtitle {
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6e7f9f;
}

.demand-panel {
  margin-top: 24rpx;
  padding: 32rpx 28rpx 30rpx;
  opacity: 0;
  transform: translateY(28rpx);
}

.demand-panel--show {
  opacity: 1;
  transform: translateY(0);
  animation: demandRise 260ms ease;
}

.demand-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.demand-mode-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(21, 91, 255, 0.1);
  color: #155bff;
  font-size: 22rpx;
  font-weight: 700;
}

.demand-mini-mark {
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #eef4ff;
  color: #5b6f94;
  font-size: 22rpx;
  font-weight: 700;
}

.demand-title {
  margin-top: 18rpx;
  font-size: 54rpx;
  line-height: 1.08;
  font-weight: 700;
  color: #1c2b49;
  white-space: nowrap;
}

.demand-search {
  margin-top: 26rpx;
  padding: 14rpx 12rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #f7fbff 0%, #edf5ff 100%);
  box-shadow: inset 0 0 0 2rpx rgba(21, 91, 255, 0.08), 0 18rpx 36rpx rgba(21, 91, 255, 0.08);
}

.example-head {
  margin-top: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #60749b;
}

.example-list {
  margin-top: 16rpx;
}

.example-card {
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #f4f8ff 100%);
  color: #304266;
  font-size: 24rpx;
  line-height: 1.65;
  transition: transform 180ms ease, box-shadow 180ms ease;
  box-shadow: inset 0 0 0 2rpx rgba(29, 93, 255, 0.04);
}

.example-card + .example-card {
  margin-top: 14rpx;
}

.example-card--hover {
  transform: scale(0.99);
}

.demand-btn {
  margin-top: 28rpx;
  width: 100%;
}

.prompt-popup {
  height: 78vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 24rpx 0;
}

.prompt-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d2c49;
}

.prompt-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: 12rpx;
}

.prompt-block {
  margin-top: 28rpx;
}

.prompt-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #243453;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f7ff;
  color: #56709f;
  font-size: 24rpx;
}

.chip--active {
  background: linear-gradient(135deg, #155bff 0%, #4d8dff 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(21, 91, 255, 0.16);
}

.number-wrap {
  margin-top: 14rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f8fbff;
}

.popup-btn {
  flex: 1;
}

.popup-cta-bar {
  margin-top: 18rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

@keyframes demandRise {
  0% {
    opacity: 0;
    transform: translateY(16rpx) scale(0.98);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
