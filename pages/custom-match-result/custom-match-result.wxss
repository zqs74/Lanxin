/* custom-match-result.wxss - 昇梦体育 主题适配 赛果展示&分析报告页 */
.page-wrapper { position: relative; min-height: 100vh; padding-bottom: 240rpx; }
.container { padding: 48rpx 30rpx 20rpx; min-height: 100vh; position: relative; z-index: 1; }

.top-nav { margin-bottom: 32rpx; }
.nav-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.back-btn { display: flex; align-items: center; justify-content: center; padding: 16rpx; transition: all 0.3s ease; }
.back-btn:hover { transform: translateX(-4rpx); }
.back-icon { width: 48rpx; height: 48rpx; }
.nav-title { font-size: 36rpx; font-weight: 800; color: var(--text-primary); }
.nav-placeholder { width: 72rpx; }

.final-score-card { padding: 40rpx 32rpx; border-radius: 32rpx; margin-bottom: 32rpx; text-align: center; }
.score-header { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin-bottom: 28rpx; }
.match-label { font-size: 28rpx; color: var(--text-secondary); font-weight: 500; }
.status-badge { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 20rpx; border-radius: 20rpx; }
.status-badge.completed { background: linear-gradient(135deg, rgba(212,175,55,0.15) 0%, rgba(255,215,0,0.1) 100%); border: 1rpx solid rgba(212,175,55,0.3); }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--gold); }
.status-text { font-size: 22rpx; color: var(--gold); font-weight: 600; }

.final-score-display { margin-bottom: 32rpx; }
.final-total { font-size: 96rpx; font-weight: 900; background: var(--gold-gradient-full); -webkit-background-clip: text; background-clip: text; color: transparent; line-height: 1.2; }
.score-unit { font-size: 28rpx; color: var(--text-secondary); font-weight: 500; display: block; margin-top: 8rpx; }

.match-meta { display: flex; align-items: center; justify-content: space-around; padding-top: 28rpx; border-top: 2rpx solid var(--border-divider); }
.meta-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.meta-label { font-size: 22rpx; color: var(--text-secondary); font-weight: 500; }
.meta-value { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.meta-divider { width: 2rpx; height: 48rpx; background: rgba(212,175,55,0.15); }

.section { margin-bottom: 36rpx; }
.section-title { font-size: 34rpx; font-weight: 800; color: var(--text-primary); margin-bottom: 24rpx; position: relative; letter-spacing: 1rpx; }
.section-title::before { content: ''; position: absolute; left: 0; bottom: -10rpx; width: 56rpx; height: 4rpx; background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%); border-radius: 2rpx; }

.ranking-list { display: flex; flex-direction: column; gap: 16rpx; }
.ranking-item { padding: 24rpx 28rpx; border-radius: 24rpx; display: flex; align-items: center; gap: 20rpx; transition: all 0.3s ease; position: relative; }
.ranking-item:hover { transform: translateX(8rpx); border-color: rgba(212,175,55,0.4); }
.ranking-item.top-rank { background: linear-gradient(145deg, rgba(212,175,55,0.12) 0%, rgba(255,215,0,0.06) 100%); border-color: rgba(212,175,55,0.35); box-shadow: 0 8rpx 32rpx rgba(212,175,55,0.15); }

.rank-badge { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--bg-card-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 2rpx solid var(--border-stat); }
.rank-badge.top1 { background: var(--gold-gradient); border-color: transparent; box-shadow: 0 4rpx 16rpx rgba(212,175,55,0.5); }
.rank-badge.top2 { background: linear-gradient(135deg, #C0C0C0 0%, #E8E8E8 100%); border-color: transparent; box-shadow: 0 4rpx 16rpx rgba(192,192,192,0.4); }
.rank-badge.top3 { background: linear-gradient(135deg, #CD7F32 0%, #DAa520 100%); border-color: transparent; box-shadow: 0 4rpx 16rpx rgba(205,127,50,0.4); }
.rank-number { font-size: 28rpx; font-weight: 800; color: var(--text-secondary); }
.rank-badge.top1 .rank-number, .rank-badge.top2 .rank-number, .rank-badge.top3 .rank-number { color: #0a0a0a; }

.rank-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; overflow: hidden; flex-shrink: 0; border: 3rpx solid rgba(212,175,55,0.25); }
.rank-avatar-img { width: 100%; height: 100%; }
.rank-avatar-placeholder { width: 100%; height: 100%; background: var(--bg-avatar-placeholder); display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 800; color: var(--gold); }

.rank-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.rank-name { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.rank-number-text { font-size: 22rpx; color: var(--text-secondary); font-weight: 500; }

.rank-stats { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.rank-score { font-size: 36rpx; font-weight: 900; background: var(--gold-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
.rank-percentage { font-size: 20rpx; color: var(--text-tertiary); font-weight: 500; }
.crown-icon { position: absolute; top: -10rpx; right: 20rpx; display: flex; align-items: center; justify-content: center; animation: float 3s ease-in-out infinite; }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12rpx); } }

.foul-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-bottom: 24rpx; }
.foul-stat { padding: 20rpx 16rpx; background: var(--bg-foul-stat); border-radius: 20rpx; text-align: center; border: 1rpx solid rgba(212,175,55,0.12); }
.foul-count { font-size: 36rpx; font-weight: 900; color: var(--gold); display: block; margin-bottom: 6rpx; }
.foul-label { font-size: 22rpx; color: var(--text-secondary); font-weight: 500; }
.foul-details { display: flex; flex-direction: column; gap: 12rpx; }
.foul-detail-item { padding: 18rpx 24rpx; border-radius: 18rpx; display: flex; align-items: center; gap: 16rpx; }

.foul-type-badge { padding: 8rpx 18rpx; border-radius: 14rpx; font-size: 22rpx; font-weight: 600; flex-shrink: 0; }
.foul-type-badge.foul { background: linear-gradient(135deg, rgba(250,173,20,0.2) 0%, rgba(255,197,61,0.15) 100%); color: #faad14; border: 1rpx solid rgba(250,173,20,0.35); }
.foul-type-badge.warning { background: linear-gradient(135deg, rgba(250,173,20,0.2) 0%, rgba(255,197,61,0.15) 100%); color: #ffc53d; border: 1rpx solid rgba(250,173,20,0.35); }
.foul-type-badge.freeThrow { background: linear-gradient(135deg, rgba(82,196,26,0.2) 0%, rgba(115,209,61,0.15) 100%); color: #52c41a; border: 1rpx solid rgba(82,196,26,0.35); }
.foul-type-badge.violation { background: linear-gradient(135deg, rgba(255,77,79,0.2) 0%, rgba(255,120,117,0.15) 100%); color: #ff4d4f; border: 1rpx solid rgba(255,77,79,0.35); }
.foul-player-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
.foul-player-name { font-size: 26rpx; color: var(--text-primary); font-weight: 600; }
.foul-time { font-size: 22rpx; color: var(--text-tertiary); font-weight: 500; }

.analysis-section { margin-top: 40rpx; }
.analysis-title, .icon-title { display: flex; align-items: center; gap: 12rpx; }
.title-icon { display: inline-flex; align-items: center; }
.analysis-card { padding: 28rpx 30rpx; border-radius: 28rpx; margin-bottom: 24rpx; }
.analysis-subtitle { font-size: 28rpx; font-weight: 700; color: var(--gold); margin-bottom: 24rpx; letter-spacing: 1rpx; }

.data-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.data-item { text-align: center; padding: 20rpx 12rpx; background: var(--bg-section); border-radius: 18rpx; border: 1rpx solid rgba(212,175,55,0.12); }
.data-value { font-size: 36rpx; font-weight: 900; color: var(--text-primary); display: block; margin-bottom: 8rpx; }
.data-value.highlight { background: var(--gold-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
.data-label { font-size: 20rpx; color: var(--text-secondary); font-weight: 500; }

.player-analysis-list { display: flex; flex-direction: column; gap: 24rpx; }
.player-analysis-item { padding-bottom: 24rpx; border-bottom: 1rpx solid var(--border-lighter); }
.player-analysis-item:last-child { border-bottom: none; padding-bottom: 0; }
.pa-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.pa-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.pa-name { font-size: 26rpx; font-weight: 700; color: var(--text-primary); }
.pa-number { font-size: 20rpx; color: var(--text-secondary); }
.pa-score-main { display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; }
.pa-score { font-size: 32rpx; font-weight: 900; color: var(--gold); }
.pa-percent { font-size: 18rpx; color: var(--text-tertiary); }

.progress-bar-container { height: 12rpx; background: var(--bg-input); border-radius: 6rpx; overflow: hidden; margin-bottom: 12rpx; }
.progress-bar { height: 100%; background: var(--gold-gradient); border-radius: 6rpx; transition: width 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }

.timeline { position: relative; padding-left: 40rpx; }
.timeline::before { content: ''; position: absolute; left: 16rpx; top: 0; bottom: 0; width: 3rpx; background: linear-gradient(to bottom, var(--gold) 0%, rgba(212,175,55,0.2) 100%); border-radius: 2rpx; }
.timeline-item { position: relative; padding-bottom: 28rpx; }
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot { position: absolute; left: -32rpx; top: 6rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--gold); border: 3rpx solid rgba(212,175,55,0.3); box-shadow: 0 0 12rpx rgba(212,175,55,0.4); }
.timeline-dot.score { background: #52c41a; border-color: rgba(82,196,26,0.3); box-shadow: 0 0 12rpx rgba(82,196,26,0.4); }
.timeline-dot.foul { background: #faad14; border-color: rgba(250,173,20,0.3); box-shadow: 0 0 12rpx rgba(250,173,20,0.4); }
.timeline-content { display: flex; flex-direction: column; gap: 6rpx; }
.timeline-time { font-size: 20rpx; color: var(--text-tertiary); font-weight: 500; }
.timeline-desc { font-size: 24rpx; color: var(--text-primary); font-weight: 600; line-height: 1.5; }

.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--bg-bottom-blur); backdrop-filter: blur(20rpx); display: flex; gap: 16rpx; z-index: 100; border-top: 1rpx solid var(--border-light); }
.btn-action { flex: 1; padding: 22rpx 24rpx; font-size: 24rpx; border-radius: 44rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.btn-icon { font-size: 28rpx; }

.team-vs-container { display: flex; align-items: center; justify-content: space-around; margin: 32rpx 0; padding: 24rpx 0; }
.team-score-block { flex: 1; padding: 20rpx; border-radius: 24rpx; text-align: center; }
.team-a-block { background: linear-gradient(135deg, rgba(255,77,79,0.12) 0%, rgba(255,120,117,0.08) 100%); border: 2rpx solid rgba(255,77,79,0.3); }
.team-b-block { background: linear-gradient(135deg, rgba(24,144,255,0.12) 0%, rgba(64,169,255,0.08) 100%); border: 2rpx solid rgba(24,144,255,0.3); }
.team-label-a { font-size: 26rpx; color: #ff4d4f; font-weight: 700; margin-bottom: 12rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.team-label-b { font-size: 26rpx; color: #1890ff; font-weight: 700; margin-bottom: 12rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.team-total-score { font-size: 56rpx; font-weight: 900; display: block; line-height: 1.2; }
.team-a-score { background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
.team-b-score { background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
.team-player-count { font-size: 22rpx; color: var(--text-secondary); font-weight: 500; margin-top: 8rpx; }

.vs-divider { width: 60rpx; height: 60rpx; border-radius: 50%; background: var(--bg-vs-divider); border: 2rpx solid rgba(212,175,55,0.3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.vs-text { font-size: 22rpx; font-weight: 800; color: var(--gold); }

.final-total-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; background: var(--bg-total-row); border-radius: 20rpx; margin-bottom: 20rpx; border: 1rpx solid var(--border-total-row); }
.final-total-label { font-size: 26rpx; color: var(--text-secondary); font-weight: 600; }
.final-total-value { font-size: 40rpx; font-weight: 900; background: var(--gold-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }

.team-section-a, .team-section-b { margin-bottom: 36rpx; }
.team-title-a { display: flex; align-items: center; gap: 12rpx; color: #ff4d4f !important; position: relative; }
.team-title-b { display: flex; align-items: center; gap: 12rpx; color: #1890ff !important; position: relative; }
.team-title-a::before { content: ''; position: absolute; left: 0; bottom: -10rpx; width: 48rpx; height: 4rpx; border-radius: 2rpx; background: linear-gradient(90deg, #ff4d4f 0%, #ff7875 100%); }
.team-title-b::before { content: ''; position: absolute; left: 0; bottom: -10rpx; width: 48rpx; height: 4rpx; border-radius: 2rpx; background: linear-gradient(90deg, #1890ff 0%, #40a9ff 100%); }
.team-icon { display: inline-flex; align-items: center; }
.team-subtotal { font-size: 24rpx; font-weight: 600; opacity: 0.8; margin-left: auto; }

.ranking-list.compact { gap: 12rpx; }
.compact-item { padding: 18rpx 20rpx; display: flex; align-items: center; gap: 16rpx; }
.compact-rank { display: flex; align-items: center; gap: 6rpx; width: 50rpx; flex-shrink: 0; }
.compact-number { font-size: 26rpx; font-weight: 800; color: var(--text-secondary); }
.compact-team { font-size: 18rpx; font-weight: 700; padding: 2rpx 10rpx; border-radius: 8rpx; }
.tag-a { background: rgba(255,77,79,0.2); color: #ff4d4f; }
.tag-b { background: rgba(24,144,255,0.2); color: #1890ff; }
.compact-info { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }
.compact-name { font-size: 24rpx; font-weight: 600; color: var(--text-primary); }
.compact-num { font-size: 20rpx; color: var(--text-tertiary); }
.compact-score { font-size: 28rpx; font-weight: 800; color: var(--gold); }

.foul-team-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.foul-team-stat { padding: 18rpx 20rpx; border-radius: 18rpx; display: flex; justify-content: space-between; align-items: center; }
.team-a-foul { background: linear-gradient(135deg, rgba(255,77,79,0.12) 0%, rgba(255,120,117,0.08) 100%); border: 1rpx solid rgba(255,77,79,0.25); }
.team-b-foul { background: linear-gradient(135deg, rgba(24,144,255,0.12) 0%, rgba(64,169,255,0.08) 100%); border: 1rpx solid rgba(24,144,255,0.25); }
.foul-team-label { font-size: 24rpx; font-weight: 600; color: var(--text-secondary); }
.foul-team-count { font-size: 28rpx; font-weight: 800; }
.team-a-foul .foul-team-count { color: #ff4d4f; }
.team-b-foul .foul-team-count { color: #1890ff; }

.foul-team-tag { font-size: 18rpx; font-weight: 800; padding: 2rpx 10rpx; border-radius: 6rpx; margin-right: 8rpx; flex-shrink: 0; }
.team-data-a .data-value { color: #ff4d4f !important; font-weight: 900; }
.team-data-b .data-value { color: #1890ff !important; font-weight: 900; }

.team-analysis-group { margin-bottom: 28rpx; }
.team-analysis-header { padding: 16rpx 20rpx; border-radius: 16rpx; font-size: 26rpx; font-weight: 700; margin-bottom: 16rpx; display: flex; align-items: center; gap: 8rpx; }
.team-a-header { background: linear-gradient(135deg, rgba(255,77,79,0.15) 0%, rgba(255,120,117,0.1) 100%); color: #ff4d4f; }
.team-b-header { background: linear-gradient(135deg, rgba(24,144,255,0.15) 0%, rgba(64,169,255,0.1) 100%); color: #1890ff; }

.pa-avatar-a { background: linear-gradient(135deg, rgba(255,77,79,0.2) 0%, rgba(255,120,117,0.15) 100%) !important; border-color: rgba(255,77,79,0.4) !important; }
.pa-avatar-b { background: linear-gradient(135deg, rgba(24,144,255,0.2) 0%, rgba(64,169,255,0.15) 100%) !important; border-color: rgba(24,144,255,0.4) !important; }
.pa-score-a .pa-score { color: #ff4d4f !important; }
.pa-score-b .pa-score { color: #1890ff !important; }
.progress-a .progress-bar { background: linear-gradient(90deg, #ff4d4f 0%, #ff7875 100%) !important; }
.progress-b .progress-bar { background: linear-gradient(90deg, #1890ff 0%, #40a9ff 100%) !important; }
.rank-a { background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%) !important; border-color: transparent !important; }
.rank-b { background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%) !important; border-color: transparent !important; }
.rank-score-a { background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%) !important; -webkit-background-clip: text !important; background-clip: text !important; color: transparent !important; }
.rank-score-b { background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%) !important; -webkit-background-clip: text !important; background-clip: text !important; color: transparent !important; }
