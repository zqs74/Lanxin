<!-- custom-match-result.wxml - 按A队B队分组显示 -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>

  <view class="container slide-up">
    <!-- 顶部导航 -->
    <view class="top-nav">
      <view class="nav-header">
        <view class="back-btn" bindtap="goBack">
          <image class="back-icon" src="/images/return.svg" mode="aspectFit"></image>
        </view>
        <view class="nav-title">赛果报告</view>
        <view class="nav-placeholder"></view>
      </view>
    </view>

    <!-- 最终比分卡片 - 显示A队B队总分对比 -->
    <view class="final-score-card card glass-effect">
      <view class="score-header">
        <text class="match-label">自定义比赛</text>
        <view class="status-badge completed">
          <text class="status-dot"></text>
          <text class="status-text">已完赛</text>
        </view>
      </view>

      <!-- A队 vs B队 对比显示 -->
      <view class="team-vs-container">
        <view class="team-score-block team-a-block">
          <view class="team-label-a">
            <t-icon class="team-icon" name="flag" size="26rpx" color="#ff4d4f" />
            A 队
          </view>
          <text class="team-total-score team-a-score">{{teamATotalScore}}</text>
          <text class="team-player-count">{{teamAPlayers.length}}人</text>
        </view>

        <view class="vs-divider">
          <text class="vs-text">VS</text>
        </view>

        <view class="team-score-block team-b-block">
          <view class="team-label-b">
            <t-icon class="team-icon" name="flag" size="26rpx" color="#1890ff" />
            B 队
          </view>
          <text class="team-total-score team-b-score">{{teamBTotalScore}}</text>
          <text class="team-player-count">{{teamBPlayers.length}}人</text>
        </view>
      </view>

      <view class="final-total-row">
        <text class="final-total-label">全场总分</text>
        <text class="final-total-value">{{finalTotalScore}}</text>
      </view>

      <view class="match-meta">
        <view class="meta-item">
          <text class="meta-label">比赛时长</text>
          <text class="meta-value highlight-time">{{matchDuration || '00:00:00'}}</text>
        </view>
        <view class="meta-divider"></view>
        <view class="meta-item">
          <text class="meta-label">操作次数</text>
          <text class="meta-value">{{actionLog.length}}次</text>
        </view>
      </view>
    </view>

    <!-- A队得分排行 -->
    <view wx:if="{{teamAPlayers.length > 0}}" class="section team-section-a">
      <view class="section-title team-title-a">
        <t-icon class="team-icon" name="flag" size="30rpx" color="#ff4d4f" />
        A 队得分排行
        <text class="team-subtotal">共 {{teamATotalScore}} 分</text>
      </view>
      <view class="ranking-list">
        <view 
          wx:for="{{teamARanking}}" 
          wx:key="id"
          class="ranking-item card team-a-item {{index === 0 ? 'top-rank' : ''}}"
        >
          <view class="rank-badge {{index < 3 ? 'top' + (index + 1) : ''}} rank-a">
            <text class="rank-number">{{index + 1}}</text>
          </view>

          <view class="rank-avatar">
            <image 
              wx:if="{{item.avatar}}" 
              src="{{item.avatar}}" 
              class="rank-avatar-img"
              mode="aspectFill"
            />
            <view wx:else class="rank-avatar-placeholder rank-avatar-a">
              <text>{{item.number}}</text>
            </view>
          </view>

          <view class="rank-info">
            <text class="rank-name">{{item.name}}</text>
            <text class="rank-number">#{{item.number}}</text>
          </view>

          <view class="rank-stats">
            <text class="rank-score rank-score-a">{{item.score}}分</text>
            <text class="rank-percentage">{{item.percentage}}%</text>
          </view>
          
          <view wx:if="{{index === 0}}" class="crown-icon">
            <t-icon name="star" size="40rpx" color="#D4AF37" />
          </view>
        </view>
      </view>
    </view>

    <!-- B队得分排行 -->
    <view wx:if="{{teamBPlayers.length > 0}}" class="section team-section-b">
      <view class="section-title team-title-b">
        <t-icon class="team-icon" name="flag" size="30rpx" color="#1890ff" />
        B 队得分排行
        <text class="team-subtotal">共 {{teamBTotalScore}} 分</text>
      </view>
      <view class="ranking-list">
        <view 
          wx:for="{{teamBRanking}}" 
          wx:key="id"
          class="ranking-item card team-b-item {{index === 0 ? 'top-rank' : ''}}"
        >
          <view class="rank-badge {{index < 3 ? 'top' + (index + 1) : ''}} rank-b">
            <text class="rank-number">{{index + 1}}</text>
          </view>

          <view class="rank-avatar">
            <image 
              wx:if="{{item.avatar}}" 
              src="{{item.avatar}}" 
              class="rank-avatar-img"
              mode="aspectFill"
            />
            <view wx:else class="rank-avatar-placeholder rank-avatar-b">
              <text>{{item.number}}</text>
            </view>
          </view>

          <view class="rank-info">
            <text class="rank-name">{{item.name}}</text>
            <text class="rank-number">#{{item.number}}</text>
          </view>

          <view class="rank-stats">
            <text class="rank-score rank-score-b">{{item.score}}分</text>
            <text class="rank-percentage">{{item.percentage}}%</text>
          </view>
          
          <view wx:if="{{index === 0}}" class="crown-icon">
            <t-icon name="star" size="40rpx" color="#D4AF37" />
          </view>
        </view>
      </view>
    </view>

    <!-- 全场总排行榜（可选） -->
    <view class="section">
      <view class="section-title icon-title">
        <t-icon class="title-icon" name="chart-bar" size="34rpx" color="#D4AF37" />
        全场得分总榜
      </view>
      <view class="ranking-list compact">
        <view 
          wx:for="{{playerRanking}}" 
          wx:key="id"
          class="ranking-item card compact-item {{item.team === 'A' ? 'team-a-border' : 'team-b-border'}}"
        >
          <view class="compact-rank">
            <text class="compact-number">{{index + 1}}</text>
            <text class="compact-team">{{item.team === 'A' ? 'A' : 'B'}}</text>
          </view>
          
          <view class="compact-info">
            <text class="compact-name">{{item.name}}</text>
            <text class="compact-num">#{{item.number}}</text>
          </view>

          <text class="compact-score">{{item.score}}分</text>
        </view>
      </view>
    </view>

    <!-- 判罚记录明细 -->
    <view wx:if="{{totalFouls > 0}}" class="section">
      <view class="section-title">判罚记录明细</view>
      
      <!-- 按队伍分组统计 -->
      <view class="foul-team-stats">
        <view class="foul-team-stat team-a-foul">
          <text class="foul-team-label">A队判罚</text>
          <text class="foul-team-count">{{teamAFouls}}</text>
        </view>
        <view class="foul-team-stat team-b-foul">
          <text class="foul-team-label">B队判罚</text>
          <text class="foul-team-count">{{teamBFouls}}</text>
        </view>
      </view>

      <view class="foul-summary">
        <view class="foul-stat">
          <text class="foul-count">{{foulStats.foul || 0}}</text>
          <text class="foul-label">犯规</text>
        </view>
        <view class="foul-stat">
          <text class="foul-count">{{foulStats.warning || 0}}</text>
          <text class="foul-label">警告</text>
        </view>
        <view class="foul-stat">
          <text class="foul-count">{{foulStats.freeThrow || 0}}</text>
          <text class="foul-label">罚球</text>
        </view>
        <view class="foul-stat">
          <text class="foul-count">{{foulStats.violation || 0}}</text>
          <text class="foul-label">违例</text>
        </view>
      </view>

      <view class="foul-details">
        <view 
          wx:for="{{allFouls}}" 
          wx:key="index"
          class="foul-detail-item card {{item.team === 'A' ? 'foul-a' : 'foul-b'}}"
        >
          <view class="foul-type-badge {{item.type}}">
            <text class="foul-type-text">{{item.typeName}}</text>
          </view>
          <view class="foul-player-info">
            <text class="foul-team-tag {{item.team === 'A' ? 'tag-a' : 'tag-b'}}">{{item.team === 'A' ? 'A' : 'B'}}</text>
            <text class="foul-player-name">{{item.playerName}}</text>
            <text class="foul-time">{{item.time}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分析报告区域 -->
    <view class="analysis-section">
      <view class="section-title analysis-title">
        <t-icon class="title-icon" name="chart-column" size="34rpx" color="#D4AF37" />
        赛事分析报告
      </view>

      <!-- 核心数据总览 - 包含A队B队对比 -->
      <view class="analysis-card card">
        <view class="analysis-subtitle">核心数据总览</view>
        <view class="data-grid enhanced">
          <view class="data-item data-item-main">
            <text class="data-value highlight">{{finalTotalScore}}</text>
            <text class="data-label">总得分</text>
          </view>
          <view class="data-item team-data-a">
            <text class="data-value team-a-val">{{teamATotalScore}}</text>
            <text class="data-label">A队得分</text>
          </view>
          <view class="data-item team-data-b">
            <text class="data-value team-b-val">{{teamBTotalScore}}</text>
            <text class="data-label">B队得分</text>
          </view>
          <view class="data-item">
            <text class="data-value">{{matchDuration || '00:00'}}</text>
            <text class="data-label">比赛时长</text>
          </view>
        </view>
      </view>

      <!-- 球员个人数据看板 - 按队伍分组 -->
      <view class="analysis-card card">
        <view class="analysis-subtitle">球员数据看板</view>
        
        <!-- A队球员数据 -->
        <view wx:if="{{teamAPlayers.length > 0}}" class="team-analysis-group">
          <view class="team-analysis-header team-a-header">
            <t-icon class="team-icon" name="flag" size="26rpx" color="#ff4d4f" />
            <text>A 队球员 ({{teamAPlayers.length}}人)</text>
          </view>
          <view class="player-analysis-list">
            <view 
              wx:for="{{teamAPlayers}}" 
              wx:key="id"
              class="player-analysis-item player-a-item"
            >
              <view class="pa-header">
                <view class="pa-avatar pa-avatar-a">
                  <image wx:if="{{item.avatar}}" src="{{item.avatar}}" class="pa-avatar-img" mode="aspectFill"/>
                  <view wx:else class="pa-avatar-placeholder"><text>{{item.number}}</text></view>
                </view>
                <view class="pa-info">
                  <text class="pa-name">{{item.name}}</text>
                  <text class="pa-number">#{{item.number}}</text>
                </view>
                <view class="pa-score-main pa-score-a">
                  <text class="pa-score">{{item.score}}分</text>
                  <text class="pa-percent">{{item.scorePercentage}}%</text>
                </view>
              </view>
              <view class="progress-bar-container progress-a">
                <view class="progress-bar progress-bar-a" style="width: {{item.scorePercentage}}%"></view>
              </view>
              <view wx:if="{{getPlayerFouls(item).total > 0}}" class="pa-fouls">
                <text class="pa-foul-text">判罚: {{getPlayerFouls(item).foul}}犯规 {{getPlayerFouls(item).warning}}警告</text>
              </view>
            </view>
          </view>
        </view>

        <!-- B队球员数据 -->
        <view wx:if="{{teamBPlayers.length > 0}}" class="team-analysis-group">
          <view class="team-analysis-header team-b-header">
            <t-icon class="team-icon" name="flag" size="26rpx" color="#1890ff" />
            <text>B 队球员 ({{teamBPlayers.length}}人)</text>
          </view>
          <view class="player-analysis-list">
            <view 
              wx:for="{{teamBPlayers}}" 
              wx:key="id"
              class="player-analysis-item player-b-item"
            >
              <view class="pa-header">
                <view class="pa-avatar pa-avatar-b">
                  <image wx:if="{{item.avatar}}" src="{{item.avatar}}" class="pa-avatar-img" mode="aspectFill"/>
                  <view wx:else class="pa-avatar-placeholder"><text>{{item.number}}</text></view>
                </view>
                <view class="pa-info">
                  <text class="pa-name">{{item.name}}</text>
                  <text class="pa-number">#{{item.number}}</text>
                </view>
                <view class="pa-score-main pa-score-b">
                  <text class="pa-score">{{item.score}}分</text>
                  <text class="pa-percent">{{item.scorePercentage}}%</text>
                </view>
              </view>
              <view class="progress-bar-container progress-b">
                <view class="progress-bar progress-bar-b" style="width: {{item.scorePercentage}}%"></view>
              </view>
              <view wx:if="{{getPlayerFouls(item).total > 0}}" class="pa-fouls">
                <text class="pa-foul-text">判罚: {{getPlayerFouls(item).foul}}犯规 {{getPlayerFouls(item).warning}}警告</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 关键时刻时间线 -->
      <view wx:if="{{keyMoments.length > 0}}" class="analysis-card card">
        <view class="analysis-subtitle">关键时刻记录</view>
        <view class="timeline">
          <view wx:for="{{keyMoments}}" wx:key="index" class="timeline-item">
            <view class="timeline-dot {{item.type}}"></view>
            <view class="timeline-content">
              <text class="timeline-time">{{item.time}}</text>
              <text class="timeline-desc">{{item.description}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作按钮 -->
    <view class="bottom-actions">
      <button class="btn btn-ghost btn-action" bindtap="saveReport">
        <t-icon class="btn-icon" name="save" size="28rpx" color="#D4AF37" />
        保存报告
      </button>
      
      <button class="btn btn-primary btn-action" bindtap="shareResult">
        <t-icon class="btn-icon" name="share" size="28rpx" color="#0a0a0a" />
        分享赛果
      </button>
      
      <button class="btn btn-success btn-action" bindtap="goHome">
        <t-icon class="btn-icon" name="home" size="28rpx" color="#0a0a0a" />
        返回首页
      </button>
    </view>
  </view>
</view>
