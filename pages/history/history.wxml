<view class="app-shell page-shell">
  <view class="section-card" style="display:flex;align-items:center;justify-content:space-between;" bindtap="openAccount" hover-class="history-card--hover" hover-stay-time="80">
    <view style="font-size:28rpx;font-weight:600;color:#20304b;">账号与安全</view>
    <view style="font-size:24rpx;color:#7b89a7;">修改密码 · 退出登录 ›</view>
  </view>
  <view class="section-card history-section">
    <view class="section-head history-head">
      <view class="history-tag">
        <view class="history-tag-text">推荐记录</view>
        <view class="history-tag-count">{{recommendations.length}}</view>
      </view>
      <view wx:if="{{recommendations.length > 4}}" class="history-more-btn" bindtap="openRecommendationRecords">查看更多</view>
    </view>

    <block wx:if="{{recommendations.length}}">
      <view
        wx:for="{{previewRecommendations}}"
        wx:key="id"
        class="history-card"
        data-payload="{{item.payload}}"
        bindtap="reopenRecommendation"
        hover-class="history-card--hover"
        hover-stay-time="80"
      >
        <view class="history-top">
          <view class="history-title">
            <view class="mode-dot mode-dot--{{item.mode === 'pro_event' ? 'pro' : 'casual'}}"></view>
            <text class="history-title-text">{{item.title}}</text>
          </view>
          <view class="history-time">{{item.meta}}</view>
        </view>
        <view class="history-brief">{{item.brief}}</view>
        <view class="history-highlight">{{item.highlight}}</view>
        <view class="history-del" data-id="{{item.id}}" data-type="recommendation" catchtap="deleteItem">删除</view>
      </view>
    </block>
    <van-empty wx:else image="search" description="还没有历史推荐" />
  </view>

  <view class="section-card history-section">
    <view class="section-head history-head">
      <view class="history-tag">
        <view class="history-tag-text">预约记录</view>
        <view class="history-tag-count">{{bookings.length}}</view>
      </view>
      <view wx:if="{{bookings.length > 4}}" class="history-more-btn" bindtap="openBookingRecords">查看更多</view>
    </view>

    <block wx:if="{{bookings.length}}">
      <view
        wx:for="{{previewBookings}}"
        wx:key="id"
        class="history-card"
        data-id="{{item.id}}"
        bindtap="reopenBooking"
        hover-class="history-card--hover"
        hover-stay-time="80"
      >
        <view class="history-top">
          <view class="history-title">
            <view class="mode-dot mode-dot--{{item.mode === 'pro_event' ? 'pro' : 'casual'}}"></view>
            <text class="history-title-text">{{item.title}}</text>
          </view>
          <view class="history-time">{{item.meta}}</view>
        </view>
        <view class="history-brief">{{item.brief}}</view>
        <view class="history-highlight">{{item.highlight}}</view>
        <view class="history-del" data-id="{{item.id}}" data-type="booking" catchtap="deleteItem">删除</view>
      </view>
    </block>
    <van-empty wx:else image="search" description="还没有预约记录" />
  </view>
</view>
