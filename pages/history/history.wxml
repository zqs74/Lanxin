<view class="app-shell page-shell">
  <view class="section-card">
    <view class="section-title">推荐记录</view>
    <block wx:if="{{recommendations.length}}">
      <view
        wx:for="{{recommendations}}"
        wx:key="id"
        class="history-card"
        data-payload="{{item.payload}}"
        bindtap="reopenRecommendation"
      >
        <view class="history-top">
          <view class="history-title">{{item.title}}</view>
          <view class="history-time">{{item.meta}}</view>
        </view>
      </view>
    </block>
    <van-empty wx:else image="search" description="还没有历史方案" />
  </view>

  <view class="section-card">
    <view class="section-title">预约记录</view>
    <block wx:if="{{bookings.length}}">
      <view wx:for="{{bookings}}" wx:key="id" class="history-card">
        <view class="history-top">
          <view class="history-title">{{item.title}}</view>
          <view class="history-time">{{item.meta}}</view>
        </view>
      </view>
    </block>
    <van-empty wx:else image="search" description="还没有预约记录" />
  </view>

  <glass-tabbar active="{{activeTab}}" />
</view>
