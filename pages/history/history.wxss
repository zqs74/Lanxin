.page-shell {
  padding-bottom: 220rpx;
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.history-head .accent-heading {
  flex-shrink: 0;
}

.history-more-btn {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 700;
  color: #2b6dff;
  line-height: 1;
  white-space: nowrap;
}

.filter-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f7faff 0%, #f3f7ff 100%);
}

.filter-group + .filter-group {
  margin-top: 18rpx;
}

.filter-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #7383a6;
}

.filter-scroll {
  margin-top: 14rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.filter-chip {
  min-width: 96rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #627596;
  font-size: 22rpx;
  text-align: center;
  box-shadow: inset 0 0 0 2rpx rgba(29, 93, 255, 0.05);
}

.filter-chip--active {
  background: linear-gradient(135deg, #165bff 0%, #4d8dff 100%);
  color: #ffffff;
}

.history-card {
  padding: 24rpx 0;
}

.history-card + .history-card {
  border-top: 2rpx solid #eef3fb;
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.history-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2b49;
}

.history-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #7c8ba8;
}

.history-brief {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #243556;
}

.history-highlight {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #63779c;
}

.history-empty-inline {
  padding: 28rpx 0 6rpx;
  font-size: 24rpx;
  color: #7c8ba8;
}
