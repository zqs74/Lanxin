/* history.wxss - 历史方案页（科技感标签 + 高亮胶囊） */

.page-shell {
  padding-bottom: 220rpx;
}

.history-section + .history-section {
  margin-top: 24rpx;
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

/* 科技感分类标签：发光圆点 + 渐变胶囊 + 数量角标 */
.history-tag {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 22rpx 10rpx 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(29, 93, 255, 0.14) 0%, rgba(77, 141, 255, 0.05) 100%);
  border: 2rpx solid rgba(29, 93, 255, 0.2);
}

.history-tag::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: #2b8fff;
  box-shadow: 0 0 14rpx 3rpx rgba(43, 143, 255, 0.55);
}

.history-tag-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d5dff;
  letter-spacing: 3rpx;
}

.history-tag-count {
  min-width: 40rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1d5dff 0%, #4d8dff 100%);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.4;
  box-shadow: 0 6rpx 14rpx rgba(29, 93, 255, 0.3);
}

.history-more-btn {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 700;
  color: #2b6dff;
  line-height: 1;
  white-space: nowrap;
}

.history-card {
  padding: 24rpx 0;
}

.history-card + .history-card {
  border-top: 2rpx solid #eef3fb;
}

.history-card--hover {
  opacity: 0.92;
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.history-title {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.history-title-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2b49;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 模式圆点：半专业=蓝，野球=橙 */
.mode-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.mode-dot--pro {
  background: #2b8fff;
  box-shadow: 0 0 10rpx rgba(43, 143, 255, 0.55);
}

.mode-dot--casual {
  background: #ff8a2a;
  box-shadow: 0 0 10rpx rgba(255, 138, 42, 0.55);
}

.history-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #7c8ba8;
}

.history-brief {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #243556;
}

/* 重点信息：当时输入的一句话，小号灰字 */
.history-highlight {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7c8ba8;
}
