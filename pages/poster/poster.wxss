.poster-shell {
  overflow: hidden;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #145bff 0%, #4d8dff 23%, #eef4ff 23%, #f7faff 100%);
  box-shadow: 0 28rpx 70rpx rgba(17, 97, 255, 0.18);
}

.poster-top {
  padding: 42rpx 34rpx 48rpx;
  color: #ffffff;
}

.poster-kicker {
  font-size: 24rpx;
  opacity: 0.88;
}

.poster-title {
  margin-top: 16rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
}

.poster-summary {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.poster-score {
  margin-top: 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 700;
}

.poster-cover-card {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx;
  height: 340rpx;
  border-radius: 30rpx;
  box-shadow: 0 20rpx 44rpx rgba(24, 76, 170, 0.12);
}

.poster-cover-image {
  width: 100%;
  height: 100%;
}

.poster-cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(19, 41, 90, 0.06) 0%, rgba(19, 41, 90, 0.76) 100%);
}

.poster-cover-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 28rpx 30rpx;
}

.poster-cover-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 700;
  color: #ffffff;
}

.poster-cover-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.9);
}

.poster-card {
  margin: 20rpx 24rpx 0;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 44rpx rgba(24, 76, 170, 0.08);
}

.poster-row-label {
  font-size: 22rpx;
  color: #7d8cb1;
}

.poster-row-label--light {
  color: rgba(255, 255, 255, 0.88);
}

.poster-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.poster-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(29, 93, 255, 0.08);
  color: #1d5dff;
  font-size: 20rpx;
}

.poster-tag--light {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
}

.poster-summary-line {
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 700;
}

.poster-summary-accent {
  color: #1d5dff;
}

.poster-summary-body {
  color: #1e2d49;
}

.poster-summary-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #667a9c;
}

.poster-focus-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.poster-focus-item {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #f4f8ff 100%);
}

.poster-focus-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #5d7fcb;
}

.poster-focus-value {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 700;
  color: #223351;
}

.poster-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 18rpx 24rpx 0;
}

.poster-mini-card {
  min-height: 138rpx;
  padding: 24rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
}

.poster-mini-label {
  font-size: 22rpx;
  color: #7c8cab;
}

.poster-mini-value {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  font-weight: 700;
  color: #21324f;
}

.poster-bottom-card {
  margin: 18rpx 24rpx 26rpx;
  padding: 28rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #0f49c7 0%, #2b73ff 100%);
  color: #ffffff;
}

.poster-bottom-title {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.poster-bottom-sub {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.84);
}

.cta-btn {
  flex: 1;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 720rpx;
  height: 1680rpx;
}
