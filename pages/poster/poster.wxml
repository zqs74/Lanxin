<view class="app-shell" wx:if="{{poster}}">
  <view class="poster-shell">
    <view class="poster-top">
      <view class="poster-kicker">东莞篮球约战</view>
      <view class="poster-title">{{poster.title}}</view>
      <view class="poster-summary">{{poster.modeLabel}} · {{poster.town}} · {{poster.date}}</view>
      <view class="poster-score">{{poster.matchScore}} 分匹配</view>
    </view>

    <view class="poster-cover-card">
      <image class="poster-cover-image" src="{{poster.venueCover}}" mode="aspectFill"></image>
      <view class="poster-cover-mask"></view>
      <view class="poster-cover-body">
        <view class="poster-row-label poster-row-label--light">推荐场馆</view>
        <view class="poster-cover-title">{{poster.venue}}</view>
        <view class="poster-cover-note">{{poster.planTone}}</view>
        <view class="poster-tags">
          <text wx:for="{{poster.tags}}" wx:key="*this" class="poster-tag poster-tag--light">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="poster-card">
      <view class="poster-row-label">方案摘要</view>
      <view class="poster-summary-line">
        <text class="poster-summary-accent">{{poster.summaryLead}}</text>
        <text class="poster-summary-body">{{poster.summaryTail}}</text>
      </view>
      <view class="poster-summary-note">{{poster.summaryNote}}</view>
    </view>

    <view class="poster-card">
      <view class="poster-row-label">方案重点</view>
      <view class="poster-focus-list">
        <view wx:for="{{poster.highlightPoints}}" wx:key="label" class="poster-focus-item">
          <view class="poster-focus-label">{{item.label}}</view>
          <view class="poster-focus-value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="poster-grid">
      <view class="poster-mini-card">
        <view class="poster-mini-label">预算落点</view>
        <view class="poster-mini-value">{{poster.budgetFocus}}</view>
      </view>
      <view class="poster-mini-card">
        <view class="poster-mini-label">预算参考</view>
        <view class="poster-mini-value">{{poster.budgetHint}}</view>
      </view>
      <view class="poster-mini-card" wx:if="{{poster.refereeLine}}">
        <view class="poster-mini-label">裁判配置</view>
        <view class="poster-mini-value">{{poster.refereeLine}}</view>
      </view>
      <view class="poster-mini-card" wx:if="{{poster.materialLine}}">
        <view class="poster-mini-label">物料建议</view>
        <view class="poster-mini-value">{{poster.materialLine}}</view>
      </view>
      <view class="poster-mini-card" wx:if="{{poster.rentalLine}}">
        <view class="poster-mini-label">租赁建议</view>
        <view class="poster-mini-value">{{poster.rentalLine}}</view>
      </view>
      <view class="poster-mini-card" wx:if="{{poster.supplierLine}}">
        <view class="poster-mini-label">供应商</view>
        <view class="poster-mini-value">{{poster.supplierLine}}</view>
      </view>
      <view class="poster-mini-card" wx:if="{{poster.mediaLine}}">
        <view class="poster-mini-label">媒体</view>
        <view class="poster-mini-value">{{poster.mediaLine}}</view>
      </view>
    </view>

    <view class="poster-bottom-card">
      <view class="poster-bottom-title">打开小程序可继续查看完整方案</view>
      <view class="poster-bottom-sub">资源仅供参考，档期与服务需另行确认</view>
    </view>
  </view>

  <view class="cta-bar">
    <button class="secondary-btn cta-btn" open-type="share">小程序转发</button>
    <button class="primary-btn cta-btn" bindtap="savePoster">{{saving ? '导出中...' : '保存海报'}}</button>
  </view>

  <painter palette="{{palette}}" widthPixels="{{2000}}" bind:imgOK="onImgOK" bind:imgErr="onImgErr" class="poster-painter" />
</view>

<!-- On-demand WeChat privacy authorization; hidden during normal page use. -->
<view wx:if="{{privacyVisible}}" catchtouchmove="privacyNoop" style="position:fixed;top:0;right:0;bottom:0;left:0;z-index:10000;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;">
  <view class="section-card" style="width:600rpx;margin:0;padding:32rpx;display:flex;flex-direction:column;gap:24rpx;">
    <view class="section-title">请阅读并同意隐私保护指引</view>
    <button class="secondary-btn" style="width:100%;height:auto;min-height:88rpx;white-space:normal;line-height:1.5;padding:16rpx;" bindtap="openPrivacyContract">{{privacyContractName}}</button>
    <button id="bansai-privacy-agree" class="primary-btn" style="width:100%;" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacyAuthorization">同意并继续</button>
    <button class="secondary-btn" style="width:100%;" bindtap="cancelPrivacyAuthorization">取消</button>
  </view>
</view>
