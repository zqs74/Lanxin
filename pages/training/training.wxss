/* training.wxss - 现代化UI设计 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: var(--spacing-md);
  min-height: 100vh;
  position: relative;
  z-index: 1;
  padding-bottom: 180rpx;
}

/* 页面标题 */
.page-header {
  margin-bottom: var(--spacing-xl);
  padding-top: var(--spacing-md);
  animation: slideUp 0.6s var(--transition-normal);
}

.page-title {
  font-size: var(--font-2xl);
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
  position: relative;
  display: inline-block;
}

.page-title::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 80%;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 2rpx;
}

.page-subtitle {
  font-size: var(--font-md);
  color: var(--text-secondary);
  opacity: 0.9;
  animation: slideUp 0.6s var(--transition-normal) 0.2s both;
}

/* 通用section样式 */
.section {
  margin-bottom: var(--spacing-xl);
  animation: slideUp 0.6s var(--transition-normal);
}

.section:nth-child(2) {
  animation-delay: 0.3s;
  animation-fill-mode: both;
}

.section:nth-child(3) {
  animation-delay: 0.4s;
  animation-fill-mode: both;
}

.section:nth-child(4) {
  animation-delay: 0.5s;
  animation-fill-mode: both;
}

.section:nth-child(5) {
  animation-delay: 0.6s;
  animation-fill-mode: both;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
  display: inline-block;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 3rpx;
}

.today-badge {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: var(--text-light);
  border-radius: 30rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.3);
  position: relative;
  overflow: hidden;
}

.today-badge::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.today-badge:hover::after {
  left: 100%;
}

.view-all-btn {
  font-size: var(--font-sm);
  color: var(--primary-color);
  font-weight: 500;
  transition: all var(--transition-normal);
  position: relative;
}

.view-all-btn::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, transparent 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.view-all-btn:hover::after {
  transform: scaleX(1);
}

.radar-score {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 600;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.1) 100%);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(68, 206, 255, 0.2);
}

/* 今日训练概览 */
.today-summary {
  padding: var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
  overflow: hidden;
}

.today-summary::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.05) 0%, rgba(89, 168, 255, 0.02) 100%);
  pointer-events: none;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  z-index: 1;
  padding: 20rpx;
  border-radius: var(--border-radius-md);
  transition: all var(--transition-normal);
}

.summary-item:hover {
  background: rgba(68, 206, 255, 0.05);
  transform: translateY(-2rpx);
}

.summary-icon {
  font-size: 40rpx;
  animation: float 3s ease-in-out infinite;
}

.summary-value {
  font-size: var(--font-lg);
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-family: 'Arial', sans-serif;
}

.summary-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  font-weight: 500;
  opacity: 0.9;
}

.summary-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(68, 206, 255, 0.3) 50%, transparent 100%);
}

/* 雷达图容器 */
.radar-container {
  padding: var(--spacing-md);
  position: relative;
  overflow: hidden;
  border-radius: var(--border-radius-xl);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.radar-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 20%, rgba(68, 206, 255, 0.08) 0%, transparent 50%),
              radial-gradient(circle at 80% 80%, rgba(89, 168, 255, 0.08) 0%, transparent 50%);
  pointer-events: none;
}

.radar-container::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.radar-container:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-medium);
}

.radar-container:hover::after {
  transform: scaleX(1);
}

.radar-chart {
  width: 100%;
  height: 450rpx;
  display: block;
  position: relative;
  z-index: 1;
  transition: transform 0.4s ease;
}

.radar-container:hover .radar-chart {
  transform: scale(1.02);
}

.radar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: var(--spacing-md);
  padding: 0 20rpx;
  position: relative;
  z-index: 1;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 45%;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: var(--border-radius-md);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border: 1rpx solid rgba(68, 206, 255, 0.2);
  position: relative;
  overflow: hidden;
}

.legend-item::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(68, 206, 255, 0.1) 50%, transparent 70%);
  transform: rotate(45deg);
  transition: left 0.6s ease;
  left: -100%;
}

.legend-item:hover {
  background: rgba(68, 206, 255, 0.1);
  transform: translateX(8rpx) translateY(-2rpx);
  border-color: rgba(68, 206, 255, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.2);
}

.legend-item:hover::after {
  left: 100%;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease;
}

.legend-item:hover .legend-dot {
  transform: scale(1.2);
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.4);
}

.legend-dot::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.8) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.legend-item:hover .legend-dot::after {
  left: 100%;
}

.legend-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  flex: 1;
  font-weight: 500;
  transition: color 0.3s ease;
}

.legend-item:hover .legend-text {
  color: var(--primary-color);
}

.legend-value {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--primary-color);
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.15) 0%, rgba(89, 168, 255, 0.15) 100%);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(68, 206, 255, 0.3);
  transition: all 0.3s ease;
}

.legend-item:hover .legend-value {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.4);
}

/* 训练计划列表 */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-item {
  padding: var(--spacing-md);
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
  border-radius: var(--border-radius-lg);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
}

.plan-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  transform: scaleY(0);
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.plan-item::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(68, 206, 255, 0.05) 50%, transparent 70%);
  transform: rotate(45deg);
  transition: left 0.6s ease;
  left: -100%;
}

.plan-item:hover {
  transform: translateX(8rpx) translateY(-2rpx);
  box-shadow: var(--shadow-medium);
}

.plan-item:hover::before {
  transform: scaleY(1);
}

.plan-item:hover::after {
  left: 100%;
}

.plan-item:active {
  transform: scale(0.98) translateX(8rpx) translateY(-2rpx);
}

.plan-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.15) 0%, rgba(89, 168, 255, 0.1) 100%);
  border-radius: var(--border-radius-md);
  border: 2rpx solid rgba(68, 206, 255, 0.3);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.plan-item:hover .plan-left {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  transform: scale(1.05);
  box-shadow: 0 6rpx 16rpx rgba(68, 206, 255, 0.4);
}

.plan-day {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text-primary);
  transition: color 0.3s ease;
  position: relative;
  z-index: 1;
}

.plan-item:hover .plan-day {
  color: white;
}

.plan-date {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-top: 4rpx;
  transition: color 0.3s ease;
  position: relative;
  z-index: 1;
}

.plan-item:hover .plan-date {
  color: rgba(255, 255, 255, 0.8);
}

.plan-center {
  flex: 1;
  position: relative;
  z-index: 1;
}

.plan-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  position: relative;
  display: inline-block;
  transition: color 0.3s ease;
}

.plan-item:hover .plan-title {
  color: var(--primary-color);
  text-shadow: 0 2rpx 4rpx rgba(68, 206, 255, 0.3);
}

.plan-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  opacity: 0.9;
  transition: color 0.3s ease;
}

.plan-item:hover .plan-desc {
  color: var(--text-primary);
}

.plan-right {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.plan-status {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.plan-status::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.plan-status:hover::after {
  left: 100%;
}

.plan-status.completed {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.15) 0%, rgba(115, 209, 61, 0.15) 100%);
  color: var(--secondary-color);
  border: 2rpx solid rgba(82, 196, 26, 0.4);
}

.plan-status.today {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: var(--text-light);
  box-shadow: 0 6rpx 20rpx rgba(68, 206, 255, 0.4);
  animation: pulse 2s ease-in-out infinite;
}

.plan-status.upcoming {
  background: linear-gradient(135deg, rgba(153, 153, 153, 0.15) 0%, rgba(170, 170, 170, 0.15) 100%);
  color: var(--text-tertiary);
  border: 2rpx solid rgba(153, 153, 153, 0.4);
}

.plan-status:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 训练记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  padding: var(--spacing-md);
  display: flex;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border-radius: var(--border-radius-lg);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
}

.record-item::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(68, 206, 255, 0.1) 100%);
  transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.record-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.record-item:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-medium);
}

.record-item:hover::before {
  width: 100%;
}

.record-item:hover::after {
  transform: scaleX(1);
}

.record-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 90rpx;
  padding: 16rpx 12rpx;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.15) 0%, rgba(89, 168, 255, 0.12) 100%);
  border-radius: var(--border-radius-md);
  border: 2rpx solid rgba(68, 206, 255, 0.3);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.record-item:hover .record-date {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  transform: scale(1.05);
  box-shadow: 0 6rpx 16rpx rgba(68, 206, 255, 0.4);
}

.record-date::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.record-item:hover .record-date::after {
  left: 100%;
}

.record-day {
  font-size: var(--font-lg);
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-family: 'Arial', sans-serif;
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
}

.record-item:hover .record-day {
  background: linear-gradient(135deg, white 0%, white 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.record-month {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: 2rpx;
  opacity: 0.9;
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
}

.record-item:hover .record-month {
  color: rgba(255, 255, 255, 0.8);
}

.record-content {
  flex: 1;
  position: relative;
  z-index: 1;
}

.record-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  position: relative;
  display: inline-block;
  transition: color 0.3s ease;
}

.record-item:hover .record-title {
  color: var(--primary-color);
  text-shadow: 0 2rpx 4rpx rgba(68, 206, 255, 0.3);
}

.record-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  background: rgba(68, 206, 255, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(68, 206, 255, 0.3);
  transition: all 0.3s ease;
}

.record-item:hover .meta-item {
  background: rgba(68, 206, 255, 0.15);
  border-color: rgba(68, 206, 255, 0.5);
  color: var(--primary-color);
}

.record-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.highlight-tag {
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.15) 0%, rgba(89, 168, 255, 0.12) 100%);
  color: var(--primary-color);
  font-size: var(--font-xs);
  border-radius: 16rpx;
  border: 2rpx solid rgba(68, 206, 255, 0.3);
  font-weight: 500;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.highlight-tag::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.highlight-tag:hover {
  transform: translateY(-2rpx);
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.4);
}

.highlight-tag:hover::after {
  left: 100%;
}

/* 快速训练 */
.quick-train-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.quick-train-item {
  padding: var(--spacing-lg) var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.quick-train-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.quick-train-item:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-medium);
}

.quick-train-item:hover::before {
  transform: scaleX(1);
}

.quick-train-item:active {
  transform: scale(0.96) translateY(-4rpx);
}

.quick-train-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.quick-train-icon::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.quick-train-item:hover .quick-train-icon {
  transform: scale(1.05) rotate(5deg);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2);
}

.quick-train-item:hover .quick-train-icon::after {
  left: 100%;
}

.quick-train-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  position: relative;
  z-index: 1;
}

.quick-train-time {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  position: relative;
  z-index: 1;
  opacity: 0.9;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease-out;
  backdrop-filter: blur(10rpx);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  width: 85%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--border-radius-xl);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: slideUp 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
  position: relative;
}

.modal-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
  border-bottom: 1rpx solid rgba(68, 206, 255, 0.1);
}

.modal-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
  display: inline-block;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-tertiary);
  border-radius: 50%;
  background: rgba(68, 206, 255, 0.08);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.modal-close::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(68, 206, 255, 0.2) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.modal-close:hover {
  background: rgba(68, 206, 255, 0.15);
  color: var(--primary-color);
}

.modal-close:hover::after {
  left: 100%;
}

.modal-close:active {
  transform: scale(0.95);
}

.modal-body {
  padding: var(--spacing-lg);
}

.form-item {
  margin-bottom: var(--spacing-lg);
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  display: block;
  position: relative;
}

.form-label::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 40rpx;
  height: 2rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, transparent 100%);
}

.form-input {
  width: 100%;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: var(--border-radius-md);
  font-size: var(--font-md);
  color: var(--text-primary);
  transition: all var(--transition-normal);
  box-sizing: border-box;
  line-height: 1.5;
  min-height: 88rpx;
  position: relative;
  z-index: 1;
}

.form-input:focus {
  border-color: var(--primary-color);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 6rpx rgba(68, 206, 255, 0.12);
  outline: none;
}

.form-input::placeholder {
  color: var(--text-tertiary);
  opacity: 0.7;
}

.intensity-selector {
  display: flex;
  gap: 10rpx;
}

.intensity-item {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: var(--border-radius-md);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 500;
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.intensity-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.intensity-item:hover {
  border-color: var(--primary-color);
  background: rgba(68, 206, 255, 0.05);
}

.intensity-item:hover::after {
  left: 100%;
}

.intensity-item.active {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: var(--text-light);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.3);
}

.intensity-item:active {
  transform: scale(0.96);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: var(--spacing-lg);
  border-top: 1rpx solid rgba(68, 206, 255, 0.1);
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: var(--font-md);
  font-weight: 600;
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.modal-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
  transition: left 0.6s ease;
}

.modal-btn:hover::after {
  left: 100%;
}

.modal-btn.cancel {
  background: rgba(68, 206, 255, 0.08);
  color: var(--primary-color);
  border: 1rpx solid rgba(68, 206, 255, 0.3);
}

.modal-btn.cancel:hover {
  background: rgba(68, 206, 255, 0.15);
}

.modal-btn.cancel:active {
  transform: scale(0.98);
}

.modal-btn.confirm {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: var(--text-light);
  box-shadow: 0 6rpx 20rpx rgba(68, 206, 255, 0.4);
}

.modal-btn.confirm:hover {
  box-shadow: 0 8rpx 24rpx rgba(68, 206, 255, 0.5);
  transform: translateY(-2rpx);
}

.modal-btn.confirm:active {
  transform: scale(0.98) translateY(0);
  box-shadow: 0 4rpx 16rpx rgba(68, 206, 255, 0.3);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: var(--spacing-sm);
  }
  
  .radar-chart {
    height: 350rpx;
  }
  
  .quick-train-grid {
    grid-template-columns: 1fr;
  }
  
  .legend-item {
    width: 100%;
  }
  
  .summary-item {
    padding: 12rpx;
  }
  
  .summary-icon {
    font-size: 32rpx;
  }
  
  .summary-value {
    font-size: var(--font-md);
  }
}

/* 加载动画 */
.loading-shimmer {
  animation: shimmer 2s ease-in-out infinite;
}

@keyframes shimmer {
  0% {
    background-position: -1000px 0;
  }
  100% {
    background-position: 1000px 0;
  }
}