/* training.wxss - 昇梦体育 主题适配 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 148rpx 30rpx 180rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.page-header {
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%);
  border-radius: 3rpx;
}

.today-badge {
  padding: 8rpx 20rpx;
  background: var(--gold-gradient);
  color: #1a1a1a;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(212,175,55,0.3);
}

.view-all-btn {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 500;
}

.radar-score {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.today-summary {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-icon {
  font-size: 40rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 800;
  background: var(--gold-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.summary-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.summary-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(212,175,55,0.3) 50%, transparent 100%);
}

.radar-container {
  padding: 24rpx;
  position: relative;
}

.radar-chart {
  width: 100%;
  height: 400rpx;
  display: block;
}

.radar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 45%;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
}

.legend-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--gold);
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plan-item {
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s ease;
}

.plan-item:active {
  transform: scale(0.98);
}

.plan-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
}

.plan-day {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.plan-date {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.plan-center {
  flex: 1;
}

.plan-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.plan-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.plan-right {
  display: flex;
  align-items: center;
}

.plan-status {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.plan-status.completed {
  background: linear-gradient(135deg, rgba(82,196,26,0.1) 0%, rgba(115,209,61,0.1) 100%);
  color: #52c41a;
  border: 2rpx solid rgba(82,196,26,0.3);
}

.plan-status.today {
  background: var(--gold-gradient);
  color: #1a1a1a;
  box-shadow: 0 4rpx 12rpx rgba(212,175,55,0.4);
}

.plan-status.upcoming {
  background: rgba(153,153,153,0.1);
  color: var(--text-secondary);
  border: 2rpx solid rgba(153,153,153,0.3);
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
}

.record-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 90rpx;
  padding: 16rpx 12rpx;
  background: var(--bg-record-date);
  border-radius: 16rpx;
  border: 2rpx solid var(--border-stat);
}

.record-day {
  font-size: 32rpx;
  font-weight: 800;
  background: var(--gold-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.record-month {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 2rpx;
}

.record-content {
  flex: 1;
}

.record-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.record-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.record-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.highlight-tag {
  padding: 6rpx 14rpx;
  background: var(--bg-tag);
  color: var(--gold);
  font-size: 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--border-stat);
  font-weight: 500;
}

.quick-train-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.quick-train-item {
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.quick-train-item:active {
  transform: scale(0.96);
}

.quick-train-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.35);
}

.quick-train-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.quick-train-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ===== 弹窗样式 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  width: 85%;
  max-width: 600rpx;
  background: var(--bg-modal);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  box-shadow: var(--shadow-modal);
  animation: slideUp 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
  border: 1rpx solid var(--border-stat);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border-divider);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-secondary);
  border-radius: 50%;
  background: rgba(212,175,55,0.08);
  transition: all 0.3s ease;
}

.modal-close:active {
  background: rgba(212,175,55,0.15);
  transform: scale(0.95);
}

.modal-body {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx 28rpx;
  background: var(--bg-input-form);
  border: 2rpx solid var(--border-input);
  border-radius: 14rpx;
  font-size: 26rpx;
  color: var(--text-content);
  transition: all 0.3s ease;
  box-sizing: border-box;
  line-height: 1.5;
  min-height: 88rpx;
}

.form-input:focus {
  border-color: var(--border-input-focus);
  background: var(--bg-input-form-focus);
  box-shadow: 0 0 0 6rpx rgba(212,175,55,0.12);
}

.intensity-selector {
  display: flex;
  gap: 10rpx;
}

.intensity-item {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  background: var(--bg-input-form);
  border: 2rpx solid var(--border-input);
  border-radius: 14rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
  transition: all 0.3s ease;
}

.intensity-item.active {
  background: var(--gold-gradient);
  color: #1a1a1a;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(212,175,55,0.3);
}

.intensity-item:active {
  transform: scale(0.96);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 32rpx;
  border-top: 1rpx solid var(--border-divider);
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.modal-btn.cancel {
  background: rgba(212,175,55,0.08);
  color: var(--gold);
}

.modal-btn.cancel:active {
  background: rgba(212,175,55,0.15);
  transform: scale(0.98);
}

.modal-btn.confirm {
  background: var(--gold-gradient);
  color: #1a1a1a;
  box-shadow: 0 6rpx 20rpx rgba(212,175,55,0.4);
}

.modal-btn.confirm:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(212,175,55,0.3);
}
