/* custom-match-setup.wxss - 球员信息配置页（支持双方队伍） */
.page-wrapper {
  position: relative;
  min-height: 100vh;
  padding-bottom: 240rpx;
}

.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.top-nav {
  margin-bottom: 32rpx;
}

.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(255, 215, 0, 0.1) 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.2);
  transition: all 0.3s ease;
}

.back-icon {
  font-size: 36rpx;
  color: #D4AF37;
  font-weight: bold;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.nav-placeholder {
  width: 72rpx;
}

.info-card {
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.info-icon {
  font-size: 48rpx;
}

.info-content {
  flex: 1;
}

.info-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #D4AF37;
  margin-bottom: 8rpx;
}

.info-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* ===== 队伍切换标签 ===== */
.team-tabs {
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.team-tab {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.team-tab.active {
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(255, 215, 0, 0.08) 100%);
}

.team-tab-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #999;
  transition: all 0.3s ease;
}

.team-tab.active .team-tab-text {
  color: #D4AF37;
}

.team-tab-count {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.tab-active-indicator {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%);
  border-radius: 2rpx;
}

.total-count {
  padding: 14rpx 20rpx;
  background: rgba(17, 17, 17, 0.9);
  border-radius: 16rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.total-label {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

.total-number {
  font-size: 26rpx;
  font-weight: 700;
  color: #D4AF37;
}

/* ===== 队伍区域 ===== */
.team-section {
  animation: fadeIn 0.3s ease-out;
}

.section-header-row {
  margin-bottom: 20rpx;
}

.team-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.team-badge.team-a {
  background: linear-gradient(135deg, rgba(255, 77, 79, 0.15) 0%, rgba(255, 120, 117, 0.1) 100%);
  border: 2rpx solid rgba(255, 77, 79, 0.35);
  color: #ff4d4f;
}

.team-badge.team-b {
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.15) 0%, rgba(64, 169, 255, 0.1) 100%);
  border: 2rpx solid rgba(24, 144, 255, 0.35);
  color: #1890ff;
}

.badge-icon {
  font-size: 28rpx;
}

.badge-text {
  letter-spacing: 1rpx;
}

/* ===== 球员列表（增大尺寸）===== */
.players-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.player-item {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  transition: all 0.3s ease;
}

.player-item:hover {
  transform: translateY(-2rpx);
  border-color: rgba(212, 175, 55, 0.35);
}

.player-item.team-a-item {
  border-left: 4rpx solid #ff4d4f;
}

.player-item.team-a-item:hover {
  border-color: rgba(255, 77, 79, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.15);
}

.player-item.team-b-item {
  border-left: 4rpx solid #1890ff;
}

.player-item.team-b-item:hover {
  border-color: rgba(24, 144, 255, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.15);
}

.player-index {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid rgba(212, 175, 55, 0.25);
  transition: all 0.3s ease;
}

.player-index.team-a-index {
  background: linear-gradient(135deg, rgba(255, 77, 79, 0.15) 0%, rgba(255, 120, 117, 0.1) 100%);
  border-color: rgba(255, 77, 79, 0.35);
}

.player-index.team-b-index {
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.15) 0%, rgba(64, 169, 255, 0.1) 100%);
  border-color: rgba(24, 144, 255, 0.35);
}

.index-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #D4AF37;
}

/* 球员头像 - 增大尺寸 */
.player-avatar-area {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
  cursor: pointer;
  border: 3rpx solid rgba(212, 175, 55, 0.3);
  transition: all 0.3s ease;
}

.player-avatar-area:hover {
  border-color: #D4AF37;
  box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.3);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, rgba(26, 26, 26, 1) 0%, rgba(17, 17, 17, 1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-number {
  font-size: 40rpx;
  font-weight: 800;
  color: #D4AF37;
}

.avatar-upload-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  padding: 4rpx 0;
  backdrop-filter: blur(8rpx);
}

/* 球员输入区 - 增大尺寸 */
.player-inputs {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.player-inputs.enlarged {
  gap: 18rpx;
}

.input-group {
  position: relative;
}

.input-field {
  width: 100%;
  padding: 22rpx 28rpx; /* 增加内边距 */
  background: rgba(17, 17, 17, 0.95);
  border: 2rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 18rpx; /* 增大圆角 */
  font-size: 28rpx; /* 增大字号 */
  color: #f5f5f5;
  transition: all 0.3s ease;
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  min-height: 72rpx; /* 最小高度 */
}

.input-large {
  padding: 24rpx 30rpx; /* 更大的内边距 */
  font-size: 30rpx; /* 更大的字体 */
  min-height: 80rpx; /* 更大的最小高度 */
  border-radius: 20rpx;
}

.input-field:focus {
  border-color: #D4AF37;
  background: rgba(22, 22, 22, 1);
  box-shadow:
    inset 0 2rpx 8rpx rgba(0, 0, 0, 0.3),
    0 0 0 4rpx rgba(212, 175, 55, 0.12);
  outline: none;
}

.input-field.error {
  border-color: #ff4d4f;
  animation: shake 0.4s ease;
}

.number-input {
  width: 65%; /* 增宽号码输入框 */
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

.error-hint {
  position: absolute;
  top: 100%;
  left: 0;
  font-size: 22rpx; /* 增大错误提示字号 */
  color: #ff4d4f;
  margin-top: 6rpx;
  font-weight: 500;
}

.delete-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 77, 79, 0.15) 0%, rgba(255, 120, 117, 0.1) 100%);
  border: 2rpx solid rgba(255, 77, 79, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.delete-btn:hover:not(.disabled) {
  background: linear-gradient(135deg, rgba(255, 77, 79, 0.25) 0%, rgba(255, 120, 117, 0.15) 100%);
  border-color: #ff4d4f;
  transform: scale(1.05);
}

.delete-btn.disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.delete-icon {
  font-size: 40rpx;
  color: #ff4d4f;
  font-weight: bold;
  line-height: 1;
}

/* ===== 新增球员按钮（按队伍）===== */
.btn-add-to-team {
  width: 100%;
  margin-top: 20rpx;
  padding: 26rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}

.btn-add-to-team.team-a-btn {
  background: linear-gradient(135deg, rgba(255, 77, 79, 0.12) 0%, rgba(255, 120, 117, 0.08) 100%);
  color: #ff4d4f;
  border: 2rpx solid rgba(255, 77, 79, 0.35);
}

.btn-add-to-team.team-a-btn:not(.disabled):hover {
  background: rgba(255, 77, 79, 0.18);
  transform: translateY(-3rpx);
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.25);
}

.btn-add-to-team.team-b-btn {
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.12) 0%, rgba(64, 169, 255, 0.08) 100%);
  color: #1890ff;
  border: 2rpx solid rgba(24, 144, 255, 0.35);
}

.btn-add-to-team.team-b-btn:not(.disabled):hover {
  background: rgba(24, 144, 255, 0.18);
  transform: translateY(-3rpx);
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.25);
}

.btn-add-to-team.disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.btn-plus {
  font-size: 36rpx;
  font-weight: bold;
}

/* ===== 底部操作区 ===== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 30rpx;
  background: linear-gradient(to top, rgba(10, 10, 10, 0.98) 0%, rgba(10, 10, 10, 0.92) 80%, transparent 100%);
  backdrop-filter: blur(20rpx);
  z-index: 100;
  border-top: 1rpx solid rgba(212, 175, 55, 0.15);
}

.btn-start-full {
  width: 100%;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 800;
}
