<!-- match.wxml -->
<view class="container">
  <!-- 搜索区 -->
  <view class="search-box">
    <input placeholder="请输入球队名称" class="search-input"></input>
  </view>

  <!-- 日期选择区 -->
  <view class="date-section">
    <view class="current-date">当前选择: {{ selectedDate }}</view>
    <view class="date-list">
      <view wx:for="{{ dateList }}" wx:key="index" class="date-item {{ item.isToday ? 'today' : '' }} {{ item.isSelected ? 'selected' : '' }}" bindtap="selectDate" data-date="{{ item.date }}">
        <view class="date-week">{{ item.week }}</view>
        <view class="date-day">{{ item.day }}</view>
        <view class="date-month">{{ item.month }}</view>
      </view>
    </view>
  </view>

  <!-- 比赛列表区 -->
  <view class="match-list">
    <!-- 比赛卡片1 -->
    <view class="match-card" bindtap="goToMatchDetail">
      <view class="match-header">
        <view class="match-time">16:30</view>
        <view class="match-venue">场地1</view>
      </view>
      <view class="match-status playing">比赛中</view>
      <view class="match-teams">
        <view class="team">
          <view class="shield-icon">🛡️</view>
          <view class="team-name">红队</view>
        </view>
        <view class="score">0:0</view>
        <view class="team">
          <view class="team-name">蓝队</view>
          <view class="shield-icon">🛡️</view>
        </view>
      </view>
    </view>

    <!-- 比赛卡片2 -->
    <view class="match-card" bindtap="goToMatchDetail">
      <view class="match-header">
        <view class="match-time">18:30</view>
        <view class="match-venue">场地2</view>
      </view>
      <view class="match-status">未开始</view>
      <view class="match-teams">
        <view class="team">
          <view class="shield-icon">🛡️</view>
          <view class="team-name">A队</view>
        </view>
        <view class="score">0:0</view>
        <view class="team">
          <view class="team-name">B队</view>
          <view class="shield-icon">🛡️</view>
        </view>
      </view>
    </view>
  </view>


</view>