<!-- match.wxml - 现代化UI设计 -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>

  <view class="container slide-up">
    <!-- 页面标题 -->
    <view class="page-header">
      <view class="page-title">赛事中心</view>
      <view class="page-subtitle">查看和管理你的比赛</view>
    </view>

    <!-- 搜索区 -->
    <view class="search-section">
      <view class="search-box card">
        <view class="search-icon"><t-icon name="search" size="30rpx" color="#D4AF37" /></view>
        <input placeholder="搜索球队名称..." class="search-input" placeholder-class="search-placeholder"></input>
      </view>
    </view>

    <!-- 日期选择区 -->
    <view class="date-section">
      <view class="section-header">
        <view class="section-title">选择日期</view>
      </view>
      <picker 
        mode="date" 
        value="{{ selectedDate }}" 
        start="2020-01-01" 
        end="2030-12-31" 
        bindchange="onDateChange"
      >
        <view class="date-picker card">
          <t-icon class="date-picker-icon" name="calendar" size="30rpx" color="#D4AF37" />
          <text class="date-picker-text">{{ selectedDate }}</text>
          <text class="date-picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 比赛列表区 -->
    <view class="match-section">
      <view class="section-header">
        <view class="section-title">今日比赛</view>
        <view class="match-count">2 场</view>
      </view>
      
      <view class="match-list">
        <!-- 比赛卡片1 -->
        <view class="match-card card" bindtap="goToMatchDetail">
          <view class="match-status-badge playing">
            <view class="status-dot"></view>
            比赛中
          </view>
          
          <view class="match-header">
            <view class="match-time">
              <t-icon class="time-icon" name="time" size="24rpx" color="#D4AF37" />
              16:30
            </view>
          </view>
          
          <view class="match-teams">
            <view class="team">
              <view class="team-shield red"><t-icon name="flag" size="34rpx" color="#ffffff" /></view>
              <view class="team-name">红队</view>
            </view>
            
            <view class="score-box">
              <view class="score">0 : 0</view>
            </view>
            
            <view class="team">
              <view class="team-name">蓝队</view>
              <view class="team-shield blue"><t-icon name="flag" size="34rpx" color="#ffffff" /></view>
            </view>
          </view>
          
          <view class="match-venue-bottom">
            <t-icon class="venue-icon" name="location" size="24rpx" color="#D4AF37" />
            场地1
          </view>
        </view>

        <!-- 比赛卡片2 -->
        <view class="match-card card" bindtap="goToMatchDetail">
          <view class="match-status-badge upcoming">
            未开始
          </view>
          
          <view class="match-header">
            <view class="match-time">
              <t-icon class="time-icon" name="time" size="24rpx" color="#D4AF37" />
              18:30
            </view>
          </view>
          
          <view class="match-teams">
            <view class="team">
              <view class="team-shield green"><t-icon name="flag" size="34rpx" color="#ffffff" /></view>
              <view class="team-name">A队</view>
            </view>
            
            <view class="score-box">
              <view class="score">0 : 0</view>
            </view>
            
            <view class="team">
              <view class="team-name">B队</view>
              <view class="team-shield orange"><t-icon name="flag" size="34rpx" color="#ffffff" /></view>
            </view>
          </view>
          
          <view class="match-venue-bottom">
            <t-icon class="venue-icon" name="location" size="24rpx" color="#D4AF37" />
            场地2
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 悬浮AI按钮 -->
  <float-ai-button></float-ai-button>
</view>
