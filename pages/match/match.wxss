/* match.wxss - 昇梦体育 主题适配 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 136rpx 28rpx 24rpx;
  position: relative;
  z-index: 1;
}

.page-header {
  margin-bottom: 28rpx;
  padding-top: 20rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.search-section {
  margin-bottom: 32rpx;
}

.search-box {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon {
  font-size: 32rpx;
  color: var(--gold);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-content);
}

.search-placeholder {
  color: var(--text-tertiary);
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 44rpx;
  height: 4rpx;
  background: var(--gold);
  border-radius: 2rpx;
}

.date-section {
  margin-bottom: 40rpx;
}

.date-picker {
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.date-picker-icon {
  font-size: 36rpx;
  color: var(--gold);
}

.date-picker-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.date-picker-arrow {
  font-size: 36rpx;
  color: var(--gold);
  font-weight: 300;
}

.match-section {
  margin-bottom: 0;
}

.match-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.match-card {
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}

.match-card::before {
  display: none;
}

.match-status-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  z-index: 1;
}

.match-status-badge.playing {
  background: rgba(82,196,26,0.12);
  color: #389e0d;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: none;
  border: 1rpx solid rgba(82,196,26,0.25);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #52c41a;
  border-radius: 50%;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.9); }
}

.match-status-badge.upcoming {
  background: rgba(153,153,153,0.12);
  color: var(--text-secondary);
  box-shadow: none;
  border: 1rpx solid rgba(153,153,153,0.2);
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.match-time {
  font-size: 26rpx;
  color: var(--text-label);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-icon {
  font-size: 24rpx;
}

.match-venue {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.venue-icon {
  font-size: 24rpx;
}

.match-teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.team {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.team:last-child {
  flex-direction: row-reverse;
}

.team-shield {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: none;
}

.team-shield.red { background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%); }
.team-shield.blue { background: linear-gradient(135deg, #D4AF37 0%, #FFD700 100%); }
.team-shield.green { background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%); }
.team-shield.orange { background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%); }

.team-name {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 700;
}

.score-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
}

.score {
  font-size: 44rpx;
  font-weight: 800;
  background: none;
  -webkit-background-clip: text;
  -webkit-text-fill-color: currentColor;
  background-clip: text;
  color: var(--text-primary);
  min-width: 120rpx;
  text-align: center;
}

.match-venue-bottom {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-divider);
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  position: relative;
  z-index: 1;
}

.date-list::-webkit-scrollbar { height: 6rpx; }
.date-list::-webkit-scrollbar-track { background: rgba(212,175,55,0.1); border-radius: 3rpx; }
.date-list::-webkit-scrollbar-thumb { background: rgba(212,175,55,0.3); border-radius: 3rpx; }
