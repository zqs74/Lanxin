/* match.wxss - 现代化UI设计 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 20rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* 页面标题 */
.page-header {
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #666;
}

/* 搜索区 */
.search-section {
  margin-bottom: 32rpx;
}

.search-box {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon {
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.search-placeholder {
  color: #aaa;
}

/* 通用section样式 */
.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #44ceff 0%, #59a8ff 100%);
  border-radius: 3rpx;
}

/* 日期选择区 */
.date-section {
  margin-bottom: 40rpx;
}

.date-picker {
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.date-picker-icon {
  font-size: 36rpx;
}

.date-picker-text {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.date-picker-arrow {
  font-size: 36rpx;
  color: #44ceff;
  font-weight: 300;
}

/* 比赛列表区 */
.match-section {
  margin-bottom: 0;
}

.match-count {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-card {
  padding: 28rpx;
  position: relative;
  overflow: hidden;
}

.match-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.03) 0%, rgba(89, 168, 255, 0.02) 100%);
  pointer-events: none;
}

.match-status-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 20rpx;
  font-weight: 600;
  z-index: 1;
}

.match-status-badge.playing {
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  color: white;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.4);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: white;
  border-radius: 50%;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.6;
    transform: scale(0.9);
  }
}

.match-status-badge.upcoming {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(250, 173, 20, 0.3);
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.match-time {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-icon {
  font-size: 24rpx;
}

.match-venue {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.venue-icon {
  font-size: 24rpx;
}

.match-teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.team {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.team:last-child {
  flex-direction: row-reverse;
}

.team-shield {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.team-shield.red {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
}

.team-shield.blue {
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
}

.team-shield.green {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
}

.team-shield.orange {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
}

.team-name {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 700;
}

.score-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
}

.score {
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  min-width: 120rpx;
  text-align: center;
}

.match-venue-bottom {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(68, 206, 255, 0.1);
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
  position: relative;
  z-index: 1;
}

/* 滚动条样式 */
.date-list::-webkit-scrollbar {
  height: 6rpx;
}

.date-list::-webkit-scrollbar-track {
  background: rgba(68, 206, 255, 0.1);
  border-radius: 3rpx;
}

.date-list::-webkit-scrollbar-thumb {
  background: rgba(68, 206, 255, 0.3);
  border-radius: 3rpx;
}

.date-list::-webkit-scrollbar-thumb:hover {
  background: rgba(68, 206, 255, 0.5);
}
