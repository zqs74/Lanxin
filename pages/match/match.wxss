/* match.wxss - 昇梦体育 赛事资讯报名 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 136rpx 28rpx 24rpx;
  position: relative;
  z-index: 1;
}

.page-header {
  margin-bottom: 28rpx;
  padding-top: 20rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 0;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.search-section {
  margin-bottom: 32rpx;
}

.search-box {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon {
  font-size: 32rpx;
  color: var(--gold);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-content);
}

.search-placeholder {
  color: var(--text-tertiary);
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  position: relative;
  letter-spacing: 0;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 44rpx;
  height: 4rpx;
  background: var(--gold);
  border-radius: 2rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ===== 资讯列表 ===== */
.news-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.news-card {
  padding: 24rpx 26rpx;
}

.news-card:active {
  transform: scale(0.99);
}

.news-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--gold);
  background: var(--bg-tag);
  border: 1rpx solid var(--border-stat);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.news-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  margin-bottom: 10rpx;
}

.news-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ===== 赛事列表 ===== */
.event-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.event-card {
  padding: 26rpx;
}

.event-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.event-group {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--gold);
  background: var(--bg-tag);
  border: 1rpx solid var(--border-stat);
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
}

.event-status {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
}

.event-status.open { background: rgba(82,196,26,0.12); color: #389e0d; border: 1rpx solid rgba(82,196,26,0.25); }
.event-status.urgent { background: rgba(250,173,20,0.12); color: #d48806; border: 1rpx solid rgba(250,173,20,0.3); }
.event-status.full { background: rgba(153,153,153,0.12); color: var(--text-secondary); border: 1rpx solid rgba(153,153,153,0.2); }

.event-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 0;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.event-meta-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
}

.event-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-divider);
}

.event-slots {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.register-btn {
  padding: 12rpx 34rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: var(--gold-gradient);
  color: #0a0a0a;
  box-shadow: 0 6rpx 18rpx rgba(212,175,55,0.35);
}

.register-btn:active {
  transform: scale(0.96);
}

.register-btn.done {
  background: rgba(82,196,26,0.12);
  color: #389e0d;
  border: 1rpx solid rgba(82,196,26,0.25);
  box-shadow: none;
}

/* ===== 弹层通用 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease-out;
}

.modal-panel {
  width: 100%;
  max-height: 82vh;
  background: var(--bg-modal);
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: var(--shadow-modal);
  animation: slideUp 0.28s ease-out;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.modal-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.4;
  letter-spacing: 0;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-tag);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.modal-meta {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 20rpx;
}

.modal-body {
  max-height: 50vh;
}

.modal-content {
  font-size: 28rpx;
  color: var(--text-content);
  line-height: 1.8;
  display: block;
}

/* ===== 赛事详情 ===== */
.event-detail-info {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 10rpx 0 30rpx;
}

.detail-row {
  display: flex;
  align-items: center;
}

.detail-label {
  width: 130rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.detail-register-btn {
  width: 100%;
}

/* ===== 报名表单 ===== */
.register-panel {
  max-height: 88vh;
}

.register-event-name {
  font-size: 26rpx;
  color: var(--gold);
  font-weight: 600;
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 22rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-label);
  margin-bottom: 12rpx;
}

.required {
  color: #ff4d4f;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  background: var(--bg-input);
  border: 2rpx solid var(--border-input);
  border-radius: 20rpx;
}

.picker-text {
  font-size: 28rpx;
  color: var(--text-primary-alt);
}

.textarea-field {
  height: 140rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 10rpx;
}
