.result-hero {
  padding-bottom: 38rpx;
  box-shadow: 0 30rpx 66rpx rgba(20, 79, 206, 0.2);
}

.hero-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-main {
  flex: 1;
}

.hero-city {
  font-size: 24rpx;
  opacity: 0.86;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 700;
}

.hero-brief {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.88);
}

.score-card {
  min-width: 136rpx;
  padding: 16rpx 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  text-align: center;
}

.score-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.score-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-pill {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
}

.summary-card {
  background: linear-gradient(180deg, #ffffff 0%, #f6f9ff 100%);
}

.summary-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.summary-badge {
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(29, 93, 255, 0.08);
  color: #1d5dff;
  font-size: 22rpx;
  font-weight: 700;
}

.summary-copy {
  margin-top: 22rpx;
  font-size: 34rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #1e2d49;
}

.summary-copy--accent {
  color: #1d5dff;
}

.summary-copy--body {
  color: #1e2d49;
}

.summary-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #607395;
}

.rematch-btn--inline {
  width: 252rpx;
  height: 78rpx;
  flex-shrink: 0;
  font-size: 24rpx;
}

.summary-metrics {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.metric-block {
  flex: 1;
  min-height: 180rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: inset 0 0 0 2rpx rgba(29, 93, 255, 0.05);
}

.metric-label {
  font-size: 22rpx;
  color: #8090ad;
}

.metric-value {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #273756;
}

.metric-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #7282a4;
}

.summary-focus-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.summary-focus-item {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: inset 0 0 0 2rpx rgba(29, 93, 255, 0.04);
}

.summary-focus-label {
  font-size: 22rpx;
  color: #5b7ed6;
  font-weight: 700;
}

.summary-focus-value {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #243556;
  font-weight: 700;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.resource-list {
  margin-top: 18rpx;
}

.resource-card {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f9fbff 0%, #f4f8ff 100%);
  box-shadow: inset 0 0 0 2rpx rgba(29, 93, 255, 0.04);
}

.resource-card + .resource-card {
  margin-top: 16rpx;
}

.resource-cover {
  width: 176rpx;
  height: 176rpx;
  border-radius: 20rpx;
  background: #dfe8f8;
  flex-shrink: 0;
}

.resource-body {
  flex: 1;
  min-width: 0;
}

.resource-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f3153;
}

.resource-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7d8cab;
}

.resource-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.resource-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(29, 93, 255, 0.08);
  color: #1d5dff;
  font-size: 20rpx;
}

.resource-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7282a4;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

.alt-card {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f8fbff;
}

.alt-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #22324f;
}

.alt-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #506587;
}

.cta-btn {
  flex: 1;
}

.popup-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 32rpx 24rpx 0;
}

.popup-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: 0;
}

.prompt-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1c2b49;
}

.tune-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8fbff;
}

.prompt-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #22324f;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chip {
  min-width: 112rpx;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #edf4ff;
  color: #57709d;
  font-size: 24rpx;
  text-align: center;
}

.chip--active {
  background: linear-gradient(135deg, #155bff 0%, #4d8dff 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(21, 91, 255, 0.16);
}

.number-wrap {
  margin-top: 18rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #ffffff;
}

.form-stack {
  margin-top: 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f9fbff;
}

.calendar-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 96rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #ebf1fb;
}

.calendar-field__label {
  flex-shrink: 0;
  width: 6em;
  font-size: 28rpx;
  color: #323233;
}

.calendar-field__value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #323233;
  font-weight: 600;
}

.calendar-field__value--placeholder {
  font-weight: 400;
  color: #c8c9cc;
}

.fallback-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f8fbff;
}

.fallback-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #20304c;
}

.fallback-check {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(29, 93, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.fallback-check--active {
  background: #1d5dff;
  border-color: #1d5dff;
}

.fallback-check-mark {
  width: 18rpx;
  height: 10rpx;
  border-left: 4rpx solid transparent;
  border-bottom: 4rpx solid transparent;
  transform: rotate(-45deg) translateY(-2rpx);
}

.fallback-check--active .fallback-check-mark {
  border-left-color: #ffffff;
  border-bottom-color: #ffffff;
}

.popup-btn {
  flex: 1;
}

.popup-bottom-bar {
  margin-top: 12rpx;
  padding-top: 18rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

/* —— A1：资源卡详情守卫 —— */

.resource-card--hover {
  opacity: 0.92;
  transform: scale(0.99);
}

.resource-card-cta {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(29, 93, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 22rpx;
  color: #1d5dff;
}

.resource-card-cta-arrow {
  font-size: 30rpx;
  color: #7d8cae;
  line-height: 1;
}

/* —— A3：场地预约 · 场馆信息卡 —— */

.booking-venue-card {
  position: relative;
  overflow: hidden;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f2f6ff;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.booking-venue-cover {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 18rpx;
  background: #dfe8f8;
}

.booking-venue-body {
  flex: 1;
  min-width: 0;
}

.booking-venue-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d2d4a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-venue-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6c7da3;
}

.booking-venue-tag {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(29, 93, 255, 0.1);
  color: #1d5dff;
  font-size: 20rpx;
}

/* —— 企业微信咨询悬浮球（小程序客服按钮，客服由“微信客服”接管） —— */

.app-shell .advisor-ball {
  position: fixed;
  right: 24rpx;
  bottom: 240rpx;
  z-index: 90;
  width: 108rpx;
  height: 108rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0d5eff 0%, #4d8dff 100%);
  box-shadow: 0 16rpx 36rpx rgba(18, 46, 99, 0.28);
  color: #ffffff;
  line-height: 1;
}

.advisor-ball::after {
  border: none;
}

.advisor-ball--hover {
  opacity: 0.9;
  transform: scale(0.96);
}

.advisor-ball-icon {
  font-size: 40rpx;
  line-height: 1.1;
}

.advisor-ball-text {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 700;
}
