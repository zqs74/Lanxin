<view class="app-shell" wx:if="{{result}}">
  <view class="page-hero result-hero">
    <view class="hero-row">
      <view class="hero-main">
        <view class="hero-city">{{mode === 'pro_event' ? '半专业赛事方案' : '野球约球方案'}}</view>
        <view class="hero-title">{{result.summary}}</view>
        <view class="hero-brief">{{result.strategyLine}}</view>
      </view>
      <view class="score-card">
        <text class="score-value">{{result.matchScore}}</text>
        <text class="score-label">匹配分</text>
      </view>
    </view>
    <view class="hero-meta">
      <view class="pill-tag hero-pill">{{demand.town || result.town}}</view>
      <view class="pill-tag hero-pill">{{result.demandMeta.venueLabel}}</view>
      <view class="pill-tag hero-pill">{{result.demandMeta.budgetLabel}}</view>
    </view>
  </view>

  <view class="section-card summary-card">
    <view class="summary-badge-row">
      <view class="summary-badge">主方案</view>
      <button class="primary-btn rematch-btn rematch-btn--inline" bindtap="openTunePanel">重新匹配需求</button>
    </view>

    <view class="summary-copy">
      <text class="summary-copy--accent">{{result.summaryLead}}</text>
      <text class="summary-copy--body">{{result.summaryTail}}</text>
    </view>

    <view class="summary-note">{{result.summaryNote}}</view>

    <view class="summary-metrics">
      <view class="metric-block">
        <view class="metric-label">预算落点</view>
        <view class="metric-value">{{result.budgetFocus}}</view>
        <view class="metric-desc">{{result.budgetHint}}</view>
      </view>
      <view class="metric-block">
        <view class="metric-label">方案调性</view>
        <view class="metric-value">{{result.planTone}}</view>
        <view class="metric-desc">{{result.sections[0].items[0].name}}</view>
      </view>
    </view>

    <view class="summary-focus-list">
      <view wx:for="{{result.highlightPoints}}" wx:key="label" class="summary-focus-item">
        <view class="summary-focus-label">{{item.label}}</view>
        <view class="summary-focus-value">{{item.value}}</view>
      </view>
    </view>
  </view>

  <block wx:if="{{result.sections.length}}">
    <view wx:for="{{result.sections}}" wx:for-item="section" wx:for-index="secIndex" wx:key="key" class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">{{section.title}}</view>
          <view class="section-subtitle">{{section.items.length > 1 ? '按当前需求优先级排序' : '当前主推荐配置'}}</view>
        </view>
      </view>
      <view class="resource-list">
        <view
          wx:for="{{section.items}}"
          wx:for-item="resource"
          wx:for-index="resIndex"
          wx:key="id"
          class="resource-card"
          bindtap="onResourceTap"
          hover-class="resource-card--hover"
          hover-stay-time="80"
        >
          <image wx:if="{{resource.cover || resource.avatar || resource.image}}" class="resource-cover" src="{{resource.cover || resource.avatar || resource.image}}" mode="aspectFill"></image>
          <view class="resource-body">
            <view class="resource-name">{{resource.name}}</view>
            <view class="resource-meta">{{resource.town || '东莞'}} · {{resource.level || resource.capacity || '推荐配置'}}</view>
            <view class="resource-tags">
              <text wx:for="{{resource.tags}}" wx:key="*this" class="resource-tag">{{item}}</text>
            </view>
            <view class="resource-desc">{{resource.description}}</view>
            <view class="resource-card-cta">
              <text>资源仅供参考，请自行核实</text>
              <text class="resource-card-cta-arrow">›</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="section-card" wx:if="{{result.alternatives.length}}">
    <view class="section-title">备选方向</view>
    <view wx:for="{{result.alternatives}}" wx:key="id" class="alt-card">
      <view class="alt-title">{{item.title}}</view>
      <view class="alt-subtitle">{{item.subtitle}}</view>
      <view class="tiny-text">{{item.reason}}</view>
    </view>
  </view>

  <view class="section-card" wx:if="{{result.fallbackMessage}}">
    <van-empty image="search" description="{{result.fallbackMessage}}" />
  </view>

  <view class="cta-bar">
    <button class="secondary-btn cta-btn" bindtap="openPoster">生成分享海报</button>
    <button class="primary-btn cta-btn" bindtap="openBooking">{{infoOnly ? '公开信息不支持代订' : '登记预约意向'}}</button>
  </view>

  <van-popup show="{{tuneVisible}}" round position="bottom" custom-style="height: 78vh; z-index: 5200;" bind:close="closeTunePanel">
    <view class="popup-panel">
      <view class="prompt-title">重新匹配需求</view>

      <scroll-view scroll-y class="popup-scroll">
        <view class="tune-card">
          <view class="prompt-label">镇区</view>
          <view class="chip-group">
            <view
              wx:for="{{townOptions}}"
              wx:key="*this"
              class="chip {{demand.town === item ? 'chip--active' : ''}}"
              data-key="town"
              data-value="{{item}}"
              bindtap="selectTuneValue"
            >
              {{item}}
            </view>
          </view>
        </view>

        <view class="tune-card">
          <view class="prompt-label">日期</view>
          <view class="chip-group">
            <view
              wx:for="{{dateOptions}}"
              wx:key="value"
              class="chip {{demand.playDate === item.value ? 'chip--active' : ''}}"
              data-key="playDate"
              data-value="{{item.value}}"
              bindtap="selectTuneValue"
            >
              {{item.label}}
            </view>
          </view>
        </view>

        <view class="tune-card">
          <view class="prompt-label">预算</view>
          <view class="chip-group">
            <view
              wx:for="{{budgetOptions}}"
              wx:key="value"
              class="chip {{demand.budgetLevel === item.value ? 'chip--active' : ''}}"
              data-key="budgetLevel"
              data-value="{{item.value}}"
              bindtap="selectTuneValue"
            >
              {{item.label}}
            </view>
          </view>
        </view>

        <view class="tune-card">
          <view class="prompt-label">参加人数</view>
          <view class="number-wrap">
            <van-field
              type="number"
              value="{{demand.peopleCount}}"
              data-key="peopleCount"
              placeholder="请输入人数"
              bind:change="onTuneNumberChange"
            />
          </view>
        </view>
      </scroll-view>

      <view class="cta-bar popup-bottom-bar">
        <button class="secondary-btn popup-btn" bindtap="closeTunePanel">取消</button>
        <button class="primary-btn popup-btn" bindtap="rematchResult">重新匹配</button>
      </view>
    </view>
  </van-popup>

  <van-popup show="{{bookingVisible}}" round position="bottom" custom-style="height: 78vh; z-index: 5200;" bind:close="closeBooking">
    <view class="popup-panel">
      <view class="prompt-title">登记意向，档期与服务待确认</view>

      <scroll-view scroll-y class="popup-scroll">
        <view class="booking-venue-card" wx:if="{{bookingVenue}}">
          <image class="booking-venue-cover" src="{{bookingVenue.cover || bookingVenue.avatar || bookingVenue.image}}" mode="aspectFill"></image>
          <view class="booking-venue-body">
            <view class="booking-venue-name">{{bookingVenue.name}}</view>
            <view class="booking-venue-meta">{{bookingVenue.town || '东莞'}} · {{bookingVenue.priceLevel || '价格面议'}}</view>
          </view>
          <view class="booking-venue-tag">主推场馆</view>
        </view>

        <view class="tune-card">
          <view class="prompt-label">办赛时段</view>
          <view class="chip-group">
            <view
              wx:for="{{timeSlots}}"
              wx:key="value"
              class="chip {{bookingForm.timeSlot === item.value ? 'chip--active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectTimeSlot"
            >
              {{item.label}}
            </view>
          </view>
        </view>

        <view class="form-stack">
          <van-field label="联系人" value="{{bookingForm.contactName}}" data-key="contactName" placeholder="怎么称呼你" bind:change="updateBookingField" />
          <van-field label="手机号" type="number" value="{{bookingForm.phone}}" data-key="phone" placeholder="用于处理意向及联系" bind:change="updateBookingField" />
          <van-field label="微信号" value="{{bookingForm.wechat}}" data-key="wechat" placeholder="选填，用于预约沟通" bind:change="updateBookingField" />
          <view class="calendar-field" bindtap="openBookingDateCalendar">
            <view class="calendar-field__label">办赛日期</view>
            <view class="calendar-field__value {{bookingForm.expectedDate ? '' : 'calendar-field__value--placeholder'}}">
              {{bookingForm.expectedDate || '请选择办赛日期'}}
            </view>
          </view>
          <van-field label="备注" value="{{bookingForm.remark}}" data-key="remark" type="textarea" autosize placeholder="仅填预约需求，勿填他人隐私" bind:change="updateBookingField" />
        </view>

        <view class="fallback-row" bindtap="toggleAcceptFallback">
          <view>
            <view class="fallback-title">可接受同档位替代方案</view>
          </view>
          <view class="fallback-check {{bookingForm.acceptFallback ? 'fallback-check--active' : ''}}">
            <view class="fallback-check-mark"></view>
          </view>
        </view>
      </scroll-view>

      <view class="cta-bar popup-bottom-bar">
        <button class="secondary-btn popup-btn" bindtap="closeBooking">暂不预约</button>
        <button class="primary-btn popup-btn" bindtap="submitBooking">提交意向待确认</button>
      </view>
    </view>
  </van-popup>

  <van-popup
    show="{{bookingDateCalendarVisible}}"
    round
    position="bottom"
    z-index="6200"
    custom-style="height: 76vh;"
    bind:close="closeBookingDateCalendar"
  >
    <van-calendar
      poppable="{{false}}"
      title="选择预约日期"
      color="#1d5dff"
      type="single"
      min-date="{{bookingCalendarMinDate}}"
      max-date="{{bookingCalendarMaxDate}}"
      default-date="{{bookingCalendarDefaultDate}}"
      bind:close="closeBookingDateCalendar"
      bind:confirm="confirmBookingDate"
    />
  </van-popup>

  <open-guide visible="{{guideVisible}}" bind:close="closeGuide" />
</view>

<!-- On-demand WeChat privacy authorization; hidden during normal page use. -->
<view wx:if="{{privacyVisible}}" catchtouchmove="privacyNoop" style="position:fixed;top:0;right:0;bottom:0;left:0;z-index:10000;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;">
  <view class="section-card" style="width:600rpx;margin:0;padding:32rpx;display:flex;flex-direction:column;gap:24rpx;">
    <view class="section-title">请阅读并同意隐私保护指引</view>
    <button class="secondary-btn" style="width:100%;height:auto;min-height:88rpx;white-space:normal;line-height:1.5;padding:16rpx;" bindtap="openPrivacyContract">{{privacyContractName}}</button>
    <button id="bansai-privacy-agree" class="primary-btn" style="width:100%;" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacyAuthorization">同意并继续</button>
    <button class="secondary-btn" style="width:100%;" bindtap="cancelPrivacyAuthorization">取消</button>
  </view>
</view>
