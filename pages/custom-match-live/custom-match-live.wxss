/* custom-match-live.wxss - 昇梦体育 主题适配 比赛进行中页面 */
.page-wrapper { position: relative; min-height: 100vh; padding-bottom: 170rpx; }
.container { padding: 28rpx 24rpx 20rpx; min-height: 100vh; position: relative; z-index: 1; }

.page-header { margin-bottom: 32rpx; padding-top: 20rpx; }
.page-title { font-size: 40rpx; font-weight: 800; color: var(--text-primary); margin-bottom: 8rpx; position: relative; }
.page-title::before { content: ''; position: absolute; left: 0; bottom: -8rpx; width: 48rpx; height: 6rpx; background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%); border-radius: 3rpx; }
.page-subtitle { font-size: 26rpx; color: var(--text-secondary); }

.top-status-bar { padding: 18rpx 22rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; gap: 16rpx; }
.status-left { display: flex; align-items: center; gap: 20rpx; flex-shrink: 0; }
.match-info { display: flex; flex-direction: column; gap: 6rpx; }
.match-title { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.status-badge { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 14rpx; border-radius: 18rpx; }
.status-badge.in-progress { background: linear-gradient(135deg, rgba(82,196,26,0.15) 0%, rgba(115,209,61,0.1) 100%); border: 1rpx solid rgba(82,196,26,0.3); }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #52c41a; animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
.status-text { font-size: 20rpx; color: #52c41a; font-weight: 600; }

.timer-display { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx; background: var(--bg-tag); border-radius: 20rpx; border: 1rpx solid rgba(212,175,55,0.3); flex-shrink: 0; }
.timer-icon { display: inline-flex; align-items: center; }
.timer-text { font-size: 30rpx; font-weight: 800; color: var(--gold); font-family: 'Courier New', monospace; letter-spacing: 2rpx; }

.score-hero { padding: 22rpx 26rpx; border-radius: 28rpx; display: grid; grid-template-columns: 120rpx 1fr 120rpx; align-items: center; gap: 16rpx; margin-bottom: 22rpx; }
.score-team { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.score-team-name { font-size: 36rpx; font-weight: 900; line-height: 1; }
.score-team.team-a .score-team-name { color: #ff4d4f; }
.score-team.team-b .score-team-name { color: #1890ff; }
.score-team-fouls { font-size: 20rpx; color: var(--text-secondary); font-weight: 600; padding: 4rpx 12rpx; border-radius: 12rpx; background: var(--bg-card-light); border: 1rpx solid var(--border-light); white-space: nowrap; transition: background 0.22s ease, border-color 0.22s ease, color 0.22s ease; }
.theme-dark .score-team-fouls { color: rgba(245,224,160,0.76); background: rgba(212,175,55,0.1); border-color: rgba(212,175,55,0.26); box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.06); }
.score-center { display: flex; align-items: baseline; justify-content: center; gap: 18rpx; }
.team-score { font-size: 64rpx; font-weight: 900; line-height: 1; }
.a-score { color: #ff4d4f; }
.b-score { color: #1890ff; }
.score-vs { font-size: 24rpx; color: var(--gold); font-weight: 800; }

.players-grid-section { margin-bottom: 20rpx; }
.grid-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; flex-wrap: wrap; gap: 12rpx; }
.grid-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); position: relative; }
.grid-title::before { content: ''; position: absolute; left: 0; bottom: -8rpx; width: 48rpx; height: 4rpx; background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%); border-radius: 2rpx; }
.player-count-info { font-size: 22rpx; color: var(--text-secondary); font-weight: 500; padding: 8rpx 18rpx; background: var(--bg-card-light); border-radius: 18rpx; border: 1rpx solid var(--border-light); }

.players-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.team-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; align-items: start; }
.team-column { display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.team-column-head { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 8rpx 4rpx 10rpx; border-bottom: 2rpx solid var(--border-lighter); }
.team-column-title { font-size: 28rpx; font-weight: 900; }
.team-column-a .team-column-title { color: #ff4d4f; }
.team-column-b .team-column-title { color: #1890ff; }
.team-column-meta { font-size: 20rpx; color: var(--text-secondary); font-weight: 700; white-space: nowrap; }

.player-row { min-height: 96rpx; padding: 12rpx 12rpx 12rpx 16rpx; border-radius: 18rpx; display: grid; grid-template-columns: 58rpx minmax(0, 1fr) 48rpx; align-items: center; gap: 10rpx; position: relative; overflow: visible; transition: all 0.22s ease; }
.player-row.team-a { border-left: 6rpx solid #ff4d4f; }
.player-row.team-b { border-left: 6rpx solid #1890ff; }
.player-row.selected { border-color: var(--gold); background: linear-gradient(145deg, rgba(212,175,55,0.12) 0%, rgba(255,215,0,0.06) 100%); box-shadow: var(--shadow-card-hover); }
.player-row-avatar { width: 58rpx; height: 58rpx; border-radius: 50%; position: relative; border: 2rpx solid rgba(212,175,55,0.28); }
.player-row-info { display: flex; flex-direction: column; gap: 2rpx; min-width: 0; }
.row-score { min-width: 44rpx; height: 44rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; background: var(--bg-card-light); border: 1rpx solid var(--border-light); color: var(--text-secondary); font-size: 26rpx; font-weight: 900; }
.row-score.has-score { color: var(--gold); }

.player-card { padding: 16rpx 14rpx 14rpx; border-radius: 20rpx; display: grid; grid-template-columns: 82rpx 1fr; grid-template-rows: auto auto; align-items: center; column-gap: 12rpx; row-gap: 8rpx; cursor: pointer; transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); position: relative; overflow: hidden; min-height: 146rpx; }
.player-card:hover { transform: translateY(-3rpx); border-color: var(--border-card-hover); box-shadow: var(--shadow-card-hover); }
.player-card.selected { border-color: var(--gold); background: linear-gradient(145deg, rgba(212,175,55,0.12) 0%, rgba(255,215,0,0.06) 100%); box-shadow: var(--shadow-card-hover); }
.player-card.team-a:hover, .player-card.team-a.selected { box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.45), 0 0 28rpx rgba(255,77,79,0.14); }
.player-card.team-b:hover, .player-card.team-b.selected { box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.45), 0 0 28rpx rgba(24,144,255,0.14); }
.team-strip { position: absolute; left: 0; top: 0; bottom: 0; width: 6rpx; }
.strip-a { background: linear-gradient(180deg, #ff4d4f 0%, #ff7875 100%); }
.strip-b { background: linear-gradient(180deg, #1890ff 0%, #40a9ff 100%); }

.card-avatar-area { width: 82rpx; height: 82rpx; border-radius: 50%; overflow: visible; position: relative; border: 3rpx solid rgba(212,175,55,0.3); transition: all 0.3s ease; grid-row: 1 / 3; }
.card-avatar-area.compact { width: 82rpx; height: 82rpx; }
.player-card:hover .card-avatar-area, .player-card.selected .card-avatar-area { border-color: var(--gold); box-shadow: 0 0 28rpx rgba(212,175,55,0.35); }
.card-avatar { width: 100%; height: 100%; border-radius: 50%; }
.card-avatar-placeholder { width: 100%; height: 100%; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.card-avatar-placeholder.A { background: linear-gradient(135deg, rgba(255,77,79,0.2) 0%, rgba(255,120,117,0.15) 100%); }
.card-avatar-placeholder.B { background: linear-gradient(135deg, rgba(24,144,255,0.2) 0%, rgba(64,169,255,0.15) 100%); }
.card-avatar-number { font-size: 24rpx; font-weight: 800; color: var(--gold); }

.foul-badge { position: absolute; top: -10rpx; right: -10rpx; min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: 18rpx; background: rgba(255,255,255,0.86); display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.18); z-index: 10; animation: badgePopIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); border: 2rpx solid rgba(212,175,55,0.5); font-size: 18rpx; font-weight: 900; line-height: 1; color: #2a2414; box-sizing: border-box; transition: background 0.22s ease, border-color 0.22s ease, color 0.22s ease, box-shadow 0.22s ease; }
.foul-badge.has-foul { background: linear-gradient(135deg, #F7D86A 0%, #D4AF37 100%); border-color: rgba(255,255,255,0.52); color: #16120a; box-shadow: 0 5rpx 14rpx rgba(212,175,55,0.28); }
.theme-dark .foul-badge { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.16); color: rgba(255,255,255,0.58); box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.36), inset 0 1rpx 0 rgba(255,255,255,0.08); backdrop-filter: blur(10rpx); }
.theme-dark .foul-badge.has-foul { background: rgba(212,175,55,0.18); border-color: rgba(245,210,92,0.62); color: #F6D76B; box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.38), 0 0 18rpx rgba(212,175,55,0.2), inset 0 1rpx 0 rgba(255,245,190,0.14); }
@keyframes badgePopIn { 0% { transform: scale(0) rotate(-180deg); opacity: 0; } 100% { transform: scale(1) rotate(0deg); opacity: 1; } }
.badge-score-large { font-size: 20rpx; font-weight: 900; color: #0a0a0a; }

.card-info { display: flex; flex-direction: column; align-items: flex-start; gap: 2rpx; text-align: left; min-width: 0; }
.card-name { font-size: 24rpx; font-weight: 800; color: var(--text-primary); max-width: 170rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-number { font-size: 19rpx; color: var(--text-secondary); font-weight: 700; }
.card-number.team-label-A { color: #ff4d4f; }
.card-number.team-label-B { color: #1890ff; }

.card-score-display { padding: 8rpx 16rpx; background: var(--bg-card-light); border-radius: 16rpx; border: 1rpx solid var(--border-light); min-width: 92rpx; text-align: center; justify-self: start; }
.score-value-large { font-size: 26rpx; font-weight: 900; color: var(--text-tertiary); transition: all 0.3s ease; }
.score-value-large.has-score { color: var(--gold); }

.action-log-section { margin-top: 32rpx; margin-bottom: 32rpx; }
.log-header { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 24rpx; background: var(--bg-card-light); border-radius: 20rpx; border: 1rpx solid var(--border-light); cursor: pointer; }
.log-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); flex: 1; }
.log-count { font-size: 22rpx; color: var(--gold); font-weight: 600; padding: 4rpx 16rpx; background: var(--bg-tag); border-radius: 14rpx; }
.log-toggle { font-size: 24rpx; color: var(--text-secondary); transition: transform 0.3s ease; }
.log-toggle.expanded { transform: rotate(180deg); }

.log-list { margin-top: 16rpx; max-height: 400rpx; overflow-y: auto; display: flex; flex-direction: column; gap: 12rpx; }
.log-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; background: var(--bg-section); border-radius: 16rpx; border-left: 4rpx solid transparent; }
.log-item .score { border-left-color: var(--gold); }
.log-item .foul { border-left-color: #faad14; }
.log-time { font-size: 22rpx; color: var(--text-tertiary); font-weight: 500; flex-shrink: 0; }
.log-content { flex: 1; }
.log-text { font-size: 24rpx; color: var(--text-primary); font-weight: 500; }

.action-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: var(--bg-overlay); backdrop-filter: blur(12rpx); z-index: 1000; display: flex; align-items: flex-end; justify-content: center; animation: fadeIn 0.3s ease; }
.action-panel { width: 100%; max-height: 72vh; background: var(--bg-card-flat); border-radius: 34rpx 34rpx 0 0; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); overflow-y: auto; animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }

.panel-header { display: flex; align-items: center; gap: 18rpx; margin-bottom: 20rpx; padding-bottom: 18rpx; border-bottom: 2rpx solid var(--border-divider); }
.panel-avatar { width: 90rpx; height: 90rpx; border-radius: 50%; overflow: hidden; border: 3rpx solid var(--gold); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.panel-avatar.A { background: linear-gradient(135deg, rgba(255,77,79,0.2) 0%, rgba(255,120,117,0.15) 100%); border-color: #ff4d4f; }
.panel-avatar.B { background: linear-gradient(135deg, rgba(24,144,255,0.2) 0%, rgba(64,169,255,0.15) 100%); border-color: #1890ff; }
.panel-avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.panel-player-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.panel-name { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.panel-number { font-size: 22rpx; color: var(--gold); font-weight: 600; }

.current-score { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.current-label { font-size: 18rpx; color: var(--text-secondary); }
.current-value { font-size: 42rpx; font-weight: 900; background: var(--gold-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }

.action-module { margin-bottom: 18rpx; }
.module-title { font-size: 24rpx; font-weight: 800; color: var(--gold); margin-bottom: 12rpx; letter-spacing: 1rpx; }

.score-buttons-wide { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.score-btn-wide { padding: 0 12rpx; border-radius: 16rpx; border: none; font-size: 24rpx; font-weight: 800; cursor: pointer; transition: all 0.24s ease; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8rpx; min-height: 62rpx; white-space: nowrap; }
.btn-text-large { font-size: 24rpx; font-weight: 900; letter-spacing: 0; line-height: 1; }
.btn-sub-text { font-size: 19rpx; opacity: 0.86; font-weight: 800; line-height: 1; }
.btn-plus-green { background: linear-gradient(135deg, rgba(82,196,26,0.25) 0%, rgba(115,209,61,0.18) 100%); color: #52c41a; border: 2rpx solid rgba(82,196,26,0.45); }
.btn-plus-green:hover { transform: translateY(-3rpx); box-shadow: 0 6rpx 20rpx rgba(82,196,26,0.35); }
.btn-plus-blue { background: linear-gradient(135deg, rgba(24,144,255,0.25) 0%, rgba(64,169,255,0.18) 100%); color: #1890ff; border: 2rpx solid rgba(24,144,255,0.45); }
.btn-plus-blue:hover { transform: translateY(-3rpx); box-shadow: 0 6rpx 20rpx rgba(24,144,255,0.35); }
.btn-plus-gold.highlight { background: linear-gradient(135deg, rgba(212,175,55,0.3) 0%, rgba(255,215,0,0.22) 100%); color: var(--gold); border: 2rpx solid rgba(212,175,55,0.6); box-shadow: 0 4rpx 16rpx rgba(212,175,55,0.25); }
.btn-minus-red { background: linear-gradient(135deg, rgba(255,77,79,0.25) 0%, rgba(255,120,117,0.18) 100%); color: #ff4d4f; border: 2rpx solid rgba(255,77,79,0.45); }

.foul-buttons-wide, .foul-actions-grid { display: grid; grid-template-columns: 1.12fr 1fr 1fr; gap: 12rpx; }
.foul-btn-wide, .team-foul-btn { padding: 0 10rpx; border-radius: 16rpx; background: var(--bg-input); border: 2rpx solid var(--border-input); display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8rpx; cursor: pointer; transition: all 0.24s ease; min-height: 62rpx; white-space: nowrap; }
.foul-btn-wide:hover { border-color: var(--gold); background: rgba(212,175,55,0.1); transform: translateY(-3rpx); box-shadow: 0 6rpx 20rpx rgba(212,175,55,0.18); }
.foul-icon-wide { display: inline-flex; align-items: center; }
.foul-text-wide { font-size: 22rpx; color: var(--text-primary); font-weight: 600; }
.team-foul-btn { gap: 6rpx; font-size: 20rpx; font-weight: 800; color: var(--text-primary); }
.team-foul-btn text { line-height: 1; }
.team-foul-a { border-color: rgba(255,77,79,0.35); background: rgba(255,77,79,0.08); }
.team-foul-b { border-color: rgba(24,144,255,0.35); background: rgba(24,144,255,0.08); }
.stat-buttons-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10rpx; }
.stat-btn { min-height: 64rpx; border-radius: 14rpx; background: var(--bg-input); border: 2rpx solid var(--border-input); display: flex; align-items: center; justify-content: center; transition: all 0.24s ease; }
.stat-btn:hover { border-color: var(--gold); background: rgba(212,175,55,0.1); transform: translateY(-3rpx); box-shadow: 0 6rpx 20rpx rgba(212,175,55,0.18); }
.stat-btn-text { font-size: 22rpx; color: var(--text-primary); font-weight: 700; }

.close-panel-btn { width: 100%; padding: 20rpx; background: var(--bg-input); color: var(--text-secondary); border: 2rpx solid var(--border-input); border-radius: 18rpx; font-size: 26rpx; font-weight: 700; margin-top: 10rpx; transition: all 0.3s ease; }
.close-panel-btn:hover { background: rgba(212,175,55,0.08); border-color: var(--gold); color: var(--gold); }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--bg-bottom); display: flex; gap: 20rpx; z-index: 100; border-top: 1rpx solid var(--border-bottom); }
.bottom-bar.unified-bg { background: var(--bg-bottom); backdrop-filter: none; }

.bar-btn { flex: 1; padding: 22rpx 28rpx; border-radius: 48rpx; font-size: 27rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 12rpx; border: none; cursor: pointer; transition: all 0.3s ease; }
.btn-undo { background: var(--bg-input); color: var(--gold); border: 2rpx solid rgba(212,175,55,0.35); }
.btn-undo:not(.disabled):hover { background: rgba(212,175,55,0.1); border-color: var(--gold); transform: translateY(-3rpx); box-shadow: 0 8rpx 24rpx rgba(212,175,55,0.2); }
.btn-undo.disabled { opacity: 0.4; cursor: not-allowed; }
.btn-end { background: var(--gold-gradient); color: #0a0a0a; font-weight: 800; box-shadow: 0 8rpx 28rpx rgba(212,175,55,0.45), 0 0 32rpx rgba(212,175,55,0.15); }
.btn-end:hover { transform: translateY(-4rpx) scale(1.02); box-shadow: 0 14rpx 42rpx rgba(212,175,55,0.55), 0 0 48rpx rgba(212,175,55,0.25); }
.bar-btn-icon { font-size: 30rpx; font-weight: bold; }
.bar-btn-text { font-size: 25rpx; }
