<!-- custom-match-live.wxml -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>

  <view class="container slide-up">
    <!-- 顶部状态栏 -->
    <view class="top-status-bar glass-effect">
      <view class="status-left">
        <view class="page-back-btn" bindtap="exitMatch">
          <t-icon name="chevron-left" size="42rpx" color="#D4AF37" />
        </view>
        <view class="match-info">
          <text class="match-title">自定义比赛</text>
          <view class="status-badge in-progress">
            <view class="status-dot"></view>
            <text class="status-text">进行中</text>
          </view>
        </view>
      </view>

      <view class="timer-display">
        <t-icon class="timer-icon" name="time" size="24rpx" color="#D4AF37" />
        <text class="timer-text">{{matchTime}}</text>
      </view>
    </view>

    <view class="score-hero card glass-effect">
      <view class="score-team team-a">
        <text class="score-team-name">A</text>
        <text class="score-team-fouls">犯规 {{teamAFouls}}</text>
      </view>
      <view class="score-center">
        <text class="team-score a-score">{{teamAScore}}</text>
        <text class="score-vs">VS</text>
        <text class="team-score b-score">{{teamBScore}}</text>
      </view>
      <view class="score-team team-b">
        <text class="score-team-name">B</text>
        <text class="score-team-fouls">犯规 {{teamBFouls}}</text>
      </view>
    </view>

    <!-- 球员网格区域 - 按队伍分组 -->
    <view class="players-grid-section">
      <view class="grid-header">
        <text class="grid-title">参赛球员</text>
        <text class="player-count-info">{{players.length}}名球员 A{{teamACount}} / B{{teamBCount}}</text>
      </view>

      <view class="team-columns">
        <view class="team-column team-column-a">
          <view class="team-column-head">
            <text class="team-column-title">A 队</text>
            <text class="team-column-meta">{{teamAScore}}分 · 犯规{{teamAFouls}}</text>
          </view>
          <view
            wx:for="{{teamAPlayers}}"
            wx:key="id"
            class="player-row card {{selectedPlayerId === item.id ? 'selected' : ''}} team-a"
            bindtap="selectPlayer"
            data-player="{{item}}"
          >
            <view class="player-row-avatar">
              <image wx:if="{{item.avatar}}" src="{{item.avatar}}" class="card-avatar" mode="aspectFill" />
              <view wx:else class="card-avatar-placeholder A">
                <text class="card-avatar-number">{{item.number}}</text>
              </view>
              <view class="foul-badge {{item.fouls.length > 0 ? 'has-foul' : ''}}">{{item.fouls.length || 0}}</view>
            </view>
            <view class="player-row-info">
              <text class="card-name">{{item.name}}</text>
              <text class="card-number team-label-A">#{{item.number}}</text>
            </view>
            <view class="row-score {{item.score > 0 ? 'has-score' : ''}}">{{item.score}}</view>
          </view>
        </view>

        <view class="team-column team-column-b">
          <view class="team-column-head">
            <text class="team-column-title">B 队</text>
            <text class="team-column-meta">{{teamBScore}}分 · 犯规{{teamBFouls}}</text>
          </view>
          <view
            wx:for="{{teamBPlayers}}"
            wx:key="id"
            class="player-row card {{selectedPlayerId === item.id ? 'selected' : ''}} team-b"
            bindtap="selectPlayer"
            data-player="{{item}}"
          >
            <view class="player-row-avatar">
              <image wx:if="{{item.avatar}}" src="{{item.avatar}}" class="card-avatar" mode="aspectFill" />
              <view wx:else class="card-avatar-placeholder B">
                <text class="card-avatar-number">{{item.number}}</text>
              </view>
              <view class="foul-badge {{item.fouls.length > 0 ? 'has-foul' : ''}}">{{item.fouls.length || 0}}</view>
            </view>
            <view class="player-row-info">
              <text class="card-name">{{item.name}}</text>
              <text class="card-number team-label-B">#{{item.number}}</text>
            </view>
            <view class="row-score {{item.score > 0 ? 'has-score' : ''}}">{{item.score}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作日志（可折叠） -->
    <view wx:if="{{actionLog.length > 0}}" class="action-log-section">
      <view class="log-header" bindtap="toggleLog">
        <text class="log-title">操作记录</text>
        <text class="log-count">{{actionLog.length}}条</text>
        <text class="log-toggle {{showLog ? 'expanded' : ''}}">▼</text>
      </view>

      <view wx:if="{{showLog}}" class="log-list">
        <view wx:for="{{actionLog}}" wx:key="index" class="log-item" wx:for-item="log">
          <view class="log-time">{{log.time}}</view>
          <view class="log-content {{log.type}}">
            <text class="log-text">{{log.playerName}} - {{log.action}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 球员操作浮层 - 优化按钮样式 -->
  <view wx:if="{{selectedPlayer}}" class="action-overlay" bindtap="closePlayerAction">
    <view class="action-panel card glass-effect-dark" catchtap="">
      <!-- 球员头部信息 -->
      <view class="panel-header">
        <view class="panel-avatar {{selectedPlayer.team}}">
          <image
            wx:if="{{selectedPlayer.avatar}}"
            src="{{selectedPlayer.avatar}}"
            class="panel-avatar-img"
            mode="aspectFill"
          />
          <view wx:else class="panel-avatar-placeholder {{selectedPlayer.team}}">
            <text>{{selectedPlayer.number}}</text>
          </view>
        </view>
        <view class="panel-player-info">
          <text class="panel-name">{{selectedPlayer.name}}</text>
          <text class="panel-number">#{{selectedPlayer.number}} ({{selectedPlayer.team === 'A' ? 'A队' : 'B队'}})</text>
        </view>
        <view class="current-score">
          <text class="current-label">当前得分</text>
          <text class="current-value">{{selectedPlayer.score}}</text>
        </view>
      </view>

      <view class="action-module">
        <view class="module-title">得分</view>
        <view class="score-buttons-wide scoring-actions">
          <button
            class="score-btn-wide btn-plus-gold highlight"
            bindtap="addScore"
            data-points="3"
            data-score-type="三分球"
          >
            <text class="btn-text-large">三分球</text>
            <text class="btn-sub-text">+3分</text>
          </button>
          <button
            class="score-btn-wide btn-plus-blue"
            bindtap="addScore"
            data-points="2"
            data-score-type="投篮"
          >
            <text class="btn-text-large">投篮</text>
            <text class="btn-sub-text">+2分</text>
          </button>
          <button
            class="score-btn-wide btn-plus-green"
            bindtap="addScore"
            data-points="1"
            data-score-type="罚球"
          >
            <text class="btn-text-large">罚球</text>
            <text class="btn-sub-text">+1分</text>
          </button>
        </view>
      </view>

      <view class="action-module">
        <view class="module-title">犯规</view>
        <view class="foul-actions-grid">
          <button
            class="foul-btn-wide"
            bindtap="recordFoul"
            data-type="foul"
          >
            <t-icon class="foul-icon-wide" name="error-triangle" size="26rpx" color="#faad14" />
            <text class="foul-text-wide">个人犯规</text>
          </button>
          <button class="team-foul-btn team-foul-a" bindtap="recordTeamFoul" data-team="A">
            <text>A队犯规</text>
            <text>+1</text>
          </button>
          <button class="team-foul-btn team-foul-b" bindtap="recordTeamFoul" data-team="B">
            <text>B队犯规</text>
            <text>+1</text>
          </button>
        </view>
      </view>

      <view class="action-module">
        <view class="module-title">技术统计</view>
        <view class="stat-buttons-grid">
          <button
            class="stat-btn"
            bindtap="recordStat"
            data-stat="rebounds"
            data-stat-name="篮板"
          >
            <text class="stat-btn-text">篮板</text>
          </button>
          <button
            class="stat-btn"
            bindtap="recordStat"
            data-stat="steals"
            data-stat-name="抢断"
          >
            <text class="stat-btn-text">抢断</text>
          </button>
          <button
            class="stat-btn"
            bindtap="recordStat"
            data-stat="assists"
            data-stat-name="助攻"
          >
            <text class="stat-btn-text">助攻</text>
          </button>
          <button
            class="stat-btn"
            bindtap="recordStat"
            data-stat="turnovers"
            data-stat-name="失误"
          >
            <text class="stat-btn-text">失误</text>
          </button>
          <button
            class="stat-btn"
            bindtap="recordStat"
            data-stat="blocks"
            data-stat-name="盖帽"
          >
            <text class="stat-btn-text">盖帽</text>
          </button>
        </view>
      </view>

      <!-- 关闭按钮 -->
      <button class="close-panel-btn" bindtap="closePlayerAction">
        关闭
      </button>
    </view>
  </view>

  <!-- 底部操作栏 - 统一背景 -->
  <view class="bottom-bar unified-bg">
    <button
      class="bar-btn btn-undo {{actionLog.length === 0 ? 'disabled' : ''}}"
      bindtap="undoLastAction"
      disabled="{{actionLog.length === 0}}"
    >
      <t-icon class="bar-btn-icon" name="rollback" size="30rpx" color="#D4AF37" />
      <text class="bar-btn-text">撤销上一步</text>
    </button>

    <button
      class="bar-btn btn-end"
      bindtap="endMatch"
    >
      <t-icon class="bar-btn-icon" name="stop-circle" size="30rpx" color="#0a0a0a" />
      <text class="bar-btn-text">结束比赛</text>
    </button>
  </view>
</view>
