.page-shell {
  padding-bottom: 240rpx;
}

.compact-hero {
  padding-top: 30rpx;
  padding-bottom: 30rpx;
}

.library-hero {
  box-shadow: 0 24rpx 54rpx rgba(21, 89, 225, 0.18);
}

.library-hero-stats {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
}

.library-hero-stat {
  font-size: 30rpx;
  font-weight: 700;
}

.library-hero-divider {
  width: 2rpx;
  height: 22rpx;
  background: rgba(255, 255, 255, 0.28);
}

.library-hero-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.category-scroll,
.town-scroll {
  margin-top: 22rpx;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.category-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.category-chip,
.filter-chip {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #56709f;
  font-size: 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(29, 93, 255, 0.06);
}

.category-chip--active,
.filter-chip--active {
  background: linear-gradient(135deg, #165bff 0%, #4d8dff 100%);
  color: #ffffff;
}

.library-feature-card {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  height: 360rpx;
  border-radius: 34rpx;
  box-shadow: 0 22rpx 52rpx rgba(16, 56, 138, 0.14);
}

.library-feature-cover {
  width: 100%;
  height: 100%;
  background: #dfe8f8;
}

.library-feature-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 28, 62, 0.08) 0%, rgba(15, 28, 62, 0.68) 100%);
}

.library-feature-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx;
  color: #ffffff;
}

.library-feature-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.library-feature-badge,
.library-feature-town {
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  font-weight: 700;
}

.library-feature-name {
  margin-top: 18rpx;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 700;
}

.library-feature-desc {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.84);
}

.library-feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.library-feature-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 20rpx;
}

.library-card {
  padding: 0;
  overflow: hidden;
  border-radius: 30rpx;
}

.library-cover {
  width: 100%;
  height: 340rpx;
  background: #dfe8f8;
}

.library-body {
  padding: 26rpx 28rpx 30rpx;
}

.library-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
}

.library-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #1d2d4a;
}

.library-town {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #1d5dff;
}

.library-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.library-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(29, 93, 255, 0.08);
  color: #1d5dff;
  font-size: 20rpx;
}

.library-desc {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: #6f7f9f;
}

/* —— A1：卡片点击反馈与详情提示 —— */

.library-card--hover {
  opacity: 0.92;
  transform: scale(0.99);
}

.library-feature-cta {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.library-feature-cta-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
}

.library-feature-cta-arrow {
  font-size: 30rpx;
  color: #ffffff;
  line-height: 1;
}

.library-card-cta {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(29, 93, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 22rpx;
  color: #1d5dff;
}

.library-card-cta-arrow {
  font-size: 30rpx;
  color: #7d8cae;
  line-height: 1;
}

/* —— A2：联系客户经理入口卡片 —— */

.contact-entry {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0d5eff 0%, #4d8dff 100%);
  box-shadow: 0 18rpx 44rpx rgba(18, 46, 99, 0.16);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.contact-entry-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.contact-entry-body {
  flex: 1;
  min-width: 0;
}

.contact-entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.contact-entry-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.5;
}

.contact-entry-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
}

/* —— 联系客服入口（小程序客服按钮，客服由“微信客服”接管） —— */

.page-shell .contact-entry {
  width: 100%;
  margin: 24rpx 0 0;
  border: none;
  text-align: left;
  line-height: 1.4;
  font-size: 28rpx;
}

.contact-entry::after {
  border: none;
}
