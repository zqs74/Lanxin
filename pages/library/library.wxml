<view class="app-shell page-shell">
  <view class="page-hero compact-hero library-hero">
    <view class="hero-city">资源库</view>
    <view class="hero-title">东莞篮球资源档案</view>
    <view class="library-hero-stats">
      <view class="library-hero-stat">{{resourceCount}}</view>
      <view class="library-hero-divider"></view>
      <view class="library-hero-label">{{activeCategoryLabel}}</view>
    </view>
  </view>

  <scroll-view scroll-x class="category-scroll" show-scrollbar="{{false}}">
    <view class="category-row">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="category-chip {{activeCategory === item.key ? 'category-chip--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="selectCategory"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <scroll-view scroll-x class="town-scroll" show-scrollbar="{{false}}">
    <view class="category-row">
      <view
        wx:for="{{towns}}"
        wx:key="*this"
        class="filter-chip {{townFilter === item ? 'filter-chip--active' : ''}}"
        data-town="{{item}}"
        bindtap="selectTown"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- 2026-09-18：取消“主推资源”大卡片。公开资料没有主推之分，所有资源统一用下方卡片展示。 -->

  <block wx:if="{{list.length}}">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="section-card library-card"
      bindtap="onResourceTap"
      hover-class="library-card--hover"
      hover-stay-time="80"
    >
      <image wx:if="{{item.cover || item.avatar || item.image}}" class="library-cover" src="{{item.cover || item.avatar || item.image}}" mode="aspectFill"></image>
      <view class="library-body">
        <view class="library-head">
          <view class="library-name">{{item.name}}</view>
          <view class="library-town">{{item.town || '东莞'}}</view>
        </view>
        <view class="library-tags">
          <text wx:for="{{item.tags}}" wx:key="*this" class="library-tag">{{item}}</text>
        </view>
        <view class="library-desc">{{item.description}}</view>
        <view class="library-card-cta">
          <text>资源仅供参考，请自行核实</text>
          <text class="library-card-cta-arrow">›</text>
        </view>
      </view>
    </view>
  </block>

  <view class="section-card" wx:if="{{!resourceCount}}">
    <van-empty image="search" description="{{emptyText}}" />
  </view>

  <view class="contact-entry" bindtap="openContact" hover-class="library-card--hover" hover-stay-time="80">
    <view class="contact-entry-icon">💬</view>
    <view class="contact-entry-body">
      <view class="contact-entry-title">查看联系信息</view>
      <view class="contact-entry-desc">公开资源不代表合作或可代订，请自行核实</view>
    </view>
    <view class="contact-entry-arrow">›</view>
  </view>

  <open-guide visible="{{guideVisible}}" bind:close="closeGuide" />
</view>
