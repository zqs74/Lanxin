<!-- profile.wxml - 商城 -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>

  <view class="container slide-up">
    <!-- 页面标题 -->
    <view class="page-header">
      <view class="page-title">商城</view>
      <view class="page-subtitle">商城演示 · 下单不扣款</view>
      <view class="orders-entry" bindtap="showOrders">
        <t-icon name="time" size="30rpx" color="#D4AF37" />
        <text class="orders-entry-text">我的订单</text>
      </view>
    </view>

    <!-- 分类 -->
    <view class="category-bar">
      <view
        wx:for="{{ categories }}"
        wx:key="key"
        class="category-item {{ activeCategory === item.key ? 'active' : '' }}"
        data-key="{{ item.key }}"
        bindtap="switchCategory"
      >
        {{ item.label }}
      </view>
    </view>

    <!-- 商品网格 -->
    <view class="product-grid">
      <view
        class="product-card card"
        wx:for="{{ filteredProducts }}"
        wx:key="id"
        data-id="{{ item.id }}"
        bindtap="openDetail"
      >
        <view class="product-emoji">
          <text class="product-emoji-text">{{ item.emoji }}</text>
          <view wx:if="{{ item.tag }}" class="product-tag">{{ item.tag }}</view>
        </view>
        <view class="product-name">{{ item.name }}</view>
        <view class="product-bottom">
          <text class="product-price">¥{{ item.price }}</text>
          <view class="product-buy">
            <t-icon name="cart" size="30rpx" color="#0a0a0a" />
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{ filteredProducts.length === 0 }}" class="no-data">该分类暂无商品</view>
  </view>

  <!-- 商品详情/下单弹层 -->
  <view wx:if="{{ detailVisible }}" class="modal-mask" bindtap="closeDetail">
    <view class="modal-panel {{ themeClass }}" catchtap="stopPropagation">
      <view class="detail-emoji">
        <text class="detail-emoji-text">{{ currentProduct.emoji }}</text>
      </view>
      <view class="detail-header">
        <view class="detail-name">{{ currentProduct.name }}</view>
        <view class="modal-close" bindtap="closeDetail"><t-icon name="close" size="30rpx" color="var(--text-tertiary)" /></view>
      </view>
      <view class="detail-price">¥{{ currentProduct.price }}</view>
      <view class="detail-desc">{{ currentProduct.desc }}</view>

      <view class="count-row">
        <view class="count-label">购买数量</view>
        <view class="count-stepper">
          <view class="stepper-btn" bindtap="decrease">−</view>
          <text class="stepper-value">{{ buyCount }}</text>
          <view class="stepper-btn plus" bindtap="increase">＋</view>
        </view>
      </view>
      <view class="total-row">合计：<text class="total-price">¥{{ currentProduct.price * buyCount }}</text></view>

      <button class="btn btn-primary submit-btn" bindtap="submitOrder">模拟下单</button>
    </view>
  </view>

  <!-- 我的订单弹层 -->
  <view wx:if="{{ ordersVisible }}" class="modal-mask" bindtap="closeOrders">
    <view class="modal-panel {{ themeClass }}" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title">我的订单</view>
        <view class="modal-close" bindtap="closeOrders"><t-icon name="close" size="30rpx" color="var(--text-tertiary)" /></view>
      </view>

      <view wx:if="{{ orders.length === 0 }}" class="no-data orders-empty">暂无订单，去逛逛吧</view>

      <scroll-view scroll-y class="orders-list">
        <view class="order-item card" wx:for="{{ orders }}" wx:key="id">
          <view class="order-emoji"><text>{{ item.emoji }}</text></view>
          <view class="order-info">
            <view class="order-name">{{ item.productName }}</view>
            <view class="order-meta">¥{{ item.price }} × {{ item.count }}</view>
          </view>
          <view class="order-total">{{ item.status === 'UNPAID' ? '未支付' : '订单金额' }} ¥{{ item.total }}</view>
        </view>
      </scroll-view>

      <button wx:if="{{ orders.length > 0 }}" class="btn btn-ghost clear-btn" bindtap="clearOrders">清空订单</button>
    </view>
  </view>

  <!-- 悬浮AI按钮 -->
  <float-ai-button></float-ai-button>
</view>
