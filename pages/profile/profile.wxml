<!-- profile.wxml -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>

  <view class="container slide-up">
    <view class="page-header">
      <view class="page-title">个人中心</view>
      <view class="page-subtitle">管理资料、数据和偏好设置</view>
    </view>

    <view class="section">
      <view class="profile-card card">
        <view class="profile-header">
          <view class="avatar-section">
            <view class="avatar gradient-bg">
              <image wx:if="{{profile.avatar}}" class="avatar-image" src="{{profile.avatar}}" mode="aspectFill"></image>
              <t-icon wx:else name="user" size="52rpx" color="#0a0a0a" />
            </view>
            <view class="profile-basic">
              <view class="name">{{ profile.name }}</view>
              <view class="profile-tag">{{ profile.position }}</view>
            </view>
          </view>
          <view class="edit-btn btn-primary btn-small" bindtap="editProfile">编辑资料</view>
        </view>

        <view class="profile-stats">
          <view class="stat-card">
            <view class="stat-icon">
              <t-icon name="ruler" size="34rpx" color="#D4AF37" />
            </view>
            <view class="stat-number">{{ profile.height }}</view>
            <view class="stat-desc">身高</view>
          </view>
          <view class="stat-card">
            <view class="stat-icon">
              <t-icon name="chart-radar" size="34rpx" color="#D4AF37" />
            </view>
            <view class="stat-number">{{ profile.weight }}</view>
            <view class="stat-desc">体重</view>
          </view>
          <view class="stat-card">
            <view class="stat-icon">
              <t-icon name="time" size="34rpx" color="#D4AF37" />
            </view>
            <view class="stat-number">{{ profile.yearsOfPlay || '未设置' }}</view>
            <view class="stat-desc">球龄</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <view class="section-title">个人数据</view>
        <view class="data-badge">场均</view>
      </view>

      <view class="stats-section card">
        <view class="stats-grid">
          <view class="stat-item">
            <view class="stat-value gradient-text">{{ stats.points }}</view>
            <view class="stat-label">场均得分</view>
          </view>
          <view class="stat-item">
            <view class="stat-value gradient-text">{{ stats.fieldGoals }}</view>
            <view class="stat-label">场均投篮</view>
          </view>
          <view class="stat-item">
            <view class="stat-value gradient-text">{{ stats.shootingPercentage }}%</view>
            <view class="stat-label">命中率</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <view class="section-title">设置</view>
      </view>

      <view class="settings-card card">
        <view class="setting-item" bindtap="handleToggleTheme">
          <view class="setting-left">
            <view class="setting-icon">
              <t-icon name="mode-light" size="34rpx" color="#D4AF37" />
            </view>
            <view class="setting-copy">
              <view class="setting-text">主题模式</view>
              <view class="setting-desc">切换浅色、深色或跟随系统</view>
            </view>
          </view>
          <view class="setting-right">
            <view class="theme-value">{{ themeLabel }}</view>
            <t-icon name="chevron-right" size="28rpx" color="#999999" />
          </view>
        </view>

        <view class="setting-item" bindtap="goToChat">
          <view class="setting-left">
            <view class="setting-icon">
              <t-icon name="robot" size="34rpx" color="#D4AF37" />
            </view>
            <view class="setting-copy">
              <view class="setting-text">训练顾问</view>
              <view class="setting-desc">分析比赛和训练表现</view>
            </view>
          </view>
          <view class="setting-right">
            <t-icon name="chevron-right" size="28rpx" color="#999999" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <float-ai-button></float-ai-button>
</view>
