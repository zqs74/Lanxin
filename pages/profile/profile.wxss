/* profile.wxss - 昇梦体育 主题适配 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 148rpx 30rpx 20rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.page-header {
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 100%);
  border-radius: 3rpx;
}

.data-badge {
  padding: 8rpx 20rpx;
  background: var(--bg-tag);
  color: var(--gold);
  border-radius: 30rpx;
  font-size: 20rpx;
  font-weight: 600;
  border: 2rpx solid var(--border-stat);
}

.profile-card {
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.profile-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(212,175,55,0.04) 0%, rgba(255,215,0,0.03) 100%);
  pointer-events: none;
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.avatar-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: var(--shadow-avatar);
}

.profile-basic {
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.profile-tag {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 500;
  background: rgba(212,175,55,0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.edit-btn {
  flex-shrink: 0;
}

.profile-stats {
  display: flex;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.stat-card {
  flex: 1;
  background: var(--bg-stat-card);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid var(--border-stat);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.stat-card:hover {
  transform: translateY(-4rpx);
  border-color: rgba(212,175,55,0.3);
  box-shadow: 0 8rpx 20rpx rgba(212,175,55,0.15);
}

.stat-icon {
  font-size: 32rpx;
}

.stat-number {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-desc {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.stats-section {
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.stats-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(212,175,55,0.03) 0%, rgba(255,215,0,0.02) 100%);
  pointer-events: none;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  text-align: center;
  padding: 28rpx 16rpx;
  background: var(--bg-stat-card);
  border-radius: 20rpx;
  border: 2rpx solid var(--border-stat);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.stat-item:hover {
  transform: translateY(-4rpx);
  border-color: rgba(212,175,55,0.3);
  box-shadow: 0 8rpx 20rpx rgba(212,175,55,0.15);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  color: var(--text-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ===== 设置列表 ===== */
.settings-list {
  padding: 8rpx;
  position: relative;
  overflow: hidden;
}

.settings-list::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(212,175,55,0.02) 0%, rgba(255,215,0,0.01) 100%);
  pointer-events: none;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  z-index: 1;
}

.setting-item:hover {
  background: rgba(212,175,55,0.05);
  transform: translateX(4rpx);
}

.setting-item + .setting-item {
  border-top: 1rpx solid var(--border-lighter);
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.25);
}

.setting-text {
  font-size: 28rpx;
  color: var(--text-content);
  font-weight: 500;
}

.setting-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: bold;
  transition: transform 0.3s ease;
}

.setting-item:hover .setting-arrow {
  transform: translateX(4rpx);
  color: var(--gold);
}

/* ===== 主题切换行（点击弹出选择器） ===== */
.theme-value {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
  margin-right: 16rpx;
}
