/* profile.wxss */
.container {
  padding: 20rpx;
  background-color: #121212;
  min-height: 100vh;
}

.section {
  background-color: #1E1E1E;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
}

.section:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.4);
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 1rpx;
}

.edit-btn {
  padding: 12rpx 24rpx;
  background-color: #7A41FF;
  color: white;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(122, 65, 255, 0.4);
}

.edit-btn:hover {
  background-color: #6A31EF;
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(122, 65, 255, 0.5);
}

.profile-info {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #333;
}

.info-item {
  text-align: center;
  transition: all 0.3s ease;
}

.info-item:hover {
  transform: translateY(-2rpx);
}

.info-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 24rpx;
  background-color: #2A2A2A;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(122, 65, 255, 0.2);
}

.stat-item:hover {
  transform: translateY(-2rpx);
  background-color: rgba(122, 65, 255, 0.1);
  border-color: rgba(122, 65, 255, 0.4);
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #7A41FF;
  margin-bottom: 8rpx;
  text-shadow: 0 0 8rpx rgba(122, 65, 255, 0.5);
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}