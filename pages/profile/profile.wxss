/* profile.wxss - 现代化UI设计 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: var(--spacing-md);
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* 页面标题 */
.page-header {
  margin-bottom: var(--spacing-xl);
  padding-top: var(--spacing-md);
  animation: fadeIn 0.6s ease-out;
}

.page-title {
  font-size: var(--font-2xl);
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
  line-height: 1.2;
  position: relative;
  display: inline-block;
}

.page-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 80rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 3rpx;
  animation: slideIn 0.8s ease-out 0.3s both;
}

.page-subtitle {
  font-size: var(--font-md);
  color: var(--text-secondary);
  font-weight: 500;
  animation: fadeIn 0.6s ease-out 0.2s both;
}

/* 通用section样式 */
.section {
  margin-bottom: var(--spacing-xl);
  animation: slideUp 0.5s var(--transition-normal);
}

.section:nth-child(2) {
  animation-delay: 0.1s;
}

.section:nth-child(3) {
  animation-delay: 0.2s;
}

.section:nth-child(4) {
  animation-delay: 0.3s;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  position: relative;
  display: inline-block;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 3rpx;
}

.data-badge {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.1) 100%);
  color: var(--primary-color);
  border-radius: var(--border-radius-full);
  font-size: var(--font-xs);
  font-weight: 600;
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  transition: all var(--transition-normal);
}

.data-badge:hover {
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.15) 0%, rgba(89, 168, 255, 0.15) 100%);
  border-color: rgba(68, 206, 255, 0.4);
  transform: translateY(-2rpx);
}

/* 个人资料卡片 */
.profile-card {
  padding: var(--spacing-lg);
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--border-radius-xl);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.profile-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.08) 0%, rgba(89, 168, 255, 0.05) 100%);
  pointer-events: none;
}

.profile-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.profile-card:hover {
  transform: translateY(-8rpx);
  box-shadow: var(--shadow-medium);
}

.profile-card:hover::after {
  transform: scaleX(1);
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-lg);
  position: relative;
  z-index: 1;
}

.avatar-section {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex: 1;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--border-radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: white;
  box-shadow: 0 12rpx 32rpx rgba(68, 206, 255, 0.4);
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  animation: float 3s ease-in-out infinite;
}

.avatar::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.1) 50%, transparent 70%);
  transform: rotate(45deg);
  animation: shine 3s infinite;
}

.avatar:hover {
  transform: scale(1.1) rotate(5deg);
  box-shadow: 0 16rpx 40rpx rgba(68, 206, 255, 0.5);
}

.profile-basic {
  flex: 1;
}

.name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  line-height: 1.2;
  transition: color 0.3s ease;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.profile-card:hover .name {
  color: var(--primary-color);
  text-shadow: 0 2rpx 8rpx rgba(68, 206, 255, 0.3);
}

.profile-tag {
  font-size: var(--font-sm);
  color: var(--primary-color);
  font-weight: 500;
  background: rgba(68, 206, 255, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  display: inline-block;
  margin-top: 8rpx;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border: 2rpx solid rgba(68, 206, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.2);
}

.profile-tag:hover {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: white;
  transform: translateY(-4rpx);
  box-shadow: 0 6rpx 20rpx rgba(68, 206, 255, 0.4);
}

.edit-btn {
  flex-shrink: 0;
}

/* 个人资料统计 */
.profile-stats {
  display: flex;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.12) 0%, rgba(89, 168, 255, 0.08) 100%);
  border-radius: var(--border-radius-lg);
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.1);
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  transform: scaleX(0);
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.stat-card::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(68, 206, 255, 0.1) 50%, transparent 70%);
  transform: rotate(45deg);
  transition: left 0.6s ease;
  left: -100%;
}

.stat-card:hover {
  transform: translateY(-6rpx) scale(1.02);
  border-color: rgba(68, 206, 255, 0.4);
  box-shadow: 0 10rpx 24rpx rgba(68, 206, 255, 0.2);
}

.stat-card:hover::before {
  transform: scaleX(1);
}

.stat-card:hover::after {
  left: 100%;
}

.stat-icon {
  font-size: 36rpx;
  color: var(--primary-color);
  margin-bottom: 4rpx;
  transition: all 0.3s ease;
  animation: float 3s ease-in-out infinite;
}

.stat-card:hover .stat-icon {
  transform: scale(1.1) rotate(10deg);
  text-shadow: 0 4rpx 8rpx rgba(68, 206, 255, 0.4);
}

.stat-number {
  font-size: var(--font-lg);
  font-weight: 800;
  color: var(--primary-color);
  line-height: 1;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  transition: all 0.3s ease;
}

.stat-card:hover .stat-number {
  transform: scale(1.1);
  text-shadow: 0 2rpx 4rpx rgba(68, 206, 255, 0.3);
}

.stat-desc {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  text-align: center;
  transition: all 0.3s ease;
  font-weight: 500;
}

.stat-card:hover .stat-desc {
  color: var(--primary-color);
  transform: translateY(-2rpx);
}

/* 数据统计区 */
.stats-section {
  padding: var(--spacing-lg);
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--border-radius-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-normal);
}

.stats-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.03) 0%, rgba(89, 168, 255, 0.02) 100%);
  pointer-events: none;
}

.stats-section::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.stats-section:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-medium);
}

.stats-section:hover::after {
  transform: scaleX(1);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  text-align: center;
  padding: 28rpx 16rpx;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.08) 0%, rgba(89, 168, 255, 0.05) 100%);
  border-radius: var(--border-radius-md);
  border: 2rpx solid rgba(68, 206, 255, 0.15);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.stat-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.stat-item:hover {
  transform: translateY(-4rpx);
  border-color: rgba(68, 206, 255, 0.3);
  box-shadow: 0 8rpx 20rpx rgba(68, 206, 255, 0.15);
}

.stat-item:hover::before {
  transform: scaleX(1);
}

.stat-value {
  font-size: var(--font-xl);
  font-weight: 800;
  margin-bottom: 8rpx;
  color: var(--primary-color);
  line-height: 1;
}

.stat-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 500;
}

/* 设置列表 */
.settings-list {
  padding: 8rpx;
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--border-radius-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-normal);
}

.settings-list::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.02) 0%, rgba(89, 168, 255, 0.01) 100%);
  pointer-events: none;
}

.settings-list::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.settings-list:hover::after {
  transform: scaleX(1);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: var(--border-radius-md);
  transition: all var(--transition-normal);
  position: relative;
  z-index: 1;
  margin-bottom: 8rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-item:hover {
  background: rgba(68, 206, 255, 0.05);
  transform: translateX(4rpx);
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--border-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.1) 100%);
  color: var(--primary-color);
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.2);
  transition: all var(--transition-normal);
}

.setting-item:hover .setting-icon {
  transform: scale(1.05);
  box-shadow: 0 6rpx 16rpx rgba(68, 206, 255, 0.3);
}

.setting-text {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 500;
  transition: color var(--transition-normal);
}

.setting-item:hover .setting-text {
  color: var(--primary-color);
}

.setting-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: bold;
  transition: all var(--transition-normal);
}

.setting-item:hover .setting-arrow {
  transform: translateX(4rpx);
  color: var(--primary-color);
}

/* 动画效果 */
@keyframes slideIn {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(0);
  }
}

@keyframes shine {
  0% {
    transform: translateX(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) rotate(45deg);
  }
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: var(--spacing-sm);
  }
  
  .avatar {
    width: 100rpx;
    height: 100rpx;
  }
  
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .profile-stats {
    flex-direction: column;
    gap: 12rpx;
  }
  
  .stat-card {
    flex-direction: row;
    justify-content: space-around;
  }
}
