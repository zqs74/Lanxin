/* profile.wxss - 昇梦体育 主题适配 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 136rpx 28rpx 24rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.page-header {
  margin-bottom: 28rpx;
  padding-top: 20rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 44rpx;
  height: 4rpx;
  background: var(--gold);
  border-radius: 2rpx;
}

.data-badge {
  padding: 8rpx 20rpx;
  background: var(--bg-tag);
  color: var(--gold);
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  border: 2rpx solid var(--border-stat);
}

.profile-card {
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.profile-card::before {
  display: none;
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.avatar-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: var(--shadow-avatar);
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.profile-basic {
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.profile-tag {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  background: var(--bg-tag);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.edit-btn {
  flex-shrink: 0;
}

.profile-stats {
  display: flex;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.stat-card {
  flex: 1;
  background: var(--bg-stat-card);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid var(--border-stat);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.stat-card:active {
  transform: scale(0.985);
  border-color: rgba(212,175,55,0.3);
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-number {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-desc {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.stats-section {
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.stats-section::before {
  display: none;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  text-align: center;
  padding: 28rpx 16rpx;
  background: var(--bg-stat-card);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-stat);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.stat-item:active {
  transform: scale(0.985);
  border-color: rgba(212,175,55,0.3);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  color: var(--text-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.settings-card {
  padding: 10rpx;
  position: relative;
  overflow: hidden;
}

.settings-card::before {
  display: none;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 16rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  z-index: 1;
  gap: 20rpx;
}

.setting-item:active {
  background: rgba(212,175,55,0.05);
  transform: scale(0.99);
}

.setting-item + .setting-item {
  border-top: 1rpx solid var(--border-lighter);
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.setting-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  background: var(--bg-tag);
  border: 1rpx solid var(--border-stat);
  flex-shrink: 0;
}

.setting-copy {
  min-width: 0;
  flex: 1;
}

.setting-text {
  font-size: 28rpx;
  color: var(--text-content);
  font-weight: 700;
  margin-bottom: 6rpx;
}

.setting-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.35;
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* ===== 主题切换行（点击弹出选择器） ===== */
.theme-value {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
  white-space: nowrap;
}
