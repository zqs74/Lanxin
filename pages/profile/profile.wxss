/* profile.wxss - 昇梦体育 商城 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 136rpx 28rpx 24rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

.page-header {
  margin-bottom: 28rpx;
  padding-top: 20rpx;
  position: relative;
}

.page-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 0;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.orders-entry {
  position: absolute;
  top: 30rpx;
  right: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  background: var(--bg-tag);
  border: 1rpx solid var(--border-stat);
}

.orders-entry:active {
  transform: scale(0.96);
}

.orders-entry-text {
  font-size: 24rpx;
  color: var(--gold);
  font-weight: 600;
}

/* ===== 分类栏 ===== */
.category-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.category-item {
  padding: 14rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--bg-card-light);
  border: 1rpx solid var(--border-superlight);
  transition: all 0.2s ease;
}

.category-item.active {
  color: #0a0a0a;
  background: var(--gold-gradient);
  border-color: var(--gold);
  font-weight: 800;
  box-shadow: 0 6rpx 18rpx rgba(212,175,55,0.3);
}

/* ===== 商品网格 ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.product-card {
  padding: 0 0 20rpx;
  overflow: hidden;
}

.product-card:active {
  transform: scale(0.98);
}

.product-emoji {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: linear-gradient(135deg, rgba(212,175,55,0.14) 0%, rgba(255,215,0,0.06) 100%);
  border-bottom: 1rpx solid var(--border-superlight);
}

.product-emoji-text {
  font-size: 96rpx;
}

.product-tag {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #0a0a0a;
  background: var(--gold-gradient);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.product-name {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 18rpx 20rpx 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
}

.product-price {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--gold);
  font-family: "Arial Black","DIN Alternate","PingFang SC","Microsoft YaHei",sans-serif;
}

.product-buy {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--gold-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(212,175,55,0.35);
}

.product-buy:active {
  transform: scale(0.94);
}

/* ===== 弹层通用 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease-out;
}

.modal-panel {
  width: 100%;
  max-height: 88vh;
  background: var(--bg-modal);
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: var(--shadow-modal);
  animation: slideUp 0.28s ease-out;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.modal-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 0;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-tag);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ===== 商品详情 ===== */
.detail-emoji {
  height: 300rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(212,175,55,0.14) 0%, rgba(255,215,0,0.06) 100%);
  border: 1rpx solid var(--border-superlight);
  margin-bottom: 24rpx;
}

.detail-emoji-text {
  font-size: 160rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.detail-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.4;
  letter-spacing: 0;
}

.detail-price {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--gold);
  margin-bottom: 16rpx;
  font-family: "Arial Black","DIN Alternate","PingFang SC","Microsoft YaHei",sans-serif;
}

.detail-desc {
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.count-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.count-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-label);
}

.count-stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stepper-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: var(--bg-tag);
  border: 1rpx solid var(--border-stat);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stepper-btn.plus {
  background: var(--gold-gradient);
  color: #0a0a0a;
  border-color: var(--gold);
}

.stepper-btn:active {
  transform: scale(0.94);
}

.stepper-value {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
  min-width: 48rpx;
  text-align: center;
}

.total-row {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: right;
  margin-bottom: 24rpx;
}

.total-price {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--gold);
}

.submit-btn {
  width: 100%;
}

/* ===== 我的订单 ===== */
.orders-list {
  max-height: 56vh;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}

.order-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(212,175,55,0.14) 0%, rgba(255,215,0,0.06) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta {
  font-size: 23rpx;
  color: var(--text-tertiary);
}

.order-total {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--gold);
}

.orders-empty {
  margin: 40rpx 0;
}

.clear-btn {
  width: 100%;
  margin-top: 20rpx;
}
