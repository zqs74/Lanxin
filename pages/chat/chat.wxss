/* chat.wxss - 优化版AI对话界面 */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  background-color: transparent;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

/* 聊天页面顶部栏 */
.chat-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(68, 206, 255, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.1) 100%);
  margin-right: 16rpx;
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  transition: all 0.3s ease;
}

.back-btn:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.2) 0%, rgba(89, 168, 255, 0.2) 100%);
}

.back-icon {
  font-size: 36rpx;
  color: #44ceff;
  font-weight: bold;
}

.header-info {
  flex: 1;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-subtitle {
  font-size: 22rpx;
  color: #999;
}

.ai-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.1) 0%, rgba(115, 209, 61, 0.1) 100%);
  border-radius: 30rpx;
  border: 2rpx solid rgba(82, 196, 26, 0.2);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  border-radius: 50%;
  animation: statusPulse 2s ease-in-out infinite;
}

@keyframes statusPulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.6;
    transform: scale(0.9);
  }
}

.status-text {
  font-size: 20rpx;
  color: #52c41a;
  font-weight: 600;
}

/* 聊天容器 */
.chat-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 30rpx;
}

.message-list {
  flex: 1;
  margin-bottom: 20rpx;
  overflow-y: auto;
}

/* 欢迎区域 */
.welcome-section {
  text-align: center;
  padding: 60rpx 40rpx 40rpx;
}

.welcome-avatar {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin: 0 auto 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(68, 206, 255, 0.4);
  animation: welcomeFloat 3s ease-in-out infinite;
}

@keyframes welcomeFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  max-width: 500rpx;
  margin: 0 auto;
}

.message {
  margin-bottom: 24rpx;
}

.message-content {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.ai-content {
  justify-content: flex-start;
}

.user-content {
  justify-content: flex-end;
  flex-direction: row-reverse;
}

.ai-avatar-small {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.3);
}

.user-avatar-small {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(250, 173, 20, 0.3);
}

.message-bubble {
  max-width: 520rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  line-height: 1.6;
  word-break: break-all;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.ai-content .message-bubble {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.15);
  color: #1a1a1a;
  border-bottom-left-radius: 8rpx;
}

.user-content .message-bubble {
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  border: 2rpx solid rgba(68, 206, 255, 0.3);
  color: white;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(68, 206, 255, 0.35);
}

.message-text {
  font-size: 28rpx;
  line-height: 1.7;
  display: block;
}

.message-time {
  font-size: 20rpx;
  opacity: 0.6;
  margin-top: 8rpx;
  text-align: right;
}

/* 加载中状态 */
.loading {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 0;
}

.loading-bubble {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.15);
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.loading-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  border-radius: 50%;
  animation: dotPulse 1.4s ease-in-out infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 100% {
    opacity: 0.4;
    transform: scale(0.8);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.loading-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

/* 快捷建议问题 */
.quick-suggestions {
  margin-bottom: 24rpx;
}

.suggestion-title {
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.suggestion-scroll {
  width: 100%;
  white-space: nowrap;
}

.suggestion-list {
  display: flex;
  gap: 12rpx;
  padding-right: 30rpx;
}

.suggestion-item {
  padding: 18rpx 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.9) 100%);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #44ceff;
  font-weight: 500;
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.1);
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.suggestion-item:active {
  transform: scale(0.96);
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.08) 100%);
  border-color: rgba(68, 206, 255, 0.4);
}

/* 输入区域 */
.input-area {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(68, 206, 255, 0.08);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  margin: 0 -30rpx;
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
}

.input {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 2rpx solid rgba(68, 206, 255, 0.15);
  border-radius: 50rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #1a1a1a;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.input:focus {
  border-color: #44ceff;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 6rpx rgba(68, 206, 255, 0.12);
}

.input-placeholder {
  color: #aaa;
}

.send-button {
  padding: 0;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.15) 0%, rgba(89, 168, 255, 0.15) 100%);
  color: #44ceff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  border: 2rpx solid rgba(68, 206, 255, 0.25);
  box-shadow: 0 4rpx 12rpx rgba(68, 206, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.send-button.active {
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(68, 206, 255, 0.4);
  border: none;
}

.send-button.active:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(68, 206, 255, 0.35);
}

.send-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-text {
  font-size: 28rpx;
  line-height: 1;
}