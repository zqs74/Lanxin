/* chat.wxss - 昇梦体育 主题适配 DeepSeek-R1 AI对话界面 */

/* ===== 页面容器 ===== */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  background-color: transparent;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

/* ===== 顶部导航栏 ===== */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
}

.nav-title-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.nav-main {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 0;
}

.nav-highlight {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--gold);
  background: none;
  -webkit-background-clip: text;
  -webkit-text-fill-color: currentColor;
  background-clip: text;
  filter: none;
  letter-spacing: 0;
}

.nav-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  letter-spacing: 0;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  background: linear-gradient(135deg, rgba(82,196,26,0.12) 0%, rgba(115,209,61,0.08) 100%);
  border-radius: 30rpx;
  border: 1.5rpx solid rgba(82,196,26,0.25);
  transition: all 0.4s ease;
}

.status-badge.thinking {
  background: linear-gradient(135deg, rgba(100,149,237,0.12) 0%, rgba(123,159,245,0.08) 100%);
  border-color: rgba(100,149,237,0.3);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, var(--text-status-online) 0%, #73d13d 100%);
  border-radius: 50%;
  animation: statusPulse 2s ease-in-out infinite;
}

.thinking .status-dot {
  background: linear-gradient(135deg, var(--text-status-thinking) 0%, #7B9FF5 100%);
  animation: thinkingPulse 1s ease-in-out infinite;
}

@keyframes statusPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.85); } }
@keyframes thinkingPulse { 0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(100,149,237,0.5); } 50% { opacity: 0.7; box-shadow: 0 0 0 10rpx rgba(100,149,237,0); } }

.status-label {
  font-size: 20rpx;
  color: var(--text-status-online);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.thinking .status-label { color: var(--text-status-thinking); }

/* ===== 聊天主区域 ===== */
.chat-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 20rpx;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
}

.message-scroll {
  flex: 1;
  height: 0;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}
.bottom-spacer { height: 40rpx; }

/* ===== 欢迎卡片 ===== */
.welcome-card {
  text-align: left;
  padding: 34rpx;
  margin-bottom: 24rpx;
  animation: fadeInUp 0.32s ease-out;
}

@keyframes fadeInUp { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }

.welcome-icon-wrapper {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(212,175,55,0.24);
  animation: none;
}

.welcome-text { margin-bottom: 28rpx; }

.welcome-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 14rpx;
  letter-spacing: 0;
}

.welcome-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  max-width: 520rpx;
  margin: 0;
}

.feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }

.feature-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 14rpx;
  background: rgba(212,175,55,0.06);
  border-radius: 14rpx;
  border: 1rpx solid rgba(212,175,55,0.12);
  transition: all 0.3s ease;
}

.feature-item:active { background: rgba(212,175,55,0.12); transform: scale(0.96); }
.feature-icon { font-size: 36rpx; }

.feature-name {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 600;
  letter-spacing: 0;
}

/* ===== 消息行布局 ===== */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 32rpx;
  animation: msgSlideIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

@keyframes msgSlideIn { from { opacity: 0; transform: translateY(20rpx) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }

.msg-user { justify-content: flex-end; flex-direction: row; }
.msg-ai { justify-content: flex-start; }

/* ===== 头像 ===== */
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.35);
}

.ai-avatar {
  background: var(--gold-gradient);
  box-shadow: 0 6rpx 20rpx rgba(212,175,55,0.35), 0 0 30rpx rgba(212,175,55,0.12);
}

.ai-avatar.spinning { animation: avatarSpin 3s linear infinite; }
@keyframes avatarSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.user-avatar {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
  box-shadow: 0 6rpx 20rpx rgba(250,173,20,0.3);
}

/* ===== 消息气泡 ===== */
.msg-bubble {
  max-width: calc(100vw - 124rpx);
  padding: 22rpx 22rpx;
  border-radius: 24rpx;
  line-height: 1.75;
  word-break: break-word;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-width: 0;
}

.msg-user .msg-bubble { max-width: calc(100vw - 154rpx); }
.msg-ai .msg-bubble { max-width: calc(100vw - 112rpx); }

.user-bubble {
  background: var(--gold-gradient);
  color: #1a1a1a;
  border-bottom-right-radius: 10rpx;
  box-shadow: 0 8rpx 28rpx rgba(212,175,55,0.4), 0 0 40rpx rgba(212,175,55,0.12);
}

.user-text {
  display: block;
  text-align: left;
  white-space: pre-wrap;
}

.ai-bubble {
  background: var(--bg-card-flat);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1.5rpx solid var(--border-msg-ai);
  color: var(--text-content-alt);
  border-bottom-left-radius: 10rpx;
  box-shadow: var(--shadow-card);
}

.error-bubble { background: rgba(55,18,18,0.97) !important; border-color: rgba(255,77,77,0.3) !important; }

/* ===== 消息内容 ===== */
.msg-content {
  font-size: 28rpx;
  line-height: 1.8;
  display: block;
  word-break: break-all;
  overflow-wrap: break-word;
  max-width: 100%;
}

.user-bubble .msg-content { color: #1a1a1a; font-weight: 500; }
.ai-bubble .msg-content { color: var(--text-content); }

.response-area {
  overflow-x: hidden;
  max-width: 100%;
  width: 100%;
}

.markdown-body {
  font-size: 28rpx;
  line-height: 1.82;
  overflow-x: hidden;
  max-width: 100%;
  width: 100%;
  word-break: break-word;
}
.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4,
.markdown-body p, .markdown-body div, .markdown-body span,
.markdown-body strong, .markdown-body em, .markdown-body text,
.markdown-body li, .markdown-body blockquote {
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
  box-sizing: border-box;
}

.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 { color: var(--gold); font-weight: 800; margin: 18rpx 0 10rpx; letter-spacing: 0; line-height: 1.35; }
.markdown-body h1 { font-size: 34rpx; }
.markdown-body h2 { font-size: 32rpx; }
.markdown-body h3 { font-size: 30rpx; }
.markdown-body h4 { font-size: 28rpx; }
.markdown-body p { margin: 10rpx 0; }
.markdown-body strong, .markdown-body b { color: var(--gold-light); font-weight: 700; }
.markdown-body em, .markdown-body i { color: #F4C430; font-style: italic; }

.markdown-body code {
  background: rgba(212,175,55,0.15);
  color: var(--gold-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  border: 1rpx solid var(--border-code);
}

.markdown-body pre {
  background: var(--bg-input);
  border: 1.5rpx solid var(--border-code-block);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  overflow-x: hidden;
  white-space: pre-wrap;
  word-break: break-all;
}

.markdown-body pre code { background: none; border: none; padding: 0; color: var(--gold); font-size: 24rpx; white-space: pre-wrap; word-break: break-all; }
.markdown-body ul, .markdown-body ol { padding-left: 28rpx; margin: 12rpx 0; max-width: 100%; box-sizing: border-box; }
.markdown-body li { margin: 8rpx 0; color: var(--text-markdown); }
.markdown-body li::marker { color: var(--gold); }

.markdown-body blockquote {
  border-left: 4rpx solid var(--gold);
  padding: 16rpx 24rpx;
  margin: 16rpx 0;
  background: rgba(212,175,55,0.06);
  border-radius: 0 16rpx 16rpx 0;
  color: var(--text-markdown-blockquote);
}

.markdown-body a { color: var(--gold-light); text-decoration: underline; }

.markdown-body table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
  margin: 16rpx 0;
  border: 1.5rpx solid var(--border-card);
  border-radius: 12rpx;
  overflow: hidden;
}

.markdown-body th, .markdown-body td { padding: 14rpx 10rpx; border: 1rpx solid var(--border-light); text-align: left; font-size: 24rpx; word-break: break-all; overflow-wrap: anywhere; }
.markdown-body th { background: rgba(212,175,55,0.12); color: var(--gold); font-weight: 700; }
.markdown-body td { color: var(--text-content); }

.markdown-body hr { border: none; height: 1.5rpx; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent); margin: 24rpx 0; }

.cursor-blink { color: var(--gold); animation: cursorBlink 1s step-end infinite; font-weight: 300; }
@keyframes cursorBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

.error-msg { color: #ff6b6b; font-size: 27rpx; font-weight: 500; }

.msg-time { font-size: 20rpx; opacity: 0.5; margin-top: 12rpx; text-align: right; letter-spacing: 0.5rpx; }
.msg-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; gap: 16rpx; }

.stream-indicator { display: flex; align-items: center; gap: 6rpx; }
.s-dot { width: 8rpx; height: 8rpx; background: var(--gold); border-radius: 50%; animation: sPulse 1.2s ease-in-out infinite; }
.s-dot.d1 { animation-delay: 0.15s; }
.s-dot.d2 { animation-delay: 0.3s; }
@keyframes sPulse { 0%, 100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.3); } }

/* ===== 思维链区域 ===== */
.thinking-box {
  margin-bottom: 18rpx;
  border: 1.5rpx solid var(--border-thinking);
  border-radius: 18rpx;
  overflow: hidden;
  background: var(--bg-thinking);
  animation: thinkingFadeIn 0.4s ease-out;
}

@keyframes thinkingFadeIn { from { opacity: 0; transform: translateY(-10rpx); } to { opacity: 1; transform: translateY(0); } }

.thinking-box.active {
  border-color: var(--border-thinking-active);
  box-shadow: 0 0 24rpx rgba(100,149,237,0.12), inset 0 0 20rpx rgba(100,149,237,0.04);
}

.thinking-header-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  background: var(--thinking-header-bg);
  border-bottom: 1rpx solid var(--thinking-border-bottom);
}

.thinking-header-bar.active { background: var(--thinking-header-bg-active); animation: headerPulse 2.5s ease-in-out infinite; }
@keyframes headerPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }

.thinking-spin { font-size: 28rpx; }
.thinking-spin.spin-anim { animation: thinkSpin 2.5s linear infinite; display: inline-block; }
@keyframes thinkSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.thinking-label { font-size: 24rpx; color: var(--text-status-thinking); font-weight: 700; letter-spacing: 1rpx; flex: 1; }
.thinking-dots { display: flex; gap: 5rpx; }
.t-dot { width: 7rpx; height: 7rpx; background: var(--text-status-thinking); border-radius: 50%; animation: tDot 1.3s ease-in-out infinite; }
.t-dot.delay-1 { animation-delay: 0.2s; }
.t-dot.delay-2 { animation-delay: 0.4s; }
@keyframes tDot { 0%, 100% { opacity: 0.3; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1.2); } }

.thinking-scroll { max-height: 320rpx; padding: 18rpx 20rpx; }
.thinking-scroll.live { max-height: 280rpx; background: var(--bg-thinking-live); }

.thinking-text { font-size: 24rpx; color: var(--text-thinking); line-height: 1.7; white-space: pre-wrap; word-break: break-word; }

.thinking-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  margin: 16rpx 0 8rpx;
  background: var(--bg-thinking-toggle);
  border: 1.5rpx solid var(--border-thinking-toggle);
  border-radius: 14rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  animation: fadeInUp 0.3s ease-out;
}

.thinking-toggle:active { background: rgba(100,149,237,0.15); transform: scale(0.98); }
.toggle-icon { font-size: 24rpx; flex-shrink: 0; }
.toggle-text { font-size: 23rpx; color: var(--text-status-thinking); font-weight: 700; letter-spacing: 0; flex: 1; }

.thinking-content {
  border: 1.5rpx solid var(--border-thinking-toggle);
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--bg-thinking);
  margin: 8rpx 0 16rpx;
  animation: fadeInUp 0.3s ease-out;
}

.thinking-content .thinking-scroll { max-height: 400rpx; padding: 16rpx 20rpx; }
.thinking-content .thinking-text { font-size: 24rpx; color: var(--text-thinking); line-height: 1.6; white-space: pre-wrap; word-break: break-word; }

.waiting-box { display: flex; align-items: center; gap: 18rpx; padding: 8rpx 0; }
.wait-dots { display: flex; gap: 8rpx; }
.w-dot { width: 11rpx; height: 11rpx; background: var(--gold-gradient); border-radius: 50%; animation: wDot 1.4s ease-in-out infinite; }
.w-dot.delay-1 { animation-delay: 0.2s; }
.w-dot.delay-2 { animation-delay: 0.4s; }
@keyframes wDot { 0%, 100% { opacity: 0.35; transform: scale(0.75); } 50% { opacity: 1; transform: scale(1.15); } }
.wait-text { font-size: 25rpx; color: var(--text-secondary); font-weight: 500; letter-spacing: 0.5rpx; }

/* ===== 快捷问题面板 ===== */
.quick-panel { margin-bottom: 24rpx; animation: slideUpAnim 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes slideUpAnim { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }

.quick-title { font-size: 26rpx; color: var(--text-dim); font-weight: 600; margin-bottom: 18rpx; letter-spacing: 1rpx; }
.quick-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }

.quick-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: 1.5rpx solid var(--border-quick-chip);
  background: var(--bg-quick-chip);
}

.quick-chip:active {
  transform: scale(0.95);
  background: var(--bg-quick-chip-hover);
  border-color: var(--border-quick-chip-hover);
  box-shadow: 0 0 24rpx rgba(212,175,55,0.15);
}

.chip-icon { font-size: 32rpx; flex-shrink: 0; }
.chip-text { font-size: 25rpx; color: var(--gold); font-weight: 600; letter-spacing: 0.5rpx; }

/* ===== 输入区域 ===== */
.input-zone { padding: 20rpx 0 0; margin-top: auto; }

.input-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  background: var(--bg-input);
  border: 1.5rpx solid var(--border-msg-ai);
  border-radius: 28rpx;
}

.chat-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--text-content-alt);
  background: transparent;
  border: none;
}

.input-ph { color: var(--text-placeholder); font-weight: 400; }

.send-btn {
  width: 88rpx !important;
  height: 88rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1 !important;
  border-radius: 50% !important;
  background: rgba(212,175,55,0.15) !important;
  color: var(--gold) !important;
  border: 2rpx solid rgba(212,175,55,0.28) !important;
  font-size: 28rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
  box-shadow: 0 4rpx 16rpx rgba(212,175,55,0.12) !important;
}

.send-btn.active {
  background: var(--gold-gradient) !important;
  color: #0a0a0a !important;
  border: none !important;
  box-shadow: 0 8rpx 28rpx rgba(212,175,55,0.45), 0 0 40rpx rgba(212,175,55,0.15) !important;
}

.send-btn.active:active { transform: scale(0.93) !important; box-shadow: 0 4rpx 16rpx rgba(212,175,55,0.35) !important; }
.send-btn.disabled { opacity: 0.5; pointer-events: none; }
.btn-icon { font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; }
