/* chat.wxss - 昇梦体育 主题适配 DeepSeek-R1 AI对话界面 */

/* ===== 页面容器 ===== */
.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.chat-page {
  overflow: hidden;
  padding-bottom: 0;
}

.container {
  background-color: transparent;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.chat-container {
  overflow: hidden;
  padding: 0;
  box-sizing: border-box;
}

/* ===== 顶部导航栏 ===== */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-bottom: 12rpx;
  margin-bottom: 0;
  box-sizing: border-box;
  flex-shrink: 0;
  position: relative;
  z-index: 3;
  background: var(--bg-page-flat);
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
}

.nav-title-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.nav-main {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 0;
}

.nav-highlight {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--gold);
  background: none;
  -webkit-background-clip: text;
  -webkit-text-fill-color: currentColor;
  background-clip: text;
  filter: none;
  letter-spacing: 0;
}

.nav-sub {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  letter-spacing: 0;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  background: linear-gradient(135deg, rgba(82,196,26,0.12) 0%, rgba(115,209,61,0.08) 100%);
  border-radius: 30rpx;
  border: 1.5rpx solid rgba(82,196,26,0.25);
  transition: all 0.4s ease;
  flex-shrink: 0;
}

.status-badge.thinking {
  background: linear-gradient(135deg, rgba(212,175,55,0.14) 0%, rgba(255,215,0,0.08) 100%);
  border-color: rgba(212,175,55,0.28);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, var(--text-status-online) 0%, #73d13d 100%);
  border-radius: 50%;
  animation: statusPulse 2s ease-in-out infinite;
}

.thinking .status-dot {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%);
  animation: thinkingPulse 1s ease-in-out infinite;
}

@keyframes statusPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.85); } }
@keyframes thinkingPulse { 0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(100,149,237,0.5); } 50% { opacity: 0.7; box-shadow: 0 0 0 10rpx rgba(100,149,237,0); } }

.status-label {
  font-size: 20rpx;
  color: var(--text-status-online);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.thinking .status-label { color: var(--gold); }

/* ===== 聊天主区域 ===== */
.chat-body {
  display: flex;
  flex-direction: column;
  padding: 0 20rpx;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  flex-shrink: 0;
}

.message-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}
.bottom-spacer { height: 12rpx; }

/* ===== 欢迎卡片 ===== */
.welcome-card {
  text-align: left;
  padding: 34rpx;
  margin-bottom: 24rpx;
  animation: fadeInUp 0.32s ease-out;
}

@keyframes fadeInUp { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }

.welcome-icon-wrapper {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(212,175,55,0.24);
  animation: none;
}

.welcome-text { margin-bottom: 28rpx; }

.welcome-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 14rpx;
  letter-spacing: 0;
}

.welcome-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  max-width: 520rpx;
  margin: 0;
}

.feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }

.feature-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 14rpx;
  background: rgba(212,175,55,0.06);
  border-radius: 14rpx;
  border: 1rpx solid rgba(212,175,55,0.12);
  transition: all 0.3s ease;
}

.feature-item:active { background: rgba(212,175,55,0.12); transform: scale(0.96); }
.feature-icon { font-size: 36rpx; }

.feature-name {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 600;
  letter-spacing: 0;
}

/* ===== 消息行布局 ===== */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 32rpx;
  animation: msgSlideIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

@keyframes msgSlideIn { from { opacity: 0; transform: translateY(20rpx) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }

.msg-user { justify-content: flex-end; flex-direction: row; }
.msg-ai { justify-content: flex-start; }

/* ===== 头像 ===== */
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.35);
}

.ai-avatar {
  background: var(--gold-gradient);
  box-shadow: 0 6rpx 20rpx rgba(212,175,55,0.35), 0 0 30rpx rgba(212,175,55,0.12);
}

.user-avatar {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
  box-shadow: 0 6rpx 20rpx rgba(250,173,20,0.3);
}

/* ===== 消息气泡 ===== */
.msg-bubble {
  max-width: calc(100vw - 124rpx);
  padding: 22rpx 22rpx;
  border-radius: 24rpx;
  line-height: 1.75;
  word-break: break-word;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-width: 0;
}

.msg-user .msg-bubble { max-width: calc(100vw - 154rpx); }
.msg-ai .msg-bubble { max-width: calc(100vw - 112rpx); }

.user-bubble {
  background: var(--gold-gradient);
  color: #1a1a1a;
  border-bottom-right-radius: 10rpx;
  box-shadow: 0 8rpx 28rpx rgba(212,175,55,0.4), 0 0 40rpx rgba(212,175,55,0.12);
}

.user-text {
  display: block;
  text-align: left;
  white-space: pre-wrap;
}

.ai-bubble {
  background: var(--bg-card-flat);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1.5rpx solid var(--border-msg-ai);
  color: var(--text-content-alt);
  border-bottom-left-radius: 10rpx;
  box-shadow: var(--shadow-card);
}

.error-bubble { background: rgba(55,18,18,0.97) !important; border-color: rgba(255,77,77,0.3) !important; }

/* ===== 消息内容 ===== */
.msg-content {
  font-size: 28rpx;
  line-height: 1.8;
  display: block;
  word-break: break-all;
  overflow-wrap: break-word;
  max-width: 100%;
}

.user-bubble .msg-content { color: #1a1a1a; font-weight: 500; }
.ai-bubble .msg-content { color: var(--text-content); }

.response-area {
  overflow-x: hidden;
  max-width: 100%;
  width: 100%;
}

.markdown-heading,
.markdown-p,
.markdown-list,
.markdown-quote,
.markdown-code-block,
.markdown-table-card,
.flow-graph {
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.markdown-heading {
  color: var(--gold);
  font-weight: 800;
  line-height: 1.42;
  margin: 34rpx 0 18rpx;
  letter-spacing: 0;
  word-break: break-word;
}

.response-area > .markdown-heading:first-child {
  margin-top: 0;
}

.markdown-h1 { font-size: 34rpx; }
.markdown-h2 { font-size: 32rpx; }
.markdown-h3 { font-size: 30rpx; }
.markdown-h4 { font-size: 28rpx; }

.markdown-p {
  font-size: 28rpx;
  line-height: 1.86;
  color: var(--text-content);
  margin: 14rpx 0;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

.md-span {
  max-width: 100%;
  word-break: break-word;
  overflow-wrap: break-word;
}

.md-span.strong {
  color: var(--text-primary);
  font-weight: 800;
}

.md-span.em {
  color: var(--gold);
  font-style: italic;
}

.md-span.code {
  display: inline;
  padding: 2rpx 10rpx;
  margin: 0 2rpx;
  border-radius: 8rpx;
  color: var(--gold);
  background: rgba(212,175,55,0.12);
  border: 1rpx solid var(--border-code);
  font-family: "SF Mono", Consolas, "Courier New", monospace;
  font-size: 24rpx;
}

.md-span.delete {
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.md-span.link {
  color: var(--gold);
  text-decoration: underline;
}

.md-line-break {
  display: block;
  height: 10rpx;
}

.markdown-list {
  margin: 16rpx 0;
}

.markdown-list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 10rpx 0;
  color: var(--text-content);
  font-size: 28rpx;
  line-height: 1.78;
}

.list-marker {
  min-width: 34rpx;
  color: var(--gold);
  font-weight: 800;
  line-height: 1.78;
  flex-shrink: 0;
}

.markdown-list.ordered .list-marker {
  min-width: 44rpx;
  text-align: right;
}

.list-content {
  flex: 1;
  min-width: 0;
  word-break: break-word;
  overflow-wrap: break-word;
}

.markdown-quote {
  margin: 18rpx 0;
  padding: 16rpx 20rpx;
  border-left: 5rpx solid var(--gold);
  border-radius: 0 16rpx 16rpx 0;
  background: rgba(212,175,55,0.07);
  color: var(--text-markdown-blockquote);
  font-size: 26rpx;
  line-height: 1.75;
  word-break: break-word;
}

.markdown-code-block {
  margin: 18rpx 0;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-code-block);
  color: var(--gold);
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
  font-family: "SF Mono", Consolas, "Courier New", monospace;
}

.markdown-divider {
  height: 1rpx;
  margin: 26rpx 0;
  background: linear-gradient(90deg, transparent, rgba(212,175,55,0.38), transparent);
}

.markdown-body {
  font-size: 28rpx;
  line-height: 1.82;
  overflow-x: hidden;
  max-width: 100%;
  width: 100%;
  word-break: break-word;
}
.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4,
.markdown-body p, .markdown-body div, .markdown-body span,
.markdown-body strong, .markdown-body em, .markdown-body text,
.markdown-body li, .markdown-body blockquote {
  max-width: 100%;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
  box-sizing: border-box;
}

.markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 { color: var(--gold); font-weight: 800; margin: 34rpx 0 18rpx; letter-spacing: 0; line-height: 1.38; }
.markdown-body h1:first-child, .markdown-body h2:first-child, .markdown-body h3:first-child, .markdown-body h4:first-child { margin-top: 8rpx; }
.markdown-body h1 { font-size: 34rpx; }
.markdown-body h2 { font-size: 32rpx; }
.markdown-body h3 { font-size: 30rpx; }
.markdown-body h4 { font-size: 28rpx; }
.markdown-body p { margin: 14rpx 0; }
.markdown-body strong, .markdown-body b { color: var(--gold-light); font-weight: 700; }
.markdown-body em, .markdown-body i { color: #F4C430; font-style: italic; }

.markdown-body code {
  background: rgba(212,175,55,0.15);
  color: var(--gold-light);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  border: 1rpx solid var(--border-code);
}

.markdown-body pre {
  background: var(--bg-input);
  border: 1.5rpx solid var(--border-code-block);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  overflow-x: hidden;
  white-space: pre-wrap;
  word-break: break-all;
}

.markdown-body pre code { background: none; border: none; padding: 0; color: var(--gold); font-size: 24rpx; white-space: pre-wrap; word-break: break-all; }
.markdown-body ul, .markdown-body ol { padding-left: 28rpx; margin: 12rpx 0; max-width: 100%; box-sizing: border-box; }
.markdown-body li { margin: 8rpx 0; color: var(--text-markdown); }
.markdown-body li::marker { color: var(--gold); }

.markdown-body blockquote {
  border-left: 4rpx solid var(--gold);
  padding: 16rpx 24rpx;
  margin: 16rpx 0;
  background: rgba(212,175,55,0.06);
  border-radius: 0 16rpx 16rpx 0;
  color: var(--text-markdown-blockquote);
}

.markdown-body a { color: var(--gold-light); text-decoration: underline; }

.markdown-table-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 22rpx 0;
}

.table-row-card {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--border-light);
  background: rgba(212,175,55,0.045);
}

.table-cell-card {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--border-superlight);
}

.table-cell-card:last-child {
  border-bottom: none;
}

.table-cell-label {
  color: var(--gold);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.55;
  word-break: break-word;
}

.table-cell-value {
  color: var(--text-content);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.55;
  word-break: break-word;
}

.flow-graph {
  margin: 24rpx 0;
  padding: 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--border-light);
  background: rgba(212,175,55,0.045);
}

.flow-lr {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.flow-td {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.flow-node-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.flow-td .flow-node-wrap {
  flex-direction: column;
  align-items: stretch;
}

.flow-node {
  max-width: 100%;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  color: var(--text-primary);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
  background: var(--bg-card-flat);
  border: 1rpx solid var(--border-stat);
  box-shadow: var(--shadow-soft);
  word-break: break-word;
}

.flow-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.markdown-body hr { border: none; height: 1.5rpx; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent); margin: 24rpx 0; }

.cursor-blink { color: var(--gold); animation: cursorBlink 1s step-end infinite; font-weight: 300; }
@keyframes cursorBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

.error-msg { color: #ff6b6b; font-size: 27rpx; font-weight: 500; }

.msg-time { font-size: 20rpx; opacity: 0.5; margin-top: 12rpx; text-align: right; letter-spacing: 0.5rpx; }
.msg-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; gap: 16rpx; }

.stream-indicator { display: flex; align-items: center; gap: 6rpx; }
.s-dot { width: 8rpx; height: 8rpx; background: var(--gold); border-radius: 50%; animation: sPulse 1.2s ease-in-out infinite; }
.s-dot.d1 { animation-delay: 0.15s; }
.s-dot.d2 { animation-delay: 0.3s; }
@keyframes sPulse { 0%, 100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.3); } }

/* ===== 思考状态 ===== */
.thinking-shimmer {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  max-width: 100%;
  padding: 6rpx 0;
}

.thinking-shimmer-text {
  position: relative;
  display: inline-block;
  color: var(--gold);
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.6;
  overflow: hidden;
  background: linear-gradient(90deg, #B8860B 0%, #D4AF37 28%, #FFD700 50%, #D4AF37 72%, #B8860B 100%);
  background-size: 220% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: thinkingShimmer 1.6s ease-in-out infinite;
}

@keyframes thinkingShimmer {
  0% { background-position: 120% 0; opacity: 0.72; }
  50% { opacity: 1; }
  100% { background-position: -120% 0; opacity: 0.78; }
}

.waiting-box { display: flex; align-items: center; gap: 18rpx; padding: 8rpx 0; }
.wait-dots { display: flex; gap: 8rpx; }
.w-dot { width: 11rpx; height: 11rpx; background: var(--gold-gradient); border-radius: 50%; animation: wDot 1.4s ease-in-out infinite; }
.w-dot.delay-1 { animation-delay: 0.2s; }
.w-dot.delay-2 { animation-delay: 0.4s; }
@keyframes wDot { 0%, 100% { opacity: 0.35; transform: scale(0.75); } 50% { opacity: 1; transform: scale(1.15); } }
.wait-text { font-size: 25rpx; color: var(--text-secondary); font-weight: 500; letter-spacing: 0.5rpx; }

/* ===== 快捷问题面板 ===== */
.quick-panel { margin-bottom: 24rpx; animation: slideUpAnim 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes slideUpAnim { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }

.quick-title { font-size: 26rpx; color: var(--text-dim); font-weight: 600; margin-bottom: 18rpx; letter-spacing: 1rpx; }
.quick-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }

.quick-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: 1.5rpx solid var(--border-quick-chip);
  background: var(--bg-quick-chip);
}

.quick-chip:active {
  transform: scale(0.95);
  background: var(--bg-quick-chip-hover);
  border-color: var(--border-quick-chip-hover);
  box-shadow: 0 0 24rpx rgba(212,175,55,0.15);
}

.chip-icon { font-size: 32rpx; flex-shrink: 0; }
.chip-text { font-size: 25rpx; color: var(--gold); font-weight: 600; letter-spacing: 0.5rpx; }

/* ===== 输入区域 ===== */
.input-zone {
  padding: 12rpx 0 0;
  margin-top: 0;
  box-sizing: border-box;
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
}

.input-box {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  background: var(--bg-input);
  border: 1.5rpx solid var(--border-msg-ai);
  border-radius: 28rpx;
}

.chat-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--text-content-alt);
  background: transparent;
  border: none;
}

.input-ph { color: var(--text-placeholder); font-weight: 400; }

.send-btn {
  width: 88rpx !important;
  height: 88rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1 !important;
  border-radius: 50% !important;
  background: rgba(212,175,55,0.15) !important;
  color: var(--gold) !important;
  border: 2rpx solid rgba(212,175,55,0.28) !important;
  font-size: 28rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
  box-shadow: 0 4rpx 16rpx rgba(212,175,55,0.12) !important;
}

.send-btn.active {
  background: var(--gold-gradient) !important;
  color: #0a0a0a !important;
  border: none !important;
  box-shadow: 0 8rpx 28rpx rgba(212,175,55,0.45), 0 0 40rpx rgba(212,175,55,0.15) !important;
}

.send-btn.active:active { transform: scale(0.93) !important; box-shadow: 0 4rpx 16rpx rgba(212,175,55,0.35) !important; }
.send-btn.disabled { opacity: 0.5; pointer-events: none; }
.btn-icon { font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; }
