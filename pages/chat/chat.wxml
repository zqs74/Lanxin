<!-- chat.wxml - 昇梦体育 DeepSeek-R1 AI对话界面 -->
<view class="page-wrapper {{themeClass}}">
  <view class="page-header-gradient"></view>
  
  <view class="container">
    <!-- 顶部导航栏 -->
    <view class="top-nav">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">←</text>
      </view>
      <view class="nav-center">
        <view class="nav-title-row">
          <text class="nav-main">昇梦</text>
          <text class="nav-highlight">AI</text>
        </view>
        <text class="nav-sub">DeepSeek-R1 智能训练顾问</text>
      </view>
      <view class="status-badge {{ isLoading ? 'thinking' : '' }}">
        <view class="status-dot"></view>
        <text class="status-label">{{ isLoading ? '思考中' : '在线' }}</text>
      </view>
    </view>

    <!-- 聊天主区域 -->
    <view class="chat-body">
      <!-- 消息列表 -->
      <scroll-view 
        class="message-scroll" 
        scroll-y 
        scroll-into-view="{{ scrollToView }}" 
        scroll-with-animation
        enhanced
        show-scrollbar="{{false}}"
      >
        
        <!-- 欢迎区域 -->
        <view class="welcome-card card" id="msg-welcome" wx:if="{{ messages.length === 0 }}">
          <view class="welcome-icon-wrapper gradient-bg">
            <text class="welcome-emoji">🤖</text>
          </view>
          
          <view class="welcome-text">
            <view class="welcome-title">你好！我是昇梦赛事AI</view>
            <view class="welcome-desc">基于 DeepSeek-R1 深度思考模型，为你提供专业的篮球训练建议</view>
          </view>
          
          <view class="feature-grid">
            <view class="feature-item">
              <text class="feature-icon">🧠</text>
              <text class="feature-name">深度思考</text>
            </view>
            <view class="feature-item">
              <text class="feature-icon">⚡</text>
              <text class="feature-name">流式响应</text>
            </view>
            <view class="feature-item">
              <text class="feature-icon">🎯</text>
              <text class="feature-name">个性定制</text>
            </view>
            <view class="feature-item">
              <text class="feature-icon">💡</text>
              <text class="feature-name">专业建议</text>
            </view>
          </view>
        </view>

        <!-- 消息列表渲染 -->
        <block wx:for="{{ messages }}" wx:key="index">
          
          <!-- 用户消息（右侧） -->
          <view class="msg-row msg-user" wx:if="{{ item.role === 'user' }}" id="msg-{{index + 1}}">
            <view class="msg-bubble user-bubble card-gradient">
              <rich-text class="msg-content" nodes="{{ item.content }}"></rich-text>
              <view class="msg-time">{{ item.time }}</view>
            </view>
            <view class="avatar user-avatar">👤</view>
          </view>

          <!-- AI消息（左侧） -->
          <view class="msg-row msg-ai" wx:if="{{ item.role === 'assistant' && !item.isError }}" id="msg-{{index + 1 }}">
            <view class="avatar ai-avatar gradient-bg">🤖</view>
            <view class="msg-bubble ai-bubble glass-effect-dark">
              
              <!-- 流式输出时的思维链展示 -->
              <view class="thinking-box" wx:if="{{ item.isStreaming && item.thinking }}">
                <view class="thinking-header-bar">
                  <text class="thinking-spin">💭</text>
                  <text class="thinking-label">正在深度思考...</text>
                  <view class="thinking-dots">
                    <view class="t-dot"></view>
                    <view class="t-dot delay-1"></view>
                    <view class="t-dot delay-2"></view>
                  </view>
                </view>
                <scroll-view class="thinking-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                  <text class="thinking-live">{{ item.thinking }}▌</text>
                </scroll-view>
              </view>

              <!-- 回复内容（Markdown） -->
              <view class="response-area">
                <rich-text class="msg-content markdown-body" nodes="{{ item.renderedContent || item.content }}"></rich-text>
                <text class="cursor-blink" wx:if="{{ item.isStreaming }}">▌</text>
              </view>

              <!-- 思考过程显示/隐藏按钮 -->
              <view class="thinking-toggle" wx:if="{{ item.thinking && !item.isStreaming }}" bindtap="toggleThinking" data-index="{{ index }}">
                <text class="toggle-icon">{{ item.showThinking ? '📝' : '💭' }}</text>
                <text class="toggle-text">{{ item.showThinking ? '隐藏思考过程' : '查看思考过程' }}</text>
              </view>

              <!-- 思考过程内容 -->
              <view class="thinking-content" wx:if="{{ item.thinking && item.showThinking && !item.isStreaming }}">
                <scroll-view class="thinking-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                  <text class="thinking-text">{{ item.thinking }}</text>
                </scroll-view>
              </view>

              <!-- 底部信息栏 -->
              <view class="msg-footer">
                <text class="msg-time">{{ item.time }}</text>
                <view class="stream-indicator" wx:if="{{ item.isStreaming }}">
                  <view class="s-dot"></view>
                  <view class="s-dot d1"></view>
                  <view class="s-dot d2"></view>
                </view>
              </view>

            </view>
          </view>

          <!-- 错误消息 -->
          <view class="msg-row msg-ai" wx:if="{{ item.role === 'assistant' && item.isError }}" id="msg-{{index + 1 }}">
            <view class="avatar ai-avatar gradient-bg">⚠️</view>
            <view class="msg-bubble error-bubble">
              <text class="error-msg">{{ item.content }}</text>
              <view class="msg-time">{{ item.time }}</view>
            </view>
          </view>

        </block>

        <!-- AI思考中状态（独立显示在底部） -->
        <view class="msg-row msg-ai thinking-state" wx:if="{{ isLoading && isThinking && currentThinking && !hasAssistantMsg }}" id="msg-loading">
          <view class="avatar ai-avatar gradient-bg spinning">🤖</view>
          <view class="msg-bubble ai-bubble glass-effect-dark">
            <view class="thinking-box active">
              <view class="thinking-header-bar active">
                <text class="thinking-spin spin-anim">💭</text>
                <text class="thinking-label">正在深度思考...</text>
              </view>
              <scroll-view class="thinking-scroll live" scroll-y enhanced show-scrollbar="{{false}}">
                <text class="thinking-live">{{ currentThinking }}▌</text>
              </scroll-view>
            </view>
          </view>
        </view>

        <!-- 等待响应状态 -->
        <view class="msg-row msg-ai" wx:if="{{ isLoading && !isThinking }}" id="msg-loading">
          <view class="avatar ai-avatar gradient-bg">🤖</view>
          <view class="msg-bubble ai-bubble glass-effect-dark">
            <view class="waiting-box">
              <view class="wait-dots">
                <view class="w-dot"></view>
                <view class="w-dot delay-1"></view>
                <view class="w-dot delay-2"></view>
              </view>
              <text class="wait-text">AI正在分析你的数据...</text>
            </view>
          </view>
        </view>

        <!-- 底部占位 -->
        <view class="bottom-spacer"></view>

      </scroll-view>

      <!-- 快捷问题（无消息时显示） -->
      <view class="quick-panel" wx:if="{{!isLoading && messages.length === 0}}">
        <view class="quick-title">你可以问我：</view>
        <view class="quick-list">
          <view class="quick-chip card" bindtap="sendQuickQuestion" data-question="分析我的投篮能力，给出改进建议">
            <text class="chip-icon">🎯</text>
            <text class="chip-text">分析我的投篮</text>
          </view>
          <view class="quick-chip card" bindtap="sendQuickQuestion" data-question="根据我的技能雷达图，推荐今天的训练计划">
            <text class="chip-icon">📋</text>
            <text class="chip-text">推荐训练计划</text>
          </view>
          <view class="quick-chip card" bindtap="sendQuickQuestion" data-question="如何提高我的防守能力？">
            <text class="chip-icon">🛡️</text>
            <text class="chip-text">提高防守能力</text>
          </view>
          <view class="quick-chip card" bindtap="sendQuickQuestion" data-question="帮我分析最近的训练记录">
            <text class="chip-icon">📊</text>
            <text class="chip-text">分析训练记录</text>
          </view>
        </view>
      </view>

      <!-- 输入区域 -->
      <view class="input-zone">
        <view class="input-box card">
          <input 
            type="text"
            placeholder="和AI聊聊你的训练..." 
            class="chat-input" 
            bindinput="onInputChange" 
            value="{{ userInput }}" 
            bindconfirm="sendMessage"
            confirm-type="send"
            placeholder-class="input-ph"
            disabled="{{ isLoading }}"
          ></input>
          <button class="send-btn {{ userInput ? 'active' : '' }} {{ isLoading ? 'disabled' : ''}}" bindtap="sendMessage">
            <text class="btn-icon">{{ isLoading ? '⏳' : (userInput ? '发送' : '💬') }}</text>
          </button>
        </view>
      </view>

    </view>
  </view>
</view>
