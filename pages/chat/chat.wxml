<!-- chat.wxml - 昇梦体育 AI辅助对话界面 -->
<page-meta background-color="{{pageBg}}" root-background-color="{{pageBg}}" page-style="background:{{pageBg}}" />
<view class="page-wrapper chat-page {{themeClass}}" style="height: {{windowHeight}}px;">
  <view class="page-header-gradient"></view>
  
  <view class="container chat-container" style="height: {{windowHeight}}px;">
    <!-- 顶部导航栏 -->
    <view class="top-nav" style="height: {{navHeight}}px; padding-top: {{navTop}}px;">
      <view class="page-back-btn" bindtap="goBack">
        <t-icon name="chevron-left" size="42rpx" color="#D4AF37" />
      </view>
      <view class="nav-center">
        <view class="nav-title-row">
          <text class="nav-main">AI</text>
          <text class="nav-highlight">篮球赛训助手</text>
        </view>
        <text class="nav-sub">东莞篮球 AI 辅助助手</text>
      </view>
      <view class="status-badge {{ isLoading ? 'thinking' : '' }}">
        <view class="status-dot"></view>
        <text class="status-label">{{ isLoading ? '思考中' : '在线' }}</text>
      </view>
    </view>

    <!-- 聊天主区域 -->
    <view class="chat-body" style="height: {{chatBodyHeight}}px;">
      <!-- 消息列表 -->
      <scroll-view 
        class="message-scroll" 
        scroll-y 
        scroll-into-view="{{ scrollToView }}" 
        scroll-with-animation
        enhanced
        show-scrollbar="{{false}}"
      >
        
        <!-- 欢迎区域 -->
        <view class="welcome-card card" id="msg-welcome" wx:if="{{ messages.length === 0 }}">
          <view class="welcome-icon-wrapper gradient-bg">
            <t-icon name="robot" size="72rpx" color="#0a0a0a" />
          </view>
          
          <view class="welcome-text">
            <view class="welcome-title">赛事规划助手</view>
            <view class="welcome-desc">AI 辅助提供东莞篮球训练与赛事筹备建议，内容仅供参考，价格、档期及规则需核实</view>
          </view>
          
          <view class="feature-grid">
            <view class="feature-item">
              <t-icon class="feature-icon" name="lightbulb" size="36rpx" color="#D4AF37" />
              <text class="feature-name">方案定制</text>
            </view>
            <view class="feature-item">
              <t-icon class="feature-icon" name="flashlight" size="36rpx" color="#D4AF37" />
              <text class="feature-name">实时响应</text>
            </view>
            <view class="feature-item">
              <t-icon class="feature-icon" name="chart-pie" size="36rpx" color="#D4AF37" />
              <text class="feature-name">费用明细</text>
            </view>
            <view class="feature-item">
              <t-icon class="feature-icon" name="shield" size="36rpx" color="#D4AF37" />
              <text class="feature-name">风险预案</text>
            </view>
          </view>
        </view>

        <!-- 消息列表渲染 -->
        <block wx:for="{{ messages }}" wx:key="index">
          
          <!-- 用户消息（右侧） -->
          <view class="msg-row msg-user" wx:if="{{ item.role === 'user' }}" id="msg-{{index + 1}}">
            <view class="msg-bubble user-bubble card-gradient">
              <text class="msg-content user-text">{{ item.content }}</text>
              <view class="msg-time">{{ item.time }}</view>
            </view>
            <view class="avatar user-avatar"><t-icon name="user" size="34rpx" color="#1a1a1a" /></view>
          </view>

          <!-- AI消息（左侧） -->
          <view class="msg-row msg-ai" wx:if="{{ item.role === 'assistant' && !item.isError }}" id="msg-{{index + 1}}">
            <view class="avatar ai-avatar gradient-bg"><t-icon name="robot" size="34rpx" color="#0a0a0a" /></view>
            <view class="msg-bubble ai-bubble glass-effect-dark">
              <!-- 回复内容（Markdown） -->
              <view class="response-area">
                <block wx:for="{{ item.renderedBlocks }}" wx:for-item="block" wx:for-index="blockIndex" wx:key="blockIndex">
                  <view wx:if="{{ block.type === 'heading' }}" class="markdown-heading markdown-h{{ block.level }}">
                    <block wx:for="{{ block.spans }}" wx:for-item="span" wx:for-index="spanIndex" wx:key="spanIndex">
                      <text wx:if="{{ span.type !== 'break' }}" class="md-span {{ span.type }}">{{ span.text }}</text>
                    </block>
                  </view>

                  <view wx:elif="{{ block.type === 'paragraph' }}" class="markdown-p">
                    <block wx:for="{{ block.spans }}" wx:for-item="span" wx:for-index="spanIndex" wx:key="spanIndex">
                      <view wx:if="{{ span.type === 'break' }}" class="md-line-break"></view>
                      <text wx:else class="md-span {{ span.type }}">{{ span.text }}</text>
                    </block>
                  </view>

                  <view wx:elif="{{ block.type === 'list' }}" class="markdown-list {{ block.ordered ? 'ordered' : 'unordered' }}">
                    <view class="markdown-list-item" wx:for="{{ block.items }}" wx:for-item="listItem" wx:for-index="listIndex" wx:key="listIndex">
                      <text class="list-marker">{{ listItem.marker }}</text>
                      <view class="list-content">
                        <block wx:for="{{ listItem.spans }}" wx:for-item="span" wx:for-index="spanIndex" wx:key="spanIndex">
                          <view wx:if="{{ span.type === 'break' }}" class="md-line-break"></view>
                          <text wx:else class="md-span {{ span.type }}">{{ span.text }}</text>
                        </block>
                      </view>
                    </view>
                  </view>

                  <view wx:elif="{{ block.type === 'quote' }}" class="markdown-quote">
                    <block wx:for="{{ block.spans }}" wx:for-item="span" wx:for-index="spanIndex" wx:key="spanIndex">
                      <view wx:if="{{ span.type === 'break' }}" class="md-line-break"></view>
                      <text wx:else class="md-span {{ span.type }}">{{ span.text }}</text>
                    </block>
                  </view>

                  <view wx:elif="{{ block.type === 'code' }}" class="markdown-code-block">
                    <text>{{ block.text }}</text>
                  </view>

                  <view wx:elif="{{ block.type === 'divider' }}" class="markdown-divider"></view>

                  <view wx:elif="{{ block.type === 'table' }}" class="markdown-table-card">
                    <view class="table-row-card" wx:for="{{ block.rows }}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex">
                      <view class="table-cell-card" wx:for="{{ row }}" wx:for-item="cell" wx:for-index="cellIndex" wx:key="cellIndex">
                        <text class="table-cell-label">{{ cell.header }}</text>
                        <view class="table-cell-value">
                          <block wx:for="{{ cell.spans }}" wx:for-item="span" wx:for-index="spanIndex" wx:key="spanIndex">
                            <view wx:if="{{ span.type === 'break' }}" class="md-line-break"></view>
                            <text wx:else class="md-span {{ span.type }}">{{ span.text }}</text>
                          </block>
                        </view>
                      </view>
                    </view>
                  </view>

                  <view wx:elif="{{ block.type === 'graph' }}" class="flow-graph {{ block.graph.direction === 'LR' ? 'flow-lr' : 'flow-td' }}">
                    <view class="flow-node-wrap" wx:for="{{ block.graph.nodes }}" wx:for-item="node" wx:for-index="nodeIndex" wx:key="id">
                      <view class="flow-node">{{ node.label }}</view>
                      <view class="flow-arrow" wx:if="{{ nodeIndex < block.graph.nodes.length - 1 }}">
                        <t-icon name="{{ block.graph.direction === 'LR' ? 'chevron-right' : 'chevron-down' }}" size="26rpx" color="#D4AF37" />
                      </view>
                    </view>
                  </view>
                </block>
                <text class="cursor-blink" wx:if="{{ item.isStreaming }}">▌</text>
              </view>

              <!-- 底部信息栏 -->
              <view class="msg-footer">
                <text class="msg-time">{{ item.time }}</text>
                <view class="stream-indicator" wx:if="{{ item.isStreaming }}">
                  <view class="s-dot"></view>
                  <view class="s-dot d1"></view>
                  <view class="s-dot d2"></view>
                </view>
              </view>

            </view>
          </view>

          <!-- 错误消息 -->
          <view class="msg-row msg-ai" wx:if="{{ item.role === 'assistant' && item.isError }}" id="msg-{{index + 1}}">
            <view class="avatar ai-avatar gradient-bg"><t-icon name="error-triangle" size="34rpx" color="#0a0a0a" /></view>
            <view class="msg-bubble error-bubble">
              <text class="error-msg">{{ item.content }}</text>
              <view class="msg-time">{{ item.time }}</view>
            </view>
          </view>

        </block>

        <!-- AI思考中状态（独立显示在底部） -->
        <view class="msg-row msg-ai thinking-state" wx:if="{{ isLoading && isThinking && currentThinking && !hasAssistantMsg }}" id="msg-loading">
          <view class="avatar ai-avatar gradient-bg"><t-icon name="robot" size="34rpx" color="#0a0a0a" /></view>
          <view class="msg-bubble ai-bubble glass-effect-dark">
            <view class="thinking-shimmer">
              <t-icon name="chat-bubble" size="28rpx" color="#D4AF37" />
              <text class="thinking-shimmer-text">正在深度思考...</text>
            </view>
          </view>
        </view>

        <!-- 等待响应状态 -->
        <view class="msg-row msg-ai" wx:if="{{ isLoading && !isThinking }}" id="msg-loading">
          <view class="avatar ai-avatar gradient-bg"><t-icon name="robot" size="34rpx" color="#0a0a0a" /></view>
          <view class="msg-bubble ai-bubble glass-effect-dark">
            <view class="waiting-box">
              <view class="wait-dots">
                <view class="w-dot"></view>
                <view class="w-dot delay-1"></view>
                <view class="w-dot delay-2"></view>
              </view>
              <text class="wait-text">AI正在分析你的数据...</text>
            </view>
          </view>
        </view>

        <view id="msg-bottom" class="bottom-spacer"></view>

      </scroll-view>

      <!-- 快捷问题（无消息时显示） -->
      <view class="quick-panel" wx:if="{{!isLoading && messages.length === 0}}">
        <view class="quick-title">你可以问我：</view>
        <view class="quick-list">
          <view class="quick-chip card" bindtap="sendQuickQuestion" data-question="帮我拟定东莞篮球赛事筹备方案，预计 24 支队伍，日期待确认">
            <t-icon class="chip-icon" name="calendar" size="32rpx" color="#D4AF37" />
            <text class="chip-text">拟定赛事方案</text>
          </view>
          <view class="quick-chip card" bindtap="sendQuickQuestion" data-question="U10 组单场赛事的费用明细大概是多少？">
            <t-icon class="chip-icon" name="rmb" size="32rpx" color="#D4AF37" />
            <text class="chip-text">查看费用明细</text>
          </view>
          <view class="quick-chip card" bindtap="sendQuickQuestion" data-question="篮球赛事赞助合作通常需要确认哪些权益？">
            <t-icon class="chip-icon" name="gift" size="32rpx" color="#D4AF37" />
            <text class="chip-text">赞助商权益说明</text>
          </view>
          <view class="quick-chip card" bindtap="sendQuickQuestion" data-question="在东莞筹备篮球赛事，应如何核实场馆容量和档期？">
            <t-icon class="chip-icon" name="map-pin" size="32rpx" color="#D4AF37" />
            <text class="chip-text">场馆承载量查询</text>
          </view>
        </view>
      </view>

      <!-- 输入区域 -->
      <view class="input-zone" style="height: {{inputHeight}}px; padding-bottom: {{inputBottomInset}}px;">
        <view class="input-box card">
          <input 
            type="text"
            placeholder="和AI聊聊你的训练..." 
            class="chat-input" 
            bindinput="onInputChange" 
            value="{{ userInput }}" 
            bindconfirm="sendMessage"
            confirm-type="send"
            placeholder-class="input-ph"
            disabled="{{ isLoading }}"
          ></input>
          <button class="send-btn {{ userInput ? 'active' : '' }} {{ isLoading ? 'disabled' : ''}}" bindtap="sendMessage">
            <text wx:if="{{ userInput && !isLoading }}" class="btn-icon">发送</text>
            <t-icon wx:elif="{{ isLoading }}" class="btn-icon" name="hourglass" size="30rpx" color="#D4AF37" />
            <t-icon wx:else class="btn-icon" name="chat-bubble" size="30rpx" color="#D4AF37" />
          </button>
        </view>
      </view>

    </view>
  </view>
</view>

<!-- On-demand WeChat privacy authorization; absent from the normal page layout. -->
<view wx:if="{{privacyVisible}}" style="position:fixed;top:0;right:0;bottom:0;left:0;z-index:9999;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;">
  <view class="card {{themeClass}}" style="width:600rpx;box-sizing:border-box;padding:32rpx;display:flex;flex-direction:column;gap:20rpx;background:var(--bg-card,#ffffff);color:var(--text-primary,#222222);">
    <view>继续前请阅读并同意隐私保护指引</view>
    <button class="btn btn-ghost" bindtap="openPrivacyContract">{{privacyContractName}}</button>
    <button id="privacy-agree" class="btn btn-primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacyAuthorization">同意并继续</button>
    <button class="btn btn-ghost" bindtap="cancelPrivacyAuthorization">取消</button>
  </view>
</view>
