<!-- chat.wxml - 优化版AI对话界面 -->
<view class="page-wrapper">
  <view class="page-header-gradient"></view>
  
  <view class="container">
    <!-- 页面顶部栏 -->
    <view class="chat-header">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">←</text>
      </view>
      <view class="header-info">
        <view class="header-title">昇梦AI助手</view>
        <view class="header-subtitle">你的专属篮球训练顾问</view>
      </view>
      <view class="ai-status">
        <view class="status-dot"></view>
        <text class="status-text">在线</text>
      </view>
    </view>

    <view class="chat-container">
      <!-- 聊天消息列表 -->
      <scroll-view class="message-list" scroll-y scroll-into-view="{{ scrollToView }}" scroll-with-animation>
        <!-- AI欢迎消息 -->
        <view class="welcome-section" id="msg-welcome">
          <view class="welcome-avatar">🤖</view>
          <view class="welcome-title">你好！我是昇梦AI</view>
          <view class="welcome-desc">基于你的训练数据和比赛记录，为你提供专业的篮球训练建议。</view>
        </view>
        
        <!-- AI消息 -->
        <view class="message ai-message" wx:for="{{ messages }}" wx:key="index" id="msg-{{index + 1}}">
          <view wx:if="{{ item.role === 'assistant' }}" class="message-content ai-content">
            <view class="ai-avatar-small">🤖</view>
            <view class="message-bubble">
              <text class="message-text">{{ item.content }}</text>
              <view class="message-time">{{ item.time }}</view>
            </view>
          </view>
          <!-- 用户消息 -->
          <view wx:if="{{ item.role === 'user' }}" class="message-content user-content">
            <view class="message-bubble">
              <text class="message-text">{{ item.content }}</text>
              <view class="message-time">{{ item.time }}</view>
            </view>
            <view class="user-avatar-small">👤</view>
          </view>
        </view>
        
        <!-- 加载中状态 -->
        <view class="loading" wx:if="{{ isLoading }}" id="msg-loading">
          <view class="ai-avatar-small">🤖</view>
          <view class="loading-bubble">
            <view class="loading-dots">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
            <text class="loading-text">AI正在分析你的数据...</text>
          </view>
        </view>
      </scroll-view>
      
      <!-- 快捷问题建议 -->
      <view class="quick-suggestions" wx:if="{{!isLoading && messages.length === 0}}">
        <view class="suggestion-title">你可以问我：</view>
        <scroll-view class="suggestion-scroll" scroll-x="true" show-scrollbar="false">
          <view class="suggestion-list">
            <view class="suggestion-item" bindtap="sendQuickQuestion" data-question="分析我的投篮能力，给出改进建议">
              🎯 分析我的投篮
            </view>
            <view class="suggestion-item" bindtap="sendQuickQuestion" data-question="根据我的技能雷达图，推荐今天的训练计划">
              📋 推荐训练计划
            </view>
            <view class="suggestion-item" bindtap="sendQuickQuestion" data-question="如何提高我的防守能力？">
              🛡️ 提高防守
            </view>
            <view class="suggestion-item" bindtap="sendQuickQuestion" data-question="帮我分析最近的训练记录">
              📊 分析训练记录
            </view>
          </view>
        </scroll-view>
      </view>
      
      <!-- 输入区域 -->
      <view class="input-area">
        <view class="input-wrapper">
          <input 
            placeholder="和AI聊聊你的训练..." 
            class="input" 
            bindinput="onInputChange" 
            value="{{ userInput }}" 
            bindconfirm="sendMessage"
            placeholder-class="input-placeholder"
          ></input>
        </view>
        <button class="send-button {{userInput ? 'active' : ''}}" bindtap="sendMessage">
          <view wx:if="{{!userInput}}" class="send-icon">
            <text class="icon-text">💬</text>
          </view>
          <view wx:else class="send-icon">
            <text class="icon-text">发送</text>
          </view>
        </button>
      </view>
    </view>
  </view>
</view>