<view class="app-shell page-shell">
  <view class="section-card">
    <view class="record-head">
      <view class="record-tag">
        <view class="record-tag-text">{{title}}</view>
        <view class="record-tag-count">{{filteredList.length}}</view>
      </view>
    </view>

    <view class="filter-panel" wx:if="{{list.length}}">
      <view class="filter-group">
        <view class="filter-label">地点</view>
        <scroll-view scroll-x class="filter-scroll" show-scrollbar="{{false}}">
          <view class="filter-row">
            <view
              wx:for="{{townOptions}}"
              wx:key="*this"
              class="filter-chip {{filters.town === item ? 'filter-chip--active' : ''}}"
              data-key="town"
              data-value="{{item}}"
              bindtap="selectFilter"
            >
              {{item}}
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="filter-group">
        <view class="filter-label">日期</view>
        <scroll-view scroll-x class="filter-scroll" show-scrollbar="{{false}}">
          <view class="filter-row">
            <view
              wx:for="{{dateOptions}}"
              wx:key="*this"
              class="filter-chip {{filters.date === item ? 'filter-chip--active' : ''}}"
              data-key="date"
              data-value="{{item}}"
              bindtap="selectFilter"
            >
              {{item}}
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <block wx:if="{{filteredList.length}}">
      <view
        wx:for="{{filteredList}}"
        wx:key="id"
        class="record-card"
        data-type="{{type}}"
        data-id="{{item.id}}"
        data-payload="{{item.payload}}"
        bindtap="reopenItem"
        hover-class="record-card--hover"
        hover-stay-time="80"
      >
        <view class="record-top">
          <view class="record-title">
            <view class="mode-dot mode-dot--{{item.mode === 'pro_event' ? 'pro' : 'casual'}}"></view>
            <text class="record-title-text">{{item.title}}</text>
          </view>
          <view class="record-time">{{item.meta}}</view>
        </view>
        <view class="record-brief">{{item.brief}}</view>
        <view class="record-highlight">{{item.highlight}}</view>
      </view>
    </block>

    <view wx:elif="{{list.length}}" class="record-empty-inline">当前筛选下暂无记录</view>
    <van-empty wx:else image="search" description="还没有记录" />
  </view>
</view>
