.page-shell {
  padding-bottom: 220rpx;
}

.filter-panel {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f7faff 0%, #f3f7ff 100%);
}

.filter-group + .filter-group {
  margin-top: 18rpx;
}

.filter-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #7383a6;
}

.filter-scroll {
  margin-top: 14rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.filter-chip {
  min-width: 96rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #627596;
  font-size: 22rpx;
  text-align: center;
  box-shadow: inset 0 0 0 2rpx rgba(29, 93, 255, 0.05);
}

.filter-chip--active {
  background: linear-gradient(135deg, #165bff 0%, #4d8dff 100%);
  color: #ffffff;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

/* 科技感分类标签（与历史页同款） */
.record-tag {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 22rpx 10rpx 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(29, 93, 255, 0.14) 0%, rgba(77, 141, 255, 0.05) 100%);
  border: 2rpx solid rgba(29, 93, 255, 0.2);
}

.record-tag::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: #2b8fff;
  box-shadow: 0 0 14rpx 3rpx rgba(43, 143, 255, 0.55);
}

.record-tag-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d5dff;
  letter-spacing: 3rpx;
}

.record-tag-count {
  min-width: 40rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1d5dff 0%, #4d8dff 100%);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.4;
  box-shadow: 0 6rpx 14rpx rgba(29, 93, 255, 0.3);
}

.record-card {
  padding: 24rpx 0;
}

.record-card + .record-card {
  border-top: 2rpx solid #eef3fb;
}

.record-card--hover {
  opacity: 0.92;
}

.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-title-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2b49;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 模式圆点：半专业=蓝，野球=橙 */
.mode-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.mode-dot--pro {
  background: #2b8fff;
  box-shadow: 0 0 10rpx rgba(43, 143, 255, 0.55);
}

.mode-dot--casual {
  background: #ff8a2a;
  box-shadow: 0 0 10rpx rgba(255, 138, 42, 0.55);
}

.record-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #7c8ba8;
}

.record-brief {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #243556;
}

/* 重点信息：当时输入的一句话，小号灰字 */
.record-highlight {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7c8ba8;
}

.record-empty-inline {
  padding: 34rpx 0 10rpx;
  font-size: 24rpx;
  color: #7c8ba8;
}

/* —— 多选删除管理 —— */

.record-manage-btn {
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(29, 93, 255, 0.1);
  color: #1d5dff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.record-card {
  display: flex;
  align-items: flex-start;
}

.record-card--selected {
  border-radius: 20rpx;
  background: rgba(29, 93, 255, 0.06);
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

/* 圆形复选框 */
.record-check {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-top: 22rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(29, 93, 255, 0.35);
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-check--on {
  background: #1d5dff;
  border-color: #1d5dff;
}

.record-check-mark {
  width: 18rpx;
  height: 10rpx;
  border-left: 4rpx solid transparent;
  border-bottom: 4rpx solid transparent;
  transform: rotate(-45deg) translateY(-2rpx);
}

.record-check--on .record-check-mark {
  border-left-color: #ffffff;
  border-bottom-color: #ffffff;
}

/* 底部管理操作栏 */
.record-manage-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -10rpx 30rpx rgba(18, 46, 99, 0.08);
}

.record-manage-all {
  display: flex;
  align-items: center;
}

.record-manage-all .record-check {
  margin-top: 0;
  margin-right: 10rpx;
}

.record-manage-all-text {
  font-size: 24rpx;
  color: #33466b;
}

.record-manage-count {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #7c8ba8;
}

.record-manage-del {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 36rpx;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fa5151 0%, #ff7a5c 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.record-manage-del::after {
  border: none;
}

.record-manage-del--disabled {
  opacity: 0.4;
}
