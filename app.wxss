/* app.wxss */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #000000;
  color: #fff;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 页面容器动画 */
.container {
  padding: 20rpx;
  animation: pageSlideIn 0.3s ease-out;
}

@keyframes pageSlideIn {
  0% {
    opacity: 0;
    transform: translateX(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

/* TabBar 过渡效果 */
.tabbar-icon {
  transition: all 0.3s ease-in-out;
}

.tabbar-item {
  transition: all 0.3s ease-in-out;
}

.container {
  padding: 20rpx;
}

.btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  background-color: #7A41FF;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  text-align: center;
  margin: 10rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
  color: #fff;
}

.no-data {
  text-align: center;
  color: #888;
  padding: 40rpx 0;
  font-size: 28rpx;
}

.tab-bar {
  display: flex;
  border-bottom: 1rpx solid #333;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #888;
  position: relative;
}

.tab-item.active {
  color: #7A41FF;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background-color: #7A41FF;
}

