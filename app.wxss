/* app.wxss - 现代化UI设计 */

/* 基础变量定义 */
:root {
  /* 主色调 */
  --primary-color: #44ceff;
  --primary-color-dark: #59a8ff;
  --primary-color-light: #7bc8ff;
  
  /* 辅助色 */
  --secondary-color: #52c41a;
  --warning-color: #faad14;
  --danger-color: #ff4d4f;
  
  /* 文本色 */
  --text-primary: #1a1a1a;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --text-light: #ffffff;
  
  /* 背景色 */
  --bg-primary: #ffffff;
  --bg-secondary: #f5faff;
  --bg-tertiary: #e6f7ff;
  
  /* 阴影 */
  --shadow-soft: 0 4rpx 20rpx rgba(68, 206, 255, 0.1), 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  --shadow-medium: 0 8rpx 30rpx rgba(68, 206, 255, 0.15), 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-strong: 0 12rpx 40rpx rgba(68, 206, 255, 0.2), 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
  
  /* 边框 */
  --border-radius-sm: 12rpx;
  --border-radius-md: 16rpx;
  --border-radius-lg: 24rpx;
  --border-radius-full: 9999rpx;
  
  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  
  /* 字体大小 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-2xl: 44rpx;
  
  /* 动画 */
  --transition-fast: 0.2s ease;
  --transition-normal: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --transition-slow: 0.5s ease-out;
}

/* 页面样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: linear-gradient(135deg, var(--bg-tertiary) 0%, var(--bg-secondary) 30%, var(--bg-primary) 100%);
  color: var(--text-primary);
  padding-bottom: 180rpx;
  box-sizing: border-box;
  position: relative;
}

page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 20% 20%, rgba(68, 206, 255, 0.05) 0%, transparent 50%),
              radial-gradient(circle at 80% 80%, rgba(89, 168, 255, 0.05) 0%, transparent 50%);
  pointer-events: none;
  z-index: -1;
}

/* 页面容器 */
.container {
  padding: var(--spacing-md);
  animation: pageSlideIn 0.4s var(--transition-normal);
}

@keyframes pageSlideIn {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 现代化渐变背景 */
.gradient-bg {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 50%, var(--primary-color-light) 100%);
}

.gradient-bg-light {
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.1) 100%);
}

/* 毛玻璃效果 */
.glass-effect {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 现代化阴影 */
.shadow-soft {
  box-shadow: var(--shadow-soft);
}

.shadow-medium {
  box-shadow: var(--shadow-medium);
}

.shadow-strong {
  box-shadow: var(--shadow-strong);
}

/* 多彩按钮设计 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: var(--border-radius-full);
  font-size: var(--font-md);
  font-weight: 600;
  text-align: center;
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
  border: none;
  cursor: pointer;
  white-space: nowrap;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  color: var(--text-light);
  box-shadow: 0 6rpx 20rpx rgba(68, 206, 255, 0.4);
}

.btn-primary:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 30rpx rgba(68, 206, 255, 0.5);
}

.btn-success {
  background: linear-gradient(135deg, var(--secondary-color) 0%, #73d13d 100%);
  color: var(--text-light);
  box-shadow: 0 6rpx 20rpx rgba(82, 196, 26, 0.4);
}

.btn-warning {
  background: linear-gradient(135deg, var(--warning-color) 0%, #ffc53d 100%);
  color: var(--text-light);
  box-shadow: 0 6rpx 20rpx rgba(250, 173, 20, 0.4);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.9);
  color: var(--primary-color);
  border: 2rpx solid rgba(68, 206, 255, 0.3);
  box-shadow: 0 2rpx 10rpx rgba(68, 206, 255, 0.1);
}

.btn-ghost:hover {
  background: rgba(68, 206, 255, 0.05);
  border-color: var(--primary-color);
  transform: translateY(-2rpx);
}

/* 卡片样式 */
.card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: var(--border-radius-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--shadow-soft);
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  transform: scaleX(0);
  transition: transform var(--transition-normal);
}

.card:hover {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-medium);
}

.card:hover::before {
  transform: scaleX(1);
}

/* 标题样式 */
.section-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  margin: 0 0 var(--spacing-md) 0;
  letter-spacing: 0.5rpx;
  position: relative;
  display: inline-block;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  border-radius: 3rpx;
}

.page-title {
  font-size: var(--font-2xl);
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
  line-height: 1.2;
}

.page-subtitle {
  font-size: var(--font-md);
  color: var(--text-secondary);
  font-weight: 500;
}

/* 输入框样式 */
.input-field {
  width: 100%;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(15rpx);
  -webkit-backdrop-filter: blur(15rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: var(--border-radius-md);
  font-size: var(--font-md);
  color: var(--text-primary);
  transition: all var(--transition-normal);
  box-sizing: border-box;
}

.input-field:focus {
  border-color: var(--primary-color);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 0 4rpx rgba(68, 206, 255, 0.15);
  outline: none;
}

/* 动画类 */
.fade-in {
  animation: fadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.slide-up {
  animation: slideUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.scale-in {
  animation: scaleIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.85);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 悬浮效果 */
.float-animation {
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-12rpx) rotate(1deg);
  }
  50% {
    transform: translateY(-8rpx) rotate(0deg);
  }
  75% {
    transform: translateY(-12rpx) rotate(-1deg);
  }
}

/* 脉冲效果 */
.pulse-animation {
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(68, 206, 255, 0.4), 0 0 0 0 rgba(68, 206, 255, 0.2);
  }
  50% {
    box-shadow: 0 0 0 20rpx rgba(68, 206, 255, 0), 0 0 0 30rpx rgba(68, 206, 255, 0);
  }
}

/* 呼吸效果 */
.breathing-animation {
  animation: breathing 4s ease-in-out infinite;
}

@keyframes breathing {
  0%, 100% {
    opacity: 0.8;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.02);
  }
}

/* 旋转效果 */
.rotate-animation {
  animation: rotate 8s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 闪烁效果 */
.shine-animation {
  animation: shine 2s ease-in-out infinite;
}

@keyframes shine {
  0% {
    background-position: -1000px 0;
  }
  100% {
    background-position: 1000px 0;
  }
}

/* 打字效果 */
.typing-animation {
  overflow: hidden;
  white-space: nowrap;
  animation: typing 3s steps(40, end);
}

@keyframes typing {
  from {
    width: 0;
  }
  to {
    width: 100%;
  }
}

/* 波纹效果 */
.ripple-effect {
  position: relative;
  overflow: hidden;
}

.ripple-effect::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(68, 206, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.ripple-effect:active::after {
  width: 300rpx;
  height: 300rpx;
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-color-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 页面顶部渐变装饰 */
.page-header-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, rgba(68, 206, 255, 0.3) 0%, rgba(89, 168, 255, 0.1) 50%, transparent 100%);
  z-index: -1;
  pointer-events: none;
}

/* 通用部分样式 */
.section {
  margin-bottom: var(--spacing-xl);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: var(--spacing-sm);
  }
  
  .page-title {
    font-size: 36rpx;
  }
  
  .section-title {
    font-size: 32rpx;
  }
}
