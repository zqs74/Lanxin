/* app.wxss - 现代化UI设计 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: linear-gradient(180deg, #e6f7ff 0%, #f5faff 30%, #fdfdfd 100%);
  color: #1a1a1a;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

/* 页面容器动画 */
.container {
  padding: 0;
  animation: pageSlideIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes pageSlideIn {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 现代化渐变背景 */
.gradient-bg {
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 50%, #7bc8ff 100%);
}

.gradient-bg-light {
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.1) 0%, rgba(89, 168, 255, 0.1) 100%);
}

/* 毛玻璃效果 */
.glass-effect {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.glass-effect-dark {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* 现代化阴影 */
.shadow-soft {
  box-shadow: 0 4rpx 20rpx rgba(68, 206, 255, 0.1), 
              0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.shadow-medium {
  box-shadow: 0 8rpx 30rpx rgba(68, 206, 255, 0.15), 
              0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.shadow-strong {
  box-shadow: 0 12rpx 40rpx rgba(68, 206, 255, 0.2), 
              0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* 多彩按钮设计 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
  border: none;
  cursor: pointer;
}

.btn-primary {
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(68, 206, 255, 0.4);
}

.btn-primary:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 30rpx rgba(68, 206, 255, 0.5);
}

.btn-primary:active {
  transform: translateY(0);
  box-shadow: 0 4rpx 15rpx rgba(68, 206, 255, 0.3);
}

.btn-success {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(82, 196, 26, 0.4);
}

.btn-success:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 30rpx rgba(82, 196, 26, 0.5);
}

.btn-warning {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(250, 173, 20, 0.4);
}

.btn-warning:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 30rpx rgba(250, 173, 20, 0.5);
}

.btn-danger {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(255, 77, 79, 0.4);
}

.btn-danger:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 30rpx rgba(255, 77, 79, 0.5);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.9);
  color: #44ceff;
  border: 2rpx solid rgba(68, 206, 255, 0.3);
  box-shadow: 0 2rpx 10rpx rgba(68, 206, 255, 0.1);
}

.btn-ghost:hover {
  background: rgba(68, 206, 255, 0.05);
  border-color: #44ceff;
  transform: translateY(-2rpx);
}

.btn-small {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  border-radius: 40rpx;
}

.btn-large {
  padding: 28rpx 60rpx;
  font-size: 32rpx;
  border-radius: 60rpx;
}

/* 卡片样式 */
.card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(68, 206, 255, 0.08), 
              0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 30rpx rgba(68, 206, 255, 0.15), 
              0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-gradient {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 100%);
  backdrop-filter: blur(25rpx);
  -webkit-backdrop-filter: blur(25rpx);
}

/* 标题样式 */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 24rpx 0;
  letter-spacing: 0.5rpx;
  position: relative;
  display: inline-block;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8rpx;
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #44ceff 0%, #59a8ff 100%);
  border-radius: 3rpx;
}

/* 标签页样式 */
.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  position: relative;
  border-radius: 16rpx;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  cursor: pointer;
}

.tab-item:hover {
  color: #44ceff;
  background: rgba(68, 206, 255, 0.05);
}

.tab-item.active {
  color: #44ceff;
  font-weight: 600;
  background: linear-gradient(135deg, rgba(68, 206, 255, 0.15) 0%, rgba(89, 168, 255, 0.15) 100%);
  box-shadow: 0 2rpx 10rpx rgba(68, 206, 255, 0.2);
}

/* 空数据状态 */
.no-data {
  text-align: center;
  color: #999;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(15rpx);
  -webkit-backdrop-filter: blur(15rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* 输入框样式 */
.input-field {
  width: 100%;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(15rpx);
  -webkit-backdrop-filter: blur(15rpx);
  border: 2rpx solid rgba(68, 206, 255, 0.2);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #44ceff;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 0 0 4rpx rgba(68, 206, 255, 0.15);
  outline: none;
}

.input-field::placeholder {
  color: #aaa;
}

/* 动画类 */
.fade-in {
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.slide-up {
  animation: slideUp 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.scale-in {
  animation: scaleIn 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 悬浮效果 */
.float-animation {
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

/* 脉冲效果 */
.pulse-animation {
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(68, 206, 255, 0.4);
  }
  50% {
    box-shadow: 0 0 0 20rpx rgba(68, 206, 255, 0);
  }
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 页面顶部渐变装饰 */
.page-header-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, rgba(68, 206, 255, 0.3) 0%, rgba(89, 168, 255, 0.1) 50%, transparent 100%);
  z-index: -1;
  pointer-events: none;
}
