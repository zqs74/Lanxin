/* app.wxss - 昇梦体育 PPT风格 酷炫黑金运动感 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: linear-gradient(180deg, #0a0a0a 0%, #0d0d0d 40%, #111 100%);
  color: #f5f5f5;
  padding-bottom: 180rpx;
  box-sizing: border-box;
  position: relative;
}

page::before {
  content: '';
  position: fixed;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 50% 30%, rgba(212, 175, 55, 0.03) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

.page-wrapper {
  position: relative;
  min-height: 100vh;
}

.container {
  padding: 0;
  animation: pageEnter 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes pageEnter {
  0% {
    opacity: 0;
    transform: translateY(30rpx) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ===== 金色渐变系统 ===== */
.gradient-bg {
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 35%, #F4C430 65%, #DAA520 100%);
}

.gradient-bg-dark {
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.15) 0%, rgba(255, 215, 0, 0.08) 100%);
}

/* ===== 玻璃质感卡片（深色+金边） ===== */
.glass-effect {
  background: rgba(17, 17, 17, 0.92);
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  border: 1rpx solid rgba(212, 175, 55, 0.25);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.6),
    0 0 1rpx rgba(255, 215, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.glass-effect-dark {
  background: rgba(10, 10, 10, 0.95);
  backdrop-filter: blur(30rpx) saturate(200%);
  -webkit-backdrop-filter: blur(30rpx) saturate(200%);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  box-shadow:
    0 12rpx 48rpx rgba(0, 0, 0, 0.7),
    0 0 2rpx rgba(212, 175, 55, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.03);
}

/* ===== 阴影系统 ===== */
.shadow-soft {
  box-shadow: 
    0 4rpx 20rpx rgba(0, 0, 0, 0.5),
    0 0 24rpx rgba(212, 175, 55, 0.06);
}

.shadow-medium {
  box-shadow: 
    0 8rpx 36rpx rgba(0, 0, 0, 0.6),
    0 0 36rpx rgba(212, 175, 55, 0.1);
}

.shadow-strong {
  box-shadow: 
    0 16rpx 56rpx rgba(0, 0, 0, 0.75),
    0 0 48rpx rgba(212, 175, 55, 0.12);
}

.shadow-gold-glow {
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.5),
    0 0 40rpx rgba(212, 175, 55, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

/* ===== 按钮系统 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 44rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
  border: none;
  cursor: pointer;
  letter-spacing: 1rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 50%, #F4C430 100%);
  color: #0a0a0a;
  font-weight: 800;
  box-shadow: 
    0 8rpx 28rpx rgba(212, 175, 55, 0.45),
    0 0 32rpx rgba(212, 175, 55, 0.15);
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
}

.btn-primary:hover {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 
    0 14rpx 42rpx rgba(212, 175, 55, 0.55),
    0 0 48rpx rgba(212, 175, 55, 0.25);
}

.btn-primary:active {
  transform: translateY(-2rpx) scale(0.98);
  box-shadow: 
    0 6rpx 20rpx rgba(212, 175, 55, 0.35),
    0 0 28rpx rgba(212, 175, 55, 0.12);
}

.btn-success {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(82, 196, 26, 0.4);
}

.btn-warning {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
  color: #0a0a0a;
  font-weight: 700;
}

.btn-danger {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: white;
}

.btn-ghost {
  background: rgba(17, 17, 17, 0.9);
  color: #D4AF37;
  border: 2rpx solid rgba(212, 175, 55, 0.35);
  backdrop-filter: blur(12rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.btn-ghost:hover {
  background: rgba(212, 175, 55, 0.1);
  border-color: #D4AF37;
  transform: translateY(-3rpx);
  box-shadow: 0 8rpx 24rpx rgba(212, 175, 55, 0.2);
}

.btn-small {
  padding: 14rpx 32rpx;
  font-size: 24rpx;
  border-radius: 40rpx;
}

.btn-large {
  padding: 28rpx 64rpx;
  font-size: 32rpx;
  border-radius: 60rpx;
  font-weight: 800;
}

/* ===== 卡片系统 ===== */
.card {
  background: linear-gradient(
    145deg,
    rgba(22, 22, 22, 0.96) 0%,
    rgba(13, 13, 13, 0.98) 100%
  );
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: 28rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.18);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.55),
    0 0 1rpx rgba(255, 215, 0, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(212, 175, 55, 0.4) 50%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity 0.4s ease;
}

.card:hover {
  transform: translateY(-6rpx);
  border-color: rgba(212, 175, 55, 0.35);
  box-shadow:
    0 16rpx 48rpx rgba(0, 0, 0, 0.65),
    0 0 40rpx rgba(212, 175, 55, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.card:hover::before {
  opacity: 1;
}

.card-gradient {
  background: linear-gradient(
    145deg,
    rgba(26, 26, 26, 0.98) 0%,
    rgba(17, 17, 17, 1) 100%
  );
  border-color: rgba(212, 175, 55, 0.25);
}

/* ===== 标题样式 ===== */
.section-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #ffffff;
  margin: 0 0 28rpx 0;
  letter-spacing: 2rpx;
  position: relative;
  display: inline-block;
  text-shadow: 
    0 2rpx 8rpx rgba(212, 175, 55, 0.3),
    0 0 24rpx rgba(212, 175, 55, 0.1);
}

.section-title::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -12rpx;
  width: 72rpx;
  height: 5rpx;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 60%, transparent 100%);
  border-radius: 3rpx;
  box-shadow: 0 0 12rpx rgba(212, 175, 55, 0.4);
}

/* ===== Tab栏 ===== */
.tab-bar {
  display: flex;
  background: rgba(17, 17, 17, 0.85);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: 24rpx;
  padding: 10rpx;
  margin-bottom: 28rpx;
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #777;
  position: relative;
  border-radius: 18rpx;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  cursor: pointer;
  letter-spacing: 1rpx;
}

.tab-item:hover {
  color: #D4AF37;
  background: rgba(212, 175, 55, 0.06);
}

.tab-item.active {
  color: #D4AF37;
  font-weight: 800;
  background: linear-gradient(
    135deg,
    rgba(212, 175, 55, 0.15) 0%,
    rgba(255, 215, 0, 0.08) 100%
  );
  box-shadow: 
    0 4rpx 16rpx rgba(212, 175, 55, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  text-shadow: 0 0 12rpx rgba(212, 175, 55, 0.4);
}

.no-data {
  text-align: center;
  color: #666;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
  background: linear-gradient(145deg, rgba(22, 22, 22, 0.9), rgba(13, 13, 13, 0.95));
  backdrop-filter: blur(16rpx);
  border-radius: 28rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.02);
}

.input-field {
  width: 100%;
  padding: 26rpx 30rpx;
  background: rgba(17, 17, 17, 0.95);
  border: 2rpx solid rgba(212, 175, 55, 0.2);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #f5f5f5;
  transition: all 0.4s ease;
  box-sizing: border-box;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.input-field:focus {
  border-color: #D4AF37;
  background: rgba(22, 22, 22, 1);
  box-shadow:
    inset 0 2rpx 8rpx rgba(0, 0, 0, 0.3),
    0 0 0 4rpx rgba(212, 175, 55, 0.12);
  outline: none;
}

.input-field::placeholder {
  color: #555;
}

.fade-in { animation: fadeIn 0.5s ease-out; }

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.slide-up { animation: slideUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.scale-in { animation: scaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.float-animation { animation: float 3s ease-in-out infinite; }

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.pulse-animation { animation: pulse 2.5s ease-in-out infinite; }

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4);
  }
  50% {
    box-shadow: 0 0 0 20rpx rgba(212, 175, 55, 0);
  }
}

.gradient-text {
  background: linear-gradient(135deg, #D4AF37 0%, #FFD700 40%, #F4C430 70%, #DAA520 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  filter: drop-shadow(0 2rpx 8rpx rgba(212, 175, 55, 0.4));
}

.page-header-gradient {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  background: radial-gradient(
    ellipse at 50% 0%,
    rgba(212, 175, 55, 0.08) 0%,
    rgba(212, 175, 55, 0.03) 40%,
    transparent 70%
  );
  z-index: -1;
  pointer-events: none;
}
