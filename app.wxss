/* app.wxss - 昇梦体育 主题系统 */
/* 策略：浅色=page默认 | @media暗色=跟随系统 | .theme-light/.theme-dark=手动覆盖(完整镜像+!important) */

/* ===== 浅色主题 CSS 变量（默认） ===== */
page {
  --bg-page: linear-gradient(180deg, #f8f7f4 0%, #f3f1ec 40%, #eae8e2 100%);
  --bg-page-flat: #f8f7f4;
  --bg-card: linear-gradient(145deg, rgba(255,255,255,0.96) 0%, rgba(252,251,249,0.98) 100%);
  --bg-card-flat: rgba(255,255,255,0.95);
  --bg-card-dark: linear-gradient(145deg, rgba(255,255,255,0.98) 0%, rgba(250,249,246,1) 100%);
  --bg-card-light: rgba(255,255,255,0.92);
  --bg-input: rgba(255,255,255,0.95);
  --bg-input-focus: rgba(255,255,255,1);
  --bg-input-form: rgba(255,255,255,0.95);
  --bg-input-form-focus: rgba(255,255,255,1);
  --bg-modal: rgba(255,255,255,0.98);
  --bg-overlay: rgba(0,0,0,0.35);
  --bg-nav: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.95) 70%, rgba(252,251,249,0.92) 100%);
  --bg-nav-flat: rgba(255,255,255,0.98);
  --bg-tab-bar: rgba(255,255,255,0.92);
  --bg-tab-track: linear-gradient(135deg, rgba(212,175,55,0.22) 0%, rgba(255,215,0,0.14) 40%, rgba(212,175,55,0.18) 70%, rgba(244,196,48,0.10) 100%);
  --bg-checkbox: #e8e8e8;
  --bg-bottom: #f8f7f4;
  --bg-bottom-blur: linear-gradient(to top, rgba(248,247,244,0.98) 0%, rgba(248,247,244,0.92) 80%, transparent 100%);
  --bg-section: rgba(245,243,238,0.95);
  --bg-tag: rgba(212,175,55,0.12);
  --bg-thinking: rgba(240,240,248,0.92);
  --bg-thinking-live: rgba(235,235,245,0.95);
  --bg-thinking-toggle: rgba(100,149,237,0.08);
  --bg-no-data: linear-gradient(145deg, rgba(255,255,255,0.95), rgba(250,249,246,0.98));
  --bg-avatar-placeholder: linear-gradient(135deg, rgba(245,243,238,1) 0%, rgba(250,249,246,1) 100%);
  --bg-stat-card: linear-gradient(135deg, rgba(212,175,55,0.08) 0%, rgba(255,215,0,0.05) 100%);
  --bg-player-card: linear-gradient(145deg, rgba(255,255,255,0.95) 0%, rgba(252,251,249,0.92) 100%);
  --bg-record-date: linear-gradient(135deg, rgba(212,175,55,0.08) 0%, rgba(255,215,0,0.06) 100%);
  --bg-foul-stat: rgba(245,243,238,0.95);
  --bg-total-row: rgba(245,243,238,0.95);
  --bg-vs-divider: linear-gradient(135deg, rgba(212,175,55,0.15) 0%, rgba(255,215,0,0.1) 100%);
  --bg-quick-chip: linear-gradient(145deg, rgba(255,255,255,0.98), rgba(248,247,246,0.99));
  --bg-quick-chip-hover: linear-gradient(145deg, rgba(212,175,55,0.12), rgba(255,215,0,0.08));
  --bg-create-entry: linear-gradient(135deg, rgba(255,255,255,0.98) 0%, rgba(252,251,249,1) 100%);
  --bg-stat-item: linear-gradient(155deg, rgba(255,255,255,0.98) 0%, rgba(252,251,249,1) 100%);
  --bg-action-item: linear-gradient(155deg, rgba(255,255,255,0.98) 0%, rgba(252,251,249,1) 100%);
  --bg-no-videos: linear-gradient(155deg, rgba(255,255,255,0.95) 0%, rgba(252,251,249,0.98) 100%);
  --bg-float-btn: #ffffff;

  --text-primary: #1a1a1a;
  --text-primary-alt: #222;
  --text-content: #333;
  --text-content-alt: #3a3a3a;
  --text-secondary: #666;
  --text-tertiary: #888;
  --text-placeholder: #999;
  --text-dim: #999;
  --text-label: #555;
  --text-markdown: #444;
  --text-markdown-blockquote: #555;
  --text-thinking: #6b7b9a;
  --text-status-online: #389e0d;
  --text-status-thinking: #4169E1;

  --gold: #D4AF37;
  --gold-light: #FFD700;
  --gold-deep: #B8860B;
  --gold-gradient: linear-gradient(135deg, #D4AF37 0%, #FFD700 100%);
  --gold-gradient-full: linear-gradient(135deg, #D4AF37 0%, #FFD700 35%, #F4C430 65%, #DAA520 100%);
  --gold-gradient-text: linear-gradient(135deg, #D4AF37 0%, #FFD700 40%, #F4C430 70%, #DAA520 100%);

  --border-card: rgba(212,175,55,0.22);
  --border-card-hover: rgba(212,175,55,0.45);
  --border-glass: rgba(212,175,55,0.3);
  --border-glass-dark: rgba(212,175,55,0.35);
  --border-input: rgba(212,175,55,0.25);
  --border-input-focus: #D4AF37;
  --border-light: rgba(212,175,55,0.18);
  --border-lighter: rgba(212,175,55,0.12);
  --border-superlight: rgba(212,175,55,0.08);
  --border-divider: rgba(212,175,55,0.18);
  --border-stat: rgba(212,175,55,0.18);
  --border-thinking: rgba(100,149,237,0.3);
  --border-thinking-active: rgba(100,149,237,0.5);
  --border-thinking-toggle: rgba(100,149,237,0.25);
  --border-quick-chip: rgba(212,175,55,0.2);
  --border-quick-chip-hover: rgba(212,175,55,0.5);
  --border-msg-ai: rgba(212,175,55,0.22);
  --border-code: rgba(212,175,55,0.25);
  --border-code-block: rgba(212,175,55,0.3);
  --border-checkbox: #ccc;
  --border-bottom: rgba(212,175,55,0.15);
  --border-total-row: rgba(212,175,55,0.18);

  --shadow-card: 0 4rpx 20rpx rgba(0,0,0,0.08), 0 0 1rpx rgba(212,175,55,0.05), inset 0 1rpx 0 rgba(255,255,255,0.6);
  --shadow-card-hover: 0 8rpx 32rpx rgba(0,0,0,0.12), 0 0 24rpx rgba(212,175,55,0.08), inset 0 1rpx 0 rgba(255,255,255,0.7);
  --shadow-glass: 0 4rpx 20rpx rgba(0,0,0,0.08), 0 0 1rpx rgba(212,175,55,0.06), inset 0 1rpx 0 rgba(255,255,255,0.5);
  --shadow-glass-dark: 0 8rpx 32rpx rgba(0,0,0,0.12), 0 0 2rpx rgba(212,175,55,0.1), inset 0 2rpx 0 rgba(255,255,255,0.6);
  --shadow-soft: 0 2rpx 12rpx rgba(0,0,0,0.06), 0 0 16rpx rgba(212,175,55,0.04);
  --shadow-medium: 0 4rpx 20rpx rgba(0,0,0,0.08), 0 0 20rpx rgba(212,175,55,0.06);
  --shadow-strong: 0 8rpx 32rpx rgba(0,0,0,0.12), 0 0 28rpx rgba(212,175,55,0.08);
  --shadow-gold-glow: 0 4rpx 20rpx rgba(0,0,0,0.06), 0 0 24rpx rgba(212,175,55,0.12), inset 0 1rpx 0 rgba(255,255,255,0.5);
  --shadow-modal: 0 20rpx 60rpx rgba(0,0,0,0.25);
  --shadow-avatar: 0 4rpx 16rpx rgba(212,175,55,0.3);
  --shadow-tab: 0 2rpx 12rpx rgba(0,0,0,0.06), 0 0 16rpx rgba(212,175,55,0.05), inset 0 1rpx 0 rgba(255,255,255,0.5);
  --shadow-input: inset 0 1rpx 4rpx rgba(0,0,0,0.06);

  --thinking-header-bg: rgba(100,149,237,0.06);
  --thinking-header-bg-active: rgba(100,149,237,0.12);
  --thinking-border-bottom: rgba(100,149,237,0.15);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: var(--bg-page-flat);
  box-sizing: border-box;
  position: relative;
}

/* ===== 暗色主题：@media 跟随系统自动切换 ===== */
@media (prefers-color-scheme: dark) {
  page {
    --bg-page: linear-gradient(180deg, #0a0a0a 0%, #0d0d0d 40%, #111 100%);
    --bg-page-flat: #0a0a0a;
    --bg-card: linear-gradient(145deg, rgba(22,22,22,0.96) 0%, rgba(13,13,13,0.98) 100%);
    --bg-card-flat: rgba(17,17,17,0.92);
    --bg-card-dark: linear-gradient(145deg, rgba(26,26,26,0.98) 0%, rgba(17,17,17,1) 100%);
    --bg-card-light: rgba(17,17,17,0.85);
    --bg-input: rgba(17,17,17,0.95);
    --bg-input-focus: rgba(22,22,22,1);
    --bg-input-form: rgba(35,35,35,0.9);
    --bg-input-form-focus: rgba(40,40,40,1);
    --bg-modal: rgba(26,26,26,0.95);
    --bg-overlay: rgba(0,0,0,0.7);
    --bg-nav: linear-gradient(180deg, rgba(10,10,10,0.98) 0%, rgba(10,10,10,0.95) 70%, rgba(17,17,17,0.92) 100%);
    --bg-nav-flat: rgba(10,10,10,0.98);
    --bg-tab-bar: rgba(13,13,13,0.82);
    --bg-tab-track: linear-gradient(135deg, rgba(212,175,55,0.16) 0%, rgba(255,215,0,0.10) 40%, rgba(212,175,55,0.14) 70%, rgba(244,196,48,0.08) 100%);
    --bg-checkbox: #2a2a2a;
    --bg-bottom: #0a0a0a;
    --bg-bottom-blur: linear-gradient(to top, rgba(10,10,10,0.98) 0%, rgba(10,10,10,0.92) 80%, transparent 100%);
    --bg-section: rgba(17,17,17,0.75);
    --bg-tag: rgba(212,175,55,0.1);
    --bg-thinking: rgba(20,20,42,0.65);
    --bg-thinking-live: rgba(15,15,38,0.5);
    --bg-no-data: linear-gradient(145deg, rgba(22,22,22,0.9), rgba(13,13,13,0.95));
    --bg-avatar-placeholder: linear-gradient(135deg, rgba(26,26,26,1) 0%, rgba(17,17,17,1) 100%);
    --bg-player-card: linear-gradient(145deg, rgba(17,17,17,0.95) 0%, rgba(22,22,22,0.92) 100%);
    --bg-record-date: linear-gradient(135deg, rgba(212,175,55,0.1) 0%, rgba(255,215,0,0.08) 100%);
    --bg-foul-stat: rgba(17,17,17,0.85);
    --bg-total-row: rgba(17,17,17,0.8);
    --bg-quick-chip: linear-gradient(145deg, rgba(26,26,26,0.98), rgba(18,18,18,0.99));
    --bg-quick-chip-hover: linear-gradient(145deg, rgba(212,175,55,0.12), rgba(255,215,0,0.08));
    --bg-create-entry: linear-gradient(135deg, rgba(22,22,22,0.98) 0%, rgba(13,13,13,1) 100%);
    --bg-stat-item: linear-gradient(155deg, rgba(22,22,22,0.98) 0%, rgba(13,13,13,1) 100%);
    --bg-action-item: linear-gradient(155deg, rgba(22,22,22,0.98) 0%, rgba(13,13,13,1) 100%);
    --bg-no-videos: linear-gradient(155deg, rgba(22,22,22,0.95) 0%, rgba(13,13,13,0.98) 100%);
    --bg-float-btn: #0a0a0a;

    --text-primary: #ffffff;
    --text-primary-alt: #f5f5f5;
    --text-content: #e0e0e0;
    --text-content-alt: #e8e8e8;
    --text-secondary: #999;
    --text-tertiary: #666;
    --text-placeholder: #555;
    --text-dim: #777;
    --text-label: #bbb;
    --text-markdown: #d0d0d0;
    --text-markdown-blockquote: #bbb;
    --text-thinking: #8A92A8;
    --text-status-online: #52c41a;
    --text-status-thinking: #6495ED;

    --border-card: rgba(212,175,55,0.18);
    --border-card-hover: rgba(212,175,55,0.35);
    --border-glass: rgba(212,175,55,0.25);
    --border-glass-dark: rgba(212,175,55,0.3);
    --border-input: rgba(212,175,55,0.2);
    --border-light: rgba(212,175,55,0.15);
    --border-lighter: rgba(212,175,55,0.1);
    --border-superlight: rgba(212,175,55,0.08);
    --border-divider: rgba(212,175,55,0.15);
    --border-stat: rgba(212,175,55,0.15);
    --border-thinking: rgba(100,149,237,0.25);
    --border-thinking-active: rgba(100,149,237,0.4);
    --border-thinking-toggle: rgba(100,149,237,0.2);
    --border-quick-chip: rgba(212,175,55,0.18);
    --border-quick-chip-hover: rgba(212,175,55,0.45);
    --border-msg-ai: rgba(212,175,55,0.18);
    --border-code: rgba(212,175,55,0.2);
    --border-code-block: rgba(212,175,55,0.25);
    --border-checkbox: #444;
    --border-bottom: rgba(212,175,55,0.12);
    --border-total-row: rgba(212,175,55,0.15);

    --shadow-card: 0 8rpx 32rpx rgba(0,0,0,0.55), 0 0 1rpx rgba(255,215,0,0.08), inset 0 1rpx 0 rgba(255,255,255,0.03);
    --shadow-card-hover: 0 16rpx 48rpx rgba(0,0,0,0.65), 0 0 40rpx rgba(212,175,55,0.12), inset 0 1rpx 0 rgba(255,255,255,0.05);
    --shadow-glass: 0 8rpx 32rpx rgba(0,0,0,0.6), 0 0 1rpx rgba(255,215,0,0.1), inset 0 1rpx 0 rgba(255,255,255,0.04);
    --shadow-glass-dark: 0 12rpx 48rpx rgba(0,0,0,0.7), 0 0 2rpx rgba(212,175,55,0.2), inset 0 2rpx 0 rgba(255,255,255,0.03);
    --shadow-soft: 0 4rpx 20rpx rgba(0,0,0,0.5), 0 0 24rpx rgba(212,175,55,0.06);
    --shadow-medium: 0 8rpx 36rpx rgba(0,0,0,0.6), 0 0 36rpx rgba(212,175,55,0.1);
    --shadow-strong: 0 16rpx 56rpx rgba(0,0,0,0.75), 0 0 48rpx rgba(212,175,55,0.12);
    --shadow-gold-glow: 0 8rpx 32rpx rgba(0,0,0,0.5), 0 0 40rpx rgba(212,175,55,0.15), inset 0 1rpx 0 rgba(255,255,255,0.05);
    --shadow-modal: 0 20rpx 60rpx rgba(0,0,0,0.6);
    --shadow-avatar: 0 8rpx 24rpx rgba(212,175,55,0.4);
    --shadow-tab: 0 4rpx 20rpx rgba(0,0,0,0.5), inset 0 1rpx 0 rgba(255,255,255,0.03);
    --shadow-input: inset 0 2rpx 8rpx rgba(0,0,0,0.3);

    --thinking-header-bg: rgba(100,149,237,0.1);
    --thinking-header-bg-active: rgba(100,149,237,0.16);
    --thinking-border-bottom: rgba(100,149,237,0.12);

    background: var(--bg-page-flat);
  }
}

