.float-button {
  position: fixed;
  width: 110rpx;
  height: 110rpx;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
}

.button-inner {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.glow-effect {
  position: absolute;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.4) 0%, rgba(255, 215, 0, 0.2) 40%, transparent 70%);
  animation: goldGlow 2.5s ease-in-out infinite;
}

@keyframes goldGlow {
  0%, 100% {
    transform: scale(1);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.2);
    opacity: 0.3;
  }
}

.icon-container {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  background: #1a1a1a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #D4AF37;
  box-shadow:
    0 4rpx 20rpx rgba(0, 0, 0, 0.5),
    0 0 30rpx rgba(212, 175, 55, 0.15);
  z-index: 1;
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.button-inner:active .icon-container {
  transform: scale(0.92);
  border-color: #FFD700;
  box-shadow:
    0 2rpx 12rpx rgba(0, 0, 0, 0.6),
    0 0 40rpx rgba(212, 175, 55, 0.25);
}

.ai-icon-svg {
  width: 46rpx;
  height: 46rpx;
}

.ripple {
  position: absolute;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(212, 175, 55, 0.35);
  animation: goldRipple 2.5s ease-out infinite;
}

@keyframes goldRipple {
  0% {
    transform: scale(1);
    opacity: 0.6;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

.ai-label {
  position: absolute;
  bottom: -32rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #D4AF37;
  font-weight: 600;
  white-space: nowrap;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 0.5rpx;
}
