.float-button {
  position: fixed;
  width: 120rpx;
  height: 120rpx;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
}

.button-inner {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.glow-effect {
  position: absolute;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(68, 206, 255, 0.6) 0%, rgba(89, 168, 255, 0.3) 40%, transparent 70%);
  animation: glow 2s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.4;
  }
}

.icon-container {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #44ceff 0%, #59a8ff 50%, #7bc8ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(68, 206, 255, 0.5),
              0 4rpx 16rpx rgba(89, 168, 255, 0.3),
              inset 0 2rpx 8rpx rgba(255, 255, 255, 0.4);
  z-index: 1;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.button-inner:active .icon-container {
  transform: scale(0.9);
  box-shadow: 0 4rpx 16rpx rgba(68, 206, 255, 0.4),
              0 2rpx 8rpx rgba(89, 168, 255, 0.2),
              inset 0 2rpx 8rpx rgba(255, 255, 255, 0.4);
}

.ai-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
}

.ripple {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(68, 206, 255, 0.5);
  animation: ripple 2s ease-out infinite;
}

@keyframes ripple {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}