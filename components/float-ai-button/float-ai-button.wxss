.float-button {
  position: fixed;
  width: 112rpx;
  height: 112rpx;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
}

.button-inner {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.glow-effect {
  position: absolute;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.45) 0%, rgba(255, 215, 0, 0.2) 40%, transparent 70%);
  animation: goldGlow 3s ease-in-out infinite;
}

@keyframes goldGlow {
  0%, 100% {
    transform: scale(1);
    opacity: 0.65;
  }
  50% {
    transform: scale(1.28);
    opacity: 0.32;
  }
}

.icon-container {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  background: #0a0a0a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2.5rpx solid #D4AF37;
  box-shadow:
    0 8rpx 28rpx rgba(0, 0, 0, 0.6),
    0 0 36rpx rgba(212, 175, 55, 0.18),
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.03);
  z-index: 1;
  transition: all 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.button-inner:active .icon-container {
  transform: scale(0.9);
  border-color: #FFD700;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.7),
    0 0 48rpx rgba(212, 175, 55, 0.28),
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.05);
}

.ai-icon-svg {
  width: 48rpx;
  height: 48rpx;
}

.ripple {
  position: absolute;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(212, 175, 55, 0.38);
  animation: goldRipple 3s ease-out infinite;
}

@keyframes goldRipple {
  0% {
    transform: scale(1);
    opacity: 0.58;
  }
  100% {
    transform: scale(2.3);
    opacity: 0;
  }
}

.ai-label {
  position: absolute;
  bottom: -34rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #D4AF37;
  font-weight: 800;
  white-space: nowrap;
  text-shadow:
    0 0 12rpx rgba(212, 175, 55, 0.55),
    0 2rpx 6rpx rgba(0, 0, 0, 0.5);
  letter-spacing: 1rpx;
}
