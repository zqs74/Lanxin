<!-- open-guide.wxml - 开通引导居中弹窗（蓝白 UI，与全局风格统一） -->
<van-popup
  show="{{visible}}"
  round
  custom-style="z-index: 5200;"
  bind:close="close"
  catchtouchmove="noop"
>
  <view class="og-panel">
    <view class="og-icon-wrap">
      <view class="og-lock">
        <view class="og-lock-shackle"></view>
        <view class="og-lock-body"></view>
        <view class="og-lock-keyhole"></view>
      </view>
    </view>
    <view class="og-title">查看详情需开通内部账号</view>
    <view class="og-subtitle">资源详情、联系方式与档期仅对合作办赛方开放</view>

    <view class="og-contact-card">
      <block wx:if="{{contact.qrCode}}">
        <view class="og-qr-wrap" bindtap="previewQr">
          <image class="og-qr" src="{{contact.qrCode}}" mode="aspectFill"></image>
          <view class="og-qr-hint">点击放大</view>
        </view>
      </block>
      <view wx:else class="og-qr og-qr--placeholder" bindtap="previewQr">
        <view class="og-qr-logo">篮</view>
        <view class="og-qr-tip">客服二维码</view>
      </view>

      <view class="og-contact-info">
        <view class="og-contact-name">{{contact.name}}</view>
        <view class="og-contact-row" bindtap="copyWechat">
          <text class="og-contact-label">微信号</text>
          <text class="og-contact-value">{{contact.wechat || '--'}}</text>
          <text class="og-contact-copy">复制</text>
        </view>
        <view class="og-contact-row" bindtap="callPhone">
          <text class="og-contact-label">客服电话</text>
          <text class="og-contact-value">{{contact.phone || '暂未开通'}}</text>
          <text class="og-contact-copy">拨打</text>
        </view>
      </view>
    </view>

    <button class="og-btn" bindtap="copyWechat">联系客户经理开通</button>

    <view class="og-close" bindtap="close" hover-class="og-close--hover">
      <view class="og-close-icon"></view>
    </view>
  </view>
</van-popup>
