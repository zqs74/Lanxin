.tab-bar-container {
  width: 100%;
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  z-index: 9999;
}

.t-tab-bar {
  --td-tab-bar-height: 100rpx;
  --td-tab-bar-tag-border-radius: 40rpx;
  --td-tab-bar-tag-height: 64rpx;
  --td-tab-bar-tag-margin: 16rpx 0;
  --td-tab-bar-tag-padding: 0 32rpx;
  --td-tab-bar-icon-size: 32rpx;
  --td-tab-bar-text-font-size: 24rpx;

  --td-tab-bar-color: #999999;
  --td-tab-bar-active-color: #D4AF37;
  --td-tab-bar-hover-bg-color: rgba(212, 175, 55, 0.2);

  --td-tab-bar-bg-color: rgba(26, 26, 26, 0.85);
  --td-tab-bar-border-color: rgba(212, 175, 55, 0.3);
  -webkit-backdrop-filter: blur(35rpx);
  backdrop-filter: blur(35rpx);
  box-shadow: 0 4rpx 30rpx rgba(0, 0, 0, 0.5), 0 0 20rpx rgba(212, 175, 55, 0.1);
  border: 1rpx solid rgba(212, 175, 55, 0.25);

  position: fixed !important;
  left: 0 !important;
  right: 0 !important;
  width: 90% !important;
  margin: 0 auto !important;
  bottom: 60rpx !important;
  z-index: 9999 !important;

  border-radius: 50rpx;
  padding: 0 !important;
  box-sizing: border-box !important;
}

.t-tab-bar__item {
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.t-tab-bar__item--active {
  transform: translateY(-3rpx);
  transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.t-tab-bar--tag .t-tab-bar__track {
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
}

.t-tab-bar--tag .t-tab-bar__indicator {
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
}

.t-tab-bar__content {
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
