/* custom-tab-bar index.wxss - 毛玻璃金色主题 */

.tab-bar-container {
  width: 100%;
  position: fixed;
  bottom: 28rpx;
  left: 0;
  right: 0;
  z-index: 9999;
}

.t-tab-bar {
  --td-tab-bar-height: 80rpx;
  --td-tab-bar-tag-border-radius: 44rpx;
  --td-tab-bar-tag-height: 56rpx;
  --td-tab-bar-tag-margin: 8rpx 0;
  --td-tab-bar-tag-padding: 0 24rpx;
  --td-tab-bar-icon-size: 26rpx;
  --td-tab-bar-text-font-size: 20rpx;

  --td-tab-bar-color: #999 !important;
  --td-tab-bar-active-color: #D4AF37 !important;
  --td-tab-bar-active-bg: rgba(212,175,55,0.12) !important;
  --td-tab-bar-bg-color: rgba(13,13,13,0.82) !important;
  --td-tab-bar-border-color: rgba(212,175,55,0.22) !important;
  --td-tab-bar-hover-bg-color: transparent !important;

  -webkit-backdrop-filter: blur(44rpx) saturate(190%);
  backdrop-filter: blur(44rpx) saturate(190%);

  box-shadow: var(--shadow-tab);
  border: 1rpx solid rgba(212,175,55,0.18) !important;

  position: fixed !important;
  left: 0 !important;
  right: 0 !important;
  width: 88% !important;
  margin: 0 auto !important;
  bottom: 48rpx !important;
  z-index: 9999 !important;

  border-radius: 44rpx !important;
  padding: 6rpx 10rpx !important;
  box-sizing: border-box !important;
}

.t-tab-bar__item {
  transition: all 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
}

.t-tab-bar__item--active {
  transform: translateY(-3rpx) scale(1.04);
  transition: all 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.t-tab-bar--tag .t-tab-bar__track {
  background: linear-gradient(
    135deg,
    rgba(212,175,55,0.16) 0%,
    rgba(255,215,0,0.10) 40%,
    rgba(212,175,55,0.14) 70%,
    rgba(244,196,48,0.08) 100%
  ) !important;
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
  border: 1.5rpx solid rgba(212,175,55,0.28) !important;
  box-shadow:
    0 4rpx 20rpx rgba(212,175,55,0.18),
    0 0 32rpx rgba(212,175,55,0.15),
    0 0 56rpx rgba(212,175,55,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.06);
  transition: all 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
}

.t-tab-bar--tag .t-tab-bar__indicator {
  width: 28rpx !important;
  height: 5rpx !important;
  border-radius: 3rpx !important;
  background: linear-gradient(90deg, #D4AF37 0%, #FFD700 40%, #F4C430 65%, #FFD700 85%, #D4AF37 100%) !important;
  box-shadow:
    0 0 12rpx rgba(212,175,55,0.7),
    0 0 24rpx rgba(212,175,55,0.35),
    0 0 40rpx rgba(255,215,0,0.18);
  transition: all 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
}

.t-tab-bar__content {
  transition: all 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ===== 亮色 tab-bar ===== */
.tab-bar-container.theme-light .t-tab-bar,
.theme-light .t-tab-bar {
  --td-tab-bar-color: #888 !important;
  --td-tab-bar-active-color: #D4AF37 !important;
  --td-tab-bar-bg-color: rgba(255,255,255,0.92) !important;
  --td-tab-bar-border-color: rgba(212,175,55,0.28) !important;

  box-shadow:
    0 2rpx 12rpx rgba(0,0,0,0.06),
    0 0 1rpx rgba(212,175,55,0.1),
    inset 0 1rpx 0 rgba(255,255,255,0.5) !important;
  border: 1rpx solid rgba(212,175,55,0.22) !important;
}

.tab-bar-container.theme-light .t-tab-bar--tag .t-tab-bar__track,
.theme-light .t-tab-bar--tag .t-tab-bar__track {
  background: linear-gradient(
    135deg,
    rgba(212,175,55,0.22) 0%,
    rgba(255,215,0,0.14) 40%,
    rgba(212,175,55,0.18) 70%,
    rgba(244,196,48,0.10) 100%
  ) !important;
  box-shadow:
    0 4rpx 20rpx rgba(212,175,55,0.12),
    0 0 32rpx rgba(212,175,55,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.5) !important;
}

/* ===== 暗色 tab-bar ===== */
.tab-bar-container.theme-dark .t-tab-bar,
.theme-dark .t-tab-bar {
  --td-tab-bar-color: #666 !important;
  --td-tab-bar-active-color: #D4AF37 !important;
  --td-tab-bar-bg-color: rgba(13,13,13,0.82) !important;
  --td-tab-bar-border-color: rgba(212,175,55,0.22) !important;

  backdrop-filter: blur(44rpx) saturate(190%) !important;
  -webkit-backdrop-filter: blur(44rpx) saturate(190%) !important;

  box-shadow:
    0 4rpx 24rpx rgba(0,0,0,0.5),
    0 0 1rpx rgba(255,215,0,0.12),
    inset 0 1rpx 0 rgba(255,255,255,0.03) !important;
  border: 1rpx solid rgba(212,175,55,0.18) !important;
}

.tab-bar-container.theme-dark .t-tab-bar--tag .t-tab-bar__track,
.theme-dark .t-tab-bar--tag .t-tab-bar__track {
  background: linear-gradient(
    135deg,
    rgba(212,175,55,0.16) 0%,
    rgba(255,215,0,0.10) 40%,
    rgba(212,175,55,0.14) 70%,
    rgba(244,196,48,0.08) 100%
  ) !important;
  box-shadow:
    0 4rpx 20rpx rgba(212,175,55,0.18),
    0 0 32rpx rgba(212,175,55,0.15),
    0 0 56rpx rgba(212,175,55,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.06) !important;
}
