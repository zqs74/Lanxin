
<view class="tab-bar-container {{themeClass}}">
  <t-tab-bar 
    t-class="t-tab-bar" 
    value="{{tabList[selected].value}}" 
    shape="round" 
    theme="tag" 
    split="{{false}}" 
    bindchange="onTabChange"
  > 
    <t-tab-bar-item 
      wx:for="{{tabList}}" 
      wx:key="value" 
      value="{{item.value}}" 
      icon="{{item.icon}}" 
      ariaLabel="{{item.ariaLabel}}"
    > 
    </t-tab-bar-item> 
  </t-tab-bar>
</view>
